@using CCAP.Web.Features.Dashboard.Models

<div class="row g-4">

    <div class="col-lg-4">

        <RecentReferralCard
            Referrals="Referrals"/>

    </div>

    <div class="col-lg-4">

        <UpcomingSocCard
            Visits="Visits"/>

    </div>

    <div class="col-lg-4">

        <AnnouncementCard
            Announcements="Announcements"/>

    </div>

</div>

@code{

    [Parameter]

    public IEnumerable<ReferralSummaryDto> Referrals { get; set; }
        = Enumerable.Empty<ReferralSummaryDto>();

    [Parameter]

    public IEnumerable<UpcomingVisitDto> Visits { get; set; }
        = Enumerable.Empty<UpcomingVisitDto>();

    [Parameter]

    public IEnumerable<AnnouncementDto> Announcements { get; set; }
        = Enumerable.Empty<AnnouncementDto>();

}