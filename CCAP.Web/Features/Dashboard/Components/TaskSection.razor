@using CCAP.Web.Features.Dashboard.Models

<div class="task-card">

    <div class="task-header">

        <div>

            <h5>
                My Tasks (@Tasks.Count())
            </h5>

        </div>

        <button class="btn btn-outline-primary btn-sm">

            View All Tasks

        </button>

    </div>

    <div class="task-filters">

        <button class="filter-chip active">
            All (14)
        </button>

        <button class="filter-chip high">
            High (5)
        </button>

        <button class="filter-chip due">
            Due Today (6)
        </button>

        <button class="filter-chip upcoming">
            Upcoming (3)
        </button>

    </div>

    <TaskTable Tasks="Tasks" />

</div>

@code {

    [Parameter]

    public IEnumerable<MyTaskDto> Tasks { get; set; }
        = Enumerable.Empty<MyTaskDto>();

}