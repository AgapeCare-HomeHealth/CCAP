@using CCAP.Web.Components.Shared
@using CCAP.Web.Features.Dashboard.Models

<div class="row g-4 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="My Tasks"
                       Value="@Statistics.MyTasks.ToString()"
                       Icon="bi bi-list-check"
                       Color="#2563EB" />

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="High Priority"
                       Value="@Statistics.HighPriority.ToString()"
                       Icon="bi bi-exclamation-triangle-fill"
                       Color="#EF4444" />

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="Due Today"
                       Value="@Statistics.DueToday.ToString()"
                       Icon="bi bi-calendar-check-fill"
                       Color="#F59E0B" />

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="Completed Today"
                       Value="@Statistics.CompletedToday.ToString()"
                       Icon="bi bi-check-circle-fill"
                       Color="#10B981" />

    </div>

</div>

@code {

    [Parameter]

    public WorkStatisticsModel Statistics { get; set; } = new();

}