@using CCAP.Web.Features.Dashboard.Models
@inject NavigationManager Navigation
<div class="widget-card dashboard-list-card">
  <div class="widget-header d-flex justify-content-between align-items-center"><span>Recent Referrals</span><button class="btn btn-sm btn-link" @onclick="ViewAll">View all (@Referrals.Count())</button></div>
  <div class="dashboard-card-list">
  @if (VisibleItems.Any()) { @foreach (var item in VisibleItems) { <div class="dashboard-list-row"><div><div class="fw-semibold">@item.PatientName</div><small class="text-muted">@item.ReferralNumber</small></div><small class="text-nowrap">@item.ReferralDate.ToString("MMM d, yyyy")</small></div> } } else { <div class="text-center text-muted py-4">No referrals available.</div> }
  </div>
</div>
@code { [Parameter] public IEnumerable<ReferralSummaryDto> Referrals { get; set; } = []; [Parameter] public int MaxItems { get; set; } = 5; private IEnumerable<ReferralSummaryDto> VisibleItems => Referrals.Take(MaxItems); private void ViewAll() => Navigation.NavigateTo("/dashboard/list/referrals"); }
