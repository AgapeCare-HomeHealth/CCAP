<div class="work-header">

    <div class="header-content">

        <div class="header-text">

            <h2>
                Good morning, @UserName!
                <span class="wave">👋</span>
            </h2>

            <p>
                Here's what needs your attention today.
            </p>

        </div>

    </div>

</div>

@code {

    [Parameter]

    public string UserName { get; set; } = "User";

}