@page "/scheduling/calendar"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using CCAP.Web.Features.Scheduling.Calendar.Models
@using CCAP.Web.Features.Scheduling.Calendar.Services
@inject CalendarService CalendarService
@inject IJSRuntime JS
@attribute [CcapAuthorize(Policy = "scheduling.view")]

<div class="scheduling-calendar-page">
    <div class="calendar-page-header">
        <div>
            <h1>Scheduling Calendar</h1>
            <p>Review scheduled patient visits by month or use the tracker for a detailed list.</p>
        </div>

        @if (CanManageScheduling)
        {
            <div class="calendar-page-actions">
                <label class="btn-upload-csv" style="cursor:pointer;">
                    <span>↑</span>
                    Import Schedule
                    <InputFile OnChange="HandleScheduleFileSelected" accept=".xlsx,.csv" style="display:none;" />
                </label>

                <a class="btn-download-template"
                   href="/templates/CC_Sched_Import_Template.xlsx"
                   download="CC_Sched_Import_Template.xlsx">
                    <span>↓</span>
                    Download Template
                </a>
            </div>
        }
    </div>

    <div class="calendar-card">
        <div class="calendar-toolbar">
            <div class="calendar-navigation">
                <button class="toolbar-button" @onclick="GoToToday">Today</button>
                <button class="toolbar-button navigation-button" @onclick="PreviousPeriod">‹</button>
                <button class="toolbar-button navigation-button" @onclick="NextPeriod">›</button>

                <h2 class="month-title">@GetPeriodTitle()</h2>
            </div>

            <div class="toolbar-right">
                <div class="tab-switcher">
                    <button class="tab-button @(CurrentTab == CalendarTab.Month ? "active" : "")"
                            @onclick="() => ChangeTab(CalendarTab.Month)">
                        Month
                    </button>
                    <button class="tab-button @(CurrentTab == CalendarTab.Tracker ? "active" : "")"
                            @onclick="() => ChangeTab(CalendarTab.Tracker)">
                        Tracker
                    </button>
                </div>
            </div>
        </div>

        <div class="filters-panel">
            <div class="filter-group physician-filter">
                <label for="physicianFilter">Physician / Clinician</label>
                <select id="physicianFilter" class="filter-select" @bind="SelectedPhysician">
                    <option value="">All Physicians / Clinicians</option>
                    @foreach (var physician in PhysicianOptions)
                    {
                        <option value="@physician">@physician</option>
                    }
                </select>
            </div>

            <div class="filter-group patient-filter">
                <label for="patientSearch">Patient Search</label>
                <input id="patientSearch"
                       class="filter-input"
                       type="text"
                       placeholder="Search patient name"
                       @bind="PatientSearchTerm"
                       @bind:event="oninput" />
            </div>

            <div class="filter-group filter-action-group">
                <label>&nbsp;</label>
                <button type="button" class="btn-clear-filters" @onclick="ClearFilters">
                    Clear Filters
                </button>
            </div>
        </div>

        <div class="toolbar-summary">
            <div class="summary-pill">
                <strong>@FilteredSchedules.Count</strong> visit(s) shown
            </div>
            <div class="summary-pill muted">
                <strong>@GetSchedulesForDate(DateTime.Today).Count</strong> visit(s) today
            </div>
            @if (!string.IsNullOrWhiteSpace(SelectedPhysician))
            {
                <div class="summary-pill accent">
                    Filtered by: @SelectedPhysician
                </div>
            }
        </div>

        @if (IsLoading)
        {
            <div class="alert alert-info m-3 mb-0">Loading schedules...</div>
        }
        else if (!string.IsNullOrWhiteSpace(CalendarLoadErrorMessage))
        {
            <div class="alert alert-danger m-3 mb-0">@CalendarLoadErrorMessage</div>
        }
        else if (CurrentTab == CalendarTab.Month)
        {
            <div class="calendar-grid">
                @foreach (var weekday in Weekdays)
                {
                    <div class="calendar-weekday">@weekday</div>
                }

                @foreach (var day in CalendarDays)
                {
                    var daySchedules = GetSchedulesForDate(day);

                    <div class="calendar-day
                        @(day.Month != CurrentMonth.Month ? "other-month" : "")
                        @(SelectedDate.Date == day.Date ? "selected-day" : "")"
                         @onclick="() => SelectDate(day)">

                        <div class="calendar-day-header">
                            <div class="day-number">@day.Day</div>
                            @if (daySchedules.Any())
                            {
                                <div class="day-count">@daySchedules.Count</div>
                            }
                        </div>

                        <div class="day-events">
                            @foreach (var schedule in daySchedules.Take(4))
                            {
                                <button type="button"
                                        class="schedule-event"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => SelectSchedule(schedule)">
                                    <div class="event-title">@schedule.PatientName</div>
                                    <div class="event-meta">
                                        @GetTimeDisplay(schedule)
                                        @if (!string.IsNullOrWhiteSpace(schedule.Clinician))
                                        {
                                            <span>• @schedule.Clinician</span>
                                        }
                                    </div>
                                </button>
                            }

                            @if (daySchedules.Count > 4)
                            {
                                <div class="more-events">+@(daySchedules.Count - 4) more</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="tracker-view">
                <div class="tracker-header">
                    <div>
                        <h3>Scheduling Tracker</h3>
                        <p>Detailed view of visits for @GetPeriodTitle().</p>
                    </div>
                </div>

                @if (FilteredSchedules.Count == 0)
                {
                    <div class="tracker-empty-state">
                        <strong>No schedules found</strong>
                        <span>Try changing the month or clearing the filters.</span>
                    </div>
                }
                else
                {
                    <div class="tracker-table-wrapper">
                        <table class="tracker-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Time Block</th>
                                    <th>Patient Name</th>
                                    <th>Confirmation</th>
                                    <th>Call Notes</th>
                                    <th>Assigned Clinician</th>
                                    <th>Type of Visit</th>
                                    <th>Visit Status</th>
                                    <th>Notes / Flag</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in FilteredSchedules
                                    .OrderBy(x => x.ScheduledDate)
                                    .ThenBy(x => x.PatientName))
                                {
                                    <tr class="tracker-row @(SelectedSchedule?.VisitId == schedule.VisitId ? "selected" : "")"
                                        @onclick="() => SelectSchedule(schedule)">
                                        <td>@schedule.ScheduledDate.ToString("MM/dd/yyyy")</td>
                                        <td>@schedule.ScheduledDate.ToString("ddd")</td>
                                        <td>@(string.IsNullOrWhiteSpace(schedule.TimeBlock) ? GetTimeDisplay(schedule) : schedule.TimeBlock)</td>
                                        <td>
                                            <strong>@schedule.PatientName</strong>
                                        </td>
                                        <td>@DisplayOrPlaceholder(schedule.ConfirmationStatus)</td>
                                        <td>@DisplayOrPlaceholder(schedule.CallNotes)</td>
                                        <td>@DisplayOrPlaceholder(schedule.Clinician)</td>
                                        <td>@DisplayOrPlaceholder(schedule.VisitType)</td>
                                        <td>
                                            <span class="status-badge @GetVisitStatusClass(schedule.Status)">@DisplayOrPlaceholder(schedule.Status)</span>
                                        </td>
                                        <td>@DisplayOrPlaceholder(schedule.NotesFlag)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    @if (SelectedDate != DateTime.MinValue)
    {
        <div class="selected-day-panel">
            <div class="selected-day-header">
                <div>
                    <span>Selected Day</span>
                    <h3>@SelectedDate.ToString("dddd, MMMM d, yyyy")</h3>
                </div>

                <button class="close-panel-button" @onclick="ClearSelectedDate">×</button>
            </div>

            @{
                var selectedSchedules = GetSchedulesForDate(SelectedDate);
            }

            @if (selectedSchedules.Any())
            {
                <div class="selected-schedule-list">
                    @foreach (var schedule in selectedSchedules)
                    {
                        <button type="button"
                                class="selected-schedule-item"
                                @onclick="() => SelectSchedule(schedule)">
                            <div class="selected-schedule-time">@GetTimeDisplay(schedule)</div>
                            <div class="selected-schedule-info">
                                <strong>@schedule.PatientName</strong>
                                <span>@DisplayOrPlaceholder(schedule.Clinician) • @DisplayOrPlaceholder(schedule.Status)</span>
                            </div>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="selected-day-empty">
                    No schedules for this day with the current filters.
                </div>
            }
        </div>
    }

    @if (SelectedSchedule is not null)
    {
        <div class="schedule-details-panel">
            <div class="schedule-details-header">
                <div>
                    <span>Schedule Details</span>
                    <h3>@SelectedSchedule.PatientName</h3>
                </div>

                <button class="close-panel-button" @onclick="ClearSelectedSchedule">×</button>
            </div>

            <div class="schedule-details-content">
                <div class="detail-row">
                    <span>Date</span>
                    <strong>@SelectedSchedule.ScheduledDate.ToString("MMMM d, yyyy")</strong>
                </div>

                <div class="detail-row">
                    <span>Time</span>
                    <strong>@GetTimeDisplay(SelectedSchedule)</strong>
                </div>

                <div class="detail-row">
                    <span>Assigned Clinician</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.Clinician)</strong>
                </div>

                <div class="detail-row">
                    <span>Type of Visit</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.VisitType)</strong>
                </div>

                <div class="detail-row">
                    <span>Visit Status</span>
                    <span class="status-badge @GetVisitStatusClass(SelectedSchedule.Status)">@DisplayOrPlaceholder(SelectedSchedule.Status)</span>
                </div>

                <div class="detail-row">
                    <span>Confirmation Status</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.ConfirmationStatus)</strong>
                </div>

                <div class="detail-row detail-row-wide">
                    <span>Call Notes</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.CallNotes)</strong>
                </div>

                <div class="detail-row detail-row-wide">
                    <span>Notes / Flag</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.NotesFlag)</strong>
                </div>

                @if (SelectedSchedule.CompletedDate.HasValue)
                {
                    <div class="detail-row detail-row-wide">
                        <span>Completed</span>
                        <strong>@SelectedSchedule.CompletedDate.Value.ToString("MMMM d, yyyy h:mm tt")</strong>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (ShowImportReview)
{
    <div class="import-review-overlay" @onclick:stopPropagation="true">
        <div class="import-review-modal" role="dialog" aria-modal="true" aria-labelledby="schedule-import-title">
            <div class="import-review-header">
                <div>
                    <h3 id="schedule-import-title">Review Schedule Import</h3>
                    <p>
                        Schedules are imported independently of the CCAP Patient record.
                        A patient match is used when available, but it is <strong>not required to save the schedule</strong>.
                    </p>
                </div>

                <button type="button"
                        class="import-review-close"
                        title="Close review"
                        aria-label="Close review"
                        @onclick="CloseImportReview"
                        @onclick:stopPropagation="true"
                        disabled="@IsImporting">
                    ×
                </button>
            </div>

            <div class="import-summary">
                <strong>@ImportPreview.Count schedule(s) found.</strong>
                <span>@ImportPreview.Count(x => x.IsDuplicate) duplicate(s).</span>
                <span>@ImportPreview.Count(x => !x.IsDuplicate) new schedule(s).</span>

                @if (ImportPreview.Any(x => x.HasWarning))
                {
                    <span class="text-warning-emphasis">
                        <strong>@ImportPreview.Count(x => x.HasWarning) warning(s).</strong>
                        These schedules can still be saved.
                    </span>
                }
            </div>

            <div class="import-review-body">
                <div class="table-responsive import-table">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Time Block</th>
                                <th>Patient Name</th>
                                <th>Confirmation Status</th>
                                <th>Call Notes</th>
                                <th>Assigned Clinician</th>
                                <th>Type of Visit</th>
                                <th>Visit Status</th>
                                <th>Notes / Flag</th>
                                <th>Existing Schedule</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in ImportPreview)
                        {
                            <tr>
                                <td>
                                    @if (item.IsDuplicate)
                                    {
                                        <label class="overwrite-choice">
                                            <input type="checkbox" @bind="item.OverwriteExisting" />
                                            <span>
                                                <strong>Overwrite</strong><br />
                                                <small>Unchecked = Keep</small>
                                            </span>
                                        </label>
                                    }
                                    else if (item.CanImport)
                                    {
                                        <span class="text-success-emphasis fw-semibold">Add</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger-emphasis fw-semibold">Skip</span>
                                    }

                                    @if (item.HasWarning && !string.IsNullOrWhiteSpace(item.ValidationMessage))
                                    {
                                        <div class="text-warning-emphasis mt-2">
                                            <strong>Warning:</strong> @item.ValidationMessage
                                        </div>
                                    }
                                </td>
                                <td>@item.ScheduledDate.ToString("MMM d, yyyy")</td>
                                <td>@item.ScheduledDate.ToString("dddd")</td>
                                <td>@item.TimeBlock</td>
                                <td><strong>@item.PatientName</strong></td>
                                <td>@item.ConfirmationStatus</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.CallNotes))
                                    {
                                        <span>@item.CallNotes</span>
                                    }
                                </td>
                                <td>@item.ClinicianName</td>
                                <td>@item.VisitType</td>
                                <td><span class="status-badge @GetVisitStatusClass(item.VisitStatus)">@DisplayOrPlaceholder(item.VisitStatus)</span></td>
                                <td>@item.NotesFlag</td>
                                <td>
                                    @(item.IsDuplicate
                                        ? $"{item.ExistingClinicianName} — {item.ExistingStatus}"
                                        : "None")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="import-review-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseImportReview"
                        @onclick:stopPropagation="true"
                        disabled="@IsImporting">
                    Cancel
                </button>

                <button type="button"
                        class="btn @(ImportPreview.Any(x => x.HasWarning) ? "btn-warning" : "btn-primary")"
                        @onclick="ProceedWithImport"
                        @onclick:stopPropagation="true"
                        disabled="@IsImporting">
                    @(IsImporting
                        ? "Importing..."
                        : ImportPreview.Any(x => x.HasWarning)
                            ? "Proceed with Caution"
                            : "Proceed with Import")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool CanManageScheduling;

    private enum CalendarTab
    {
        Month,
        Tracker
    }

    private CalendarTab CurrentTab = CalendarTab.Month;

    private DateTime CurrentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime SelectedDate = DateTime.Today;
    private CalendarVisitDto? SelectedSchedule;

    private readonly string[] Weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private List<DateTime> CalendarDays = [];
    private List<CalendarVisitDto> Schedules = [];
    private List<SchedulingClinicianDto> Clinicians = [];

    private bool IsLoading;
    private string? CalendarLoadErrorMessage;

    private bool ShowImportReview;
    private bool IsImporting;
    private List<ScheduleImportPreviewItem> ImportPreview = [];

    private string _selectedPhysician = string.Empty;
    private string SelectedPhysician
    {
        get => _selectedPhysician;
        set
        {
            if (_selectedPhysician == value)
                return;

            _selectedPhysician = value;
            SyncSelectionWithFilters();
        }
    }

    private string _patientSearchTerm = string.Empty;
    private string PatientSearchTerm
    {
        get => _patientSearchTerm;
        set
        {
            if (_patientSearchTerm == value)
                return;

            _patientSearchTerm = value;
            SyncSelectionWithFilters();
        }
    }

    private List<string> PhysicianOptions => Clinicians
        .Select(x => x.FullName)
        .Concat(Schedules.Select(x => x.Clinician))
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<CalendarVisitDto> FilteredSchedules => Schedules
        .Where(MatchesCurrentFilters)
        .OrderBy(x => x.ScheduledDate)
        .ThenBy(x => x.PatientName)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            CanManageScheduling = authState.User.HasClaim("permission", "scheduling.manage");
        }

        GenerateCalendarDays();
        await LoadSchedulingOptionsAsync();
        await LoadSchedulesAsync();
    }

    private async Task LoadSchedulingOptionsAsync()
    {
        try
        {
            var options = await CalendarService.GetSchedulingOptionsAsync();
            Clinicians = options.Clinicians;
        }
        catch
        {
            Clinicians = [];
        }
    }

    private async Task LoadSchedulesAsync()
    {
        IsLoading = true;
        CalendarLoadErrorMessage = null;

        try
        {
            var (start, end) = GetVisibleDateRange();
            Schedules = await CalendarService.GetVisitsAsync(start, end);
            SyncSelectionWithFilters();
        }
        catch
        {
            Schedules = [];
            CalendarLoadErrorMessage = "Unable to load schedules right now. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private (DateTime Start, DateTime End) GetVisibleDateRange()
    {
        return (CalendarDays.First().Date, CalendarDays.Last().Date.AddDays(1));
    }

    private void GenerateCalendarDays()
    {
        CalendarDays.Clear();

        var firstDayOfMonth = CurrentMonth;
        var calendarStart = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);
        var lastDayOfMonth = CurrentMonth.AddMonths(1).AddDays(-1);
        var calendarEnd = lastDayOfMonth.AddDays(6 - (int)lastDayOfMonth.DayOfWeek);

        for (var date = calendarStart; date <= calendarEnd; date = date.AddDays(1))
            CalendarDays.Add(date);
    }

    private void ChangeTab(CalendarTab tab)
    {
        CurrentTab = tab;
        SelectedSchedule = null;
    }

    private bool MatchesCurrentFilters(CalendarVisitDto schedule)
    {
        var matchesPhysician = string.IsNullOrWhiteSpace(SelectedPhysician) ||
                               string.Equals(schedule.Clinician, SelectedPhysician, StringComparison.OrdinalIgnoreCase);

        var matchesPatient = string.IsNullOrWhiteSpace(PatientSearchTerm) ||
                             schedule.PatientName.Contains(PatientSearchTerm, StringComparison.OrdinalIgnoreCase);

        return matchesPhysician && matchesPatient;
    }

    private List<CalendarVisitDto> GetSchedulesForDate(DateTime date)
    {
        return FilteredSchedules
            .Where(x => x.ScheduledDate.Date == date.Date)
            .OrderBy(x => x.ScheduledDate)
            .ThenBy(x => x.PatientName)
            .ToList();
    }

    private void SelectDate(DateTime date)
    {
        SelectedDate = date;
        SelectedSchedule = null;
    }

    private void SelectSchedule(CalendarVisitDto schedule)
    {
        SelectedSchedule = schedule;
        SelectedDate = schedule.ScheduledDate.Date;
    }

    private void ClearSelectedDate()
    {
        SelectedDate = DateTime.MinValue;
        SelectedSchedule = null;
    }

    private void ClearSelectedSchedule()
    {
        SelectedSchedule = null;
    }

    private async Task GoToToday()
    {
        var today = DateTime.Today;
        CurrentMonth = new DateTime(today.Year, today.Month, 1);
        SelectedDate = today;
        SelectedSchedule = null;

        GenerateCalendarDays();
        await LoadSchedulesAsync();
    }

    private async Task PreviousPeriod()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        SelectedDate = CurrentMonth;
        SelectedSchedule = null;

        GenerateCalendarDays();
        await LoadSchedulesAsync();
    }

    private async Task NextPeriod()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        SelectedDate = CurrentMonth;
        SelectedSchedule = null;

        GenerateCalendarDays();
        await LoadSchedulesAsync();
    }

    private string GetPeriodTitle() => CurrentMonth.ToString("MMMM yyyy");

    private void ClearFilters()
    {
        _selectedPhysician = string.Empty;
        _patientSearchTerm = string.Empty;
        SyncSelectionWithFilters();
    }

    private void SyncSelectionWithFilters()
    {
        var visibleSchedules = FilteredSchedules;

        if (SelectedSchedule is not null && visibleSchedules.All(x => x.VisitId != SelectedSchedule.VisitId))
            SelectedSchedule = null;

        if (SelectedDate != DateTime.MinValue && GetSchedulesForDate(SelectedDate).Count == 0)
            SelectedDate = DateTime.Today.Month == CurrentMonth.Month && DateTime.Today.Year == CurrentMonth.Year
                ? DateTime.Today
                : CurrentMonth;
    }

    private static string GetTimeDisplay(CalendarVisitDto schedule)
    {
        if (!string.IsNullOrWhiteSpace(schedule.TimeBlock))
            return schedule.TimeBlock;

        return schedule.ScheduledDate.ToString("h:mm tt");
    }

    private static string DisplayOrPlaceholder(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "—"
            : value;
    }

    private static string GetVisitStatusClass(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "completed" => "status-completed",
            "missed" => "status-missed",
            "rescheduled" => "status-rescheduled",
            "cancelled" => "status-cancelled",
            _ => "status-empty"
        };
    }

    private async Task HandleScheduleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        var extension = Path.GetExtension(file.Name);
        if (!string.Equals(extension, ".xlsx", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(extension, ".csv", StringComparison.OrdinalIgnoreCase))
        {
            await ShowScheduleErrorAsync(
                "Invalid File",
                "Please select an Excel (.xlsx) or CSV schedule file.");
            return;
        }

        IsImporting = true;
        ShowImportReview = false;
        ImportPreview.Clear();

        await ShowScheduleLoadingAsync(
            "Validating Schedule",
            "Reading the uploaded schedule and checking its format...");

        try
        {
            ImportPreview = await CalendarService.PreviewImportAsync(file);

            await CloseScheduleAlertAsync();

            if (ImportPreview.Count == 0)
            {
                await ShowScheduleErrorAsync(
                    "No Schedule Found",
                    "The uploaded file does not contain any valid scheduled visits.");
                return;
            }

            ShowImportReview = true;
        }
        catch (HttpRequestException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync(
                "Schedule Validation Failed",
                GetScheduleErrorMessage(ex));
        }
        catch (InvalidOperationException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync(
                "Invalid Schedule File",
                GetScheduleErrorMessage(ex));
        }
        catch (Exception)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync(
                "Unable to Read Schedule",
                "The uploaded file could not be processed. Please verify that it is a valid weekly schedule file.");
        }
        finally
        {
            IsImporting = false;
        }
    }

    private async Task ProceedWithImport()
    {
        if (IsImporting || ImportPreview.Count == 0)
            return;

        IsImporting = true;

        ShowImportReview = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        await ShowScheduleLoadingAsync(
            "Importing Schedule",
            "Saving the selected schedules to CCAP...");

        ScheduleImportResult result;

        try
        {
            result = await CalendarService.CommitImportAsync(ImportPreview);
        }
        catch (HttpRequestException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync("Import Failed", GetScheduleErrorMessage(ex));
            IsImporting = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (InvalidOperationException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync("Import Validation Failed", GetScheduleErrorMessage(ex));
            IsImporting = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (Exception)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync("Import Failed", "The schedules could not be imported. Please try again.");
            IsImporting = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        ImportPreview.Clear();

        await CloseScheduleAlertAsync();
        await LoadSchedulesAsync();

        var resultMessage =
            $"{result.Added} added, {result.Overwritten} overwritten, {result.Kept} kept" +
            (result.Skipped > 0 ? $", {result.Skipped} skipped" : "") + ".";

        if (result.Warnings > 0 || result.Skipped > 0)
        {
            var warningMessage = resultMessage;

            if (result.Warnings > 0)
                warningMessage += $" {result.Warnings} schedule(s) were saved with mapping warnings.";

            if (result.Skipped > 0)
                warningMessage += " Rows that could not be imported were skipped.";

            await ShowScheduleWarningAsync("Import Completed with Warnings", warningMessage);
        }
        else
        {
            await ShowScheduleSuccessAsync("Schedule Imported", resultMessage);
        }

        IsImporting = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowScheduleLoadingAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.loading", title, text);
    }

    private async Task CloseScheduleAlertAsync()
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.close");
    }

    private async Task ShowScheduleErrorAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.error", title, text);
    }

    private async Task ShowScheduleSuccessAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.success", title, text);
    }

    private async Task ShowScheduleWarningAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.warning", title, text);
    }

    private static string GetScheduleErrorMessage(Exception ex)
    {
        return string.IsNullOrWhiteSpace(ex.Message)
            ? "The schedule file could not be validated."
            : ex.Message;
    }

    private void CloseImportReview()
    {
        if (IsImporting)
            return;

        ShowImportReview = false;
        ImportPreview.Clear();
        StateHasChanged();
    }
}
