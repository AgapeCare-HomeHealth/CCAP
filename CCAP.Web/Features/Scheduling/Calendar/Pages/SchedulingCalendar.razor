@page "/scheduling/calendar"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using CCAP.Web.Features.Scheduling.Calendar.Models
@using CCAP.Web.Features.Scheduling.Calendar.Services
@inject CalendarService CalendarService
@inject IJSRuntime JS
@attribute [CcapAuthorize(Policy = "scheduling.view")]

<div class="scheduling-calendar-page">
    <div class="calendar-page-header">
        <div>
            <h1>Scheduling Calendar</h1>
            <p>Review scheduled patient visits by month or use the tracker for a detailed list.</p>
        </div>

        @if (CanManageScheduling)
        {
            <div class="calendar-page-actions">
                <label class="btn-upload-csv" style="cursor:pointer;">
                    <span>↑</span>
                    Import Schedule
                    <InputFile OnChange="HandleScheduleFileSelected" accept=".xlsx,.csv" style="display:none;" />
                </label>

                <a class="btn-download-template"
                   href="/templates/CC_Sched_Import_Template.xlsx"
                   download="CC_Sched_Import_Template.xlsx">
                    <span>↓</span>
                    Download Template
                </a>
            </div>
        }
    </div>

    <div class="calendar-card">
        <div class="calendar-toolbar">
            <div class="calendar-navigation">
                <button class="toolbar-button" @onclick="GoToToday">Today</button>
                <button class="toolbar-button navigation-button" @onclick="PreviousPeriod">‹</button>
                <button class="toolbar-button navigation-button" @onclick="NextPeriod">›</button>

                <h2 class="month-title">@GetPeriodTitle()</h2>
            </div>

            <div class="toolbar-right">
                <div class="tab-switcher">
                    <button class="tab-button @(CurrentTab == CalendarTab.Month ? "active" : "")"
                            @onclick="() => ChangeTab(CalendarTab.Month)">
                        Month
                    </button>
                    <button class="tab-button @(CurrentTab == CalendarTab.Tracker ? "active" : "")"
                            @onclick="() => ChangeTab(CalendarTab.Tracker)">
                        Tracker
                    </button>
                </div>
            </div>
        </div>

        <div class="filters-panel">
            <div class="filter-group physician-filter">
                <label for="physicianFilter">Physician / Clinician</label>
                <select id="physicianFilter" class="filter-select" @bind="SelectedPhysician">
                    <option value="">All Physicians / Clinicians</option>
                    @foreach (var physician in PhysicianOptions)
                    {
                        <option value="@physician">@physician</option>
                    }
                </select>
            </div>

            <div class="filter-group patient-filter">
                <label for="patientSearch">Search Patient / Clinician / CC</label>
                <input id="patientSearch"
                       class="filter-input"
                       type="text"
                       placeholder="Search patient, clinician, or CC"
                       @bind="PatientSearchTerm"
                       @bind:event="oninput" />
            </div>

            <div class="filter-group filter-action-group">
                <label>&nbsp;</label>
                <button type="button" class="btn-clear-filters" @onclick="ClearFilters">
                    Clear Filters
                </button>
            </div>
        </div>

        <div class="toolbar-summary">
            <div class="summary-pill">
                <strong>@FilteredSchedules.Count</strong> visit(s) shown
            </div>
            <div class="summary-pill muted">
                <strong>@GetSchedulesForDate(DateTime.Today).Count</strong> visit(s) today
            </div>
            @if (!string.IsNullOrWhiteSpace(SelectedPhysician))
            {
                <div class="summary-pill accent">
                    Filtered by: @SelectedPhysician
                </div>
            }
        </div>

        @if (IsLoading)
        {
            <div class="alert alert-info m-3 mb-0">Loading schedules...</div>
        }
        else if (!string.IsNullOrWhiteSpace(CalendarLoadErrorMessage))
        {
            <div class="alert alert-danger m-3 mb-0">@CalendarLoadErrorMessage</div>
        }
        else if (CurrentTab == CalendarTab.Month)
        {
            <div class="calendar-grid">
                @foreach (var weekday in Weekdays)
                {
                    <div class="calendar-weekday">@weekday</div>
                }

                @foreach (var day in CalendarDays)
                {
                    var daySchedules = GetSchedulesForDate(day);

                    <div class="calendar-day
                        @(day.Month != CurrentMonth.Month ? "other-month" : "")
                        @(SelectedDate.Date == day.Date ? "selected-day" : "")"
                         @onclick="() => SelectDate(day)">

                        <div class="calendar-day-header">
                            <div class="day-number">@day.Day</div>
                            @if (daySchedules.Any())
                            {
                                <div class="day-count">@daySchedules.Count</div>
                            }
                        </div>

                        <div class="day-events">
                            @foreach (var schedule in daySchedules.Take(4))
                            {
                                <button type="button"
                                        class="schedule-event"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => SelectSchedule(schedule)">
                                    <div class="event-title">@schedule.PatientName</div>
                                    <div class="event-meta">
                                        @GetTimeDisplay(schedule)
                                        @if (!string.IsNullOrWhiteSpace(schedule.Clinician))
                                        {
                                            <span>• @schedule.Clinician</span>
                                        }
                                    </div>
                                </button>
                            }

                            @if (daySchedules.Count > 4)
                            {
                                <div class="more-events">+@(daySchedules.Count - 4) more</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="tracker-view">
                <div class="tracker-header">
                    <div>
                        <h3>Scheduling Tracker</h3>
                        <p>Detailed view of visits for @GetPeriodTitle().</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(StatusUpdateError))
                {
                    <div class="tracker-status-error" role="alert">@StatusUpdateError</div>
                }

                @if (CanManageScheduling)
                {
                    <div class="cc-assignment-toolbar">
                        <strong>@SelectedCcVisitIds.Count selected</strong>
                        <select class="filter-select" aria-label="Care Coordinator" @bind="SelectedCareCoordinatorId">
                            <option value="">Select Care Coordinator</option>
                            @foreach (var person in CareCoordinators)
                            {
                                <option value="@person.UserId.ToString()">@person.FullName</option>
                            }
                        </select>
                        <button type="button" class="toolbar-button" disabled="@(SelectedCcVisitIds.Count == 0 || string.IsNullOrEmpty(SelectedCareCoordinatorId) || IsAssigningCc)"
                                @onclick="() => ShowCcConfirmation = true">Assign CC</button>
                        <span>Existing CC assignments will be skipped.</span>
                        <button type="button" class="toolbar-button tracker-delete-button tracker-delete-separated"
                                disabled="@(SelectedCcVisitIds.Count == 0 || IsDeletingVisits || IsAssigningCc)"
                                @onclick="() => ShowDeleteConfirmation = true">Delete Selected</button>
                    </div>
                    @if (ShowDeleteConfirmation)
                    {
                        <div class="cc-confirmation" role="group" aria-label="Confirm permanent visit deletion">
                            <strong>Delete @SelectedCcVisitIds.Count selected visit(s) permanently?</strong>
                            <p>This cannot be undone. Only the selected scheduled visits will be deleted; patient and referral records will remain.</p>
                            <button type="button" class="toolbar-button" disabled="@IsDeletingVisits" @onclick="() => ShowDeleteConfirmation = false">Cancel</button>
                            <button type="button" class="toolbar-button tracker-delete-button" disabled="@IsDeletingVisits" @onclick="ConfirmDeleteVisitsAsync">Confirm Permanent Delete</button>
                        </div>
                    }
                    @if (ShowCcConfirmation)
                    {
                        <div class="cc-confirmation" role="group" aria-label="Confirm Care Coordinator assignment">
                            <strong>Confirm assignment</strong>
                            <p>Assign @SelectedCcVisitIds.Count selected visit(s) to @GetSelectedCcName()? Already assigned visits will be skipped.</p>
                            <button type="button" class="toolbar-button" @onclick="() => ShowCcConfirmation = false">Cancel</button>
                            <button type="button" class="toolbar-button" disabled="@IsAssigningCc" @onclick="ConfirmCcAssignmentAsync">Confirm Assignment</button>
                        </div>
                    }
                }

                @if (FilteredSchedules.Count == 0)
                {
                    <div class="tracker-empty-state">
                        <strong>No schedules found</strong>
                        <span>Try changing the month or clearing the filters.</span>
                    </div>
                }
                else
                {
                    <div class="tracker-table-wrapper">
                        <table class="tracker-table">
                            <thead>
                                <tr>
                                    @if (CanManageScheduling) { <th><input type="checkbox" aria-label="Select page visits" checked="@(PagedTrackerSchedules.All(s => SelectedCcVisitIds.Contains(s.VisitId)))" @onchange="ToggleCurrentPage" /></th> }
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Time Block</th>
                                    <th>Patient Name</th>
                                    <th>Confirmation</th>
                                    <th>Call Notes</th>
                                    <th>Assigned Clinician</th>
                                    <th>CC</th>
                                    <th>Type of Visit</th>
                                    <th>Visit Status</th>
                                    <th>Notes / Flag</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in PagedTrackerSchedules)
                                {
                                    <tr class="tracker-row @(SelectedSchedule?.VisitId == schedule.VisitId ? "selected" : "")"
                                        @onclick="() => SelectSchedule(schedule)">
                                        @if (CanManageScheduling)
                                        {
                                            <td><input type="checkbox" aria-label="Select @schedule.PatientName" checked="@(SelectedCcVisitIds.Contains(schedule.VisitId))"
                                                       @onchange="e => ToggleCcVisit(schedule.VisitId, e.Value is true)" @onclick:stopPropagation="true" /></td>
                                        }
                                        <td>@schedule.ScheduledDate.ToString("MM/dd/yyyy")</td>
                                        <td>@schedule.ScheduledDate.ToString("ddd")</td>
                                        <td>@(string.IsNullOrWhiteSpace(schedule.TimeBlock) ? GetTimeDisplay(schedule) : schedule.TimeBlock)</td>
                                        <td>
                                            <strong>@schedule.PatientName</strong>
                                        </td>
                                        <td>
                                            @if (CanManageScheduling)
                                            {
                                                <select class="tracker-status-select" aria-label="Confirmation for @schedule.PatientName"
                                                        value="@schedule.ConfirmationStatus" disabled="@SavingVisitIds.Contains(schedule.VisitId)"
                                                        @onchange="e => SaveTrackerFieldAsync(schedule, confirmation: e.Value?.ToString())" @onclick:stopPropagation="true">
                                                    <option value="">Select status</option>
                                                    @foreach (var opt in ConfirmationOptions)
                                                    {
                                                        <option value="@opt.DisplayName">@opt.DisplayName</option>
                                                    }
                                                </select>
                                            }
                                            else { @DisplayOrPlaceholder(schedule.ConfirmationStatus) }
                                        </td>
                                        <td>
                                            @if (CanManageScheduling)
                                            {
                                                <input class="tracker-inline-input" value="@schedule.CallNotes" maxlength="4000" aria-label="Call notes for @schedule.PatientName"
                                                       disabled="@SavingVisitIds.Contains(schedule.VisitId)"
                                                       @onchange="e => SaveTrackerFieldAsync(schedule, callNotes: e.Value?.ToString(), updateNotes: true)" @onclick:stopPropagation="true" />
                                            }
                                            else { @DisplayOrPlaceholder(schedule.CallNotes) }
                                        </td>
                                        <td>
                                            @if (CanManageScheduling)
                                            {
                                                <select class="tracker-status-select" aria-label="Clinician for @schedule.PatientName"
                                                        value="@(schedule.ClinicianId?.ToString() ?? string.Empty)" disabled="@SavingVisitIds.Contains(schedule.VisitId)"
                                                        @onchange="e => SaveTrackerFieldAsync(schedule, clinicianValue: e.Value?.ToString(), updateClinician: true)" @onclick:stopPropagation="true">
                                                    <option value="">Unassigned</option>
                                                    @foreach (var clinician in Clinicians)
                                                    {
                                                        <option value="@clinician.UserId.ToString()">@clinician.FullName</option>
                                                    }
                                                </select>
                                            }
                                            else { @DisplayOrPlaceholder(schedule.Clinician) }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(schedule.CareCoordinatorName) ? "Unassigned" : schedule.CareCoordinatorName)</td>
                                        <td>@DisplayOrPlaceholder(schedule.VisitType)</td>
                                        <td>
                                            @if (CanManageScheduling)
                                            {
                                                <select class="tracker-status-select @GetVisitStatusClass(schedule.Status)"
                                                        aria-label="Visit status for @schedule.PatientName"
                                                        value="@schedule.Status"
                                                        disabled="@SavingVisitIds.Contains(schedule.VisitId)"
                                                        @onchange="async e => await ChangeVisitStatusAsync(schedule, e.Value?.ToString())"
                                                        @onclick:stopPropagation="true">
                                                    @if (string.IsNullOrWhiteSpace(schedule.Status))
                                                    {
                                                        <option value="">Not set</option>
                                                    }
                                                    @foreach (var status in EditableVisitStatuses)
                                                    {
                                                        <option value="@status">@status</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <span class="status-badge @GetVisitStatusClass(schedule.Status)">@DisplayOrPlaceholder(schedule.Status)</span>
                                            }
                                        </td>
                                        <td>@DisplayOrPlaceholder(schedule.NotesFlag)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav class="tracker-pagination" aria-label="Scheduling tracker pages">
                        <span class="tracker-pagination-info">
                            Showing @TrackerFirstItem–@TrackerLastItem of @FilteredSchedules.Count visits
                        </span>
                        <div class="tracker-pagination-actions">
                            <button type="button" disabled="@(TrackerPage <= 1)"
                                    @onclick="() => ChangeTrackerPage(TrackerPage - 1)">Previous</button>
                            <span class="tracker-page-label">Page @TrackerPage of @TrackerTotalPages</span>
                            <button type="button" disabled="@(TrackerPage >= TrackerTotalPages)"
                                    @onclick="() => ChangeTrackerPage(TrackerPage + 1)">Next</button>
                        </div>
                    </nav>
                }
            </div>
        }
    </div>

    @if (SelectedDate != DateTime.MinValue)
    {
        <div class="selected-day-panel">
            <div class="selected-day-header">
                <div>
                    <span>Selected Day</span>
                    <h3>@SelectedDate.ToString("dddd, MMMM d, yyyy")</h3>
                </div>

                <button class="close-panel-button" @onclick="ClearSelectedDate">×</button>
            </div>

            @{
                var selectedSchedules = GetSchedulesForDate(SelectedDate);
            }

            @if (selectedSchedules.Any())
            {
                <div class="selected-schedule-list">
                    @foreach (var schedule in selectedSchedules)
                    {
                        <button type="button"
                                class="selected-schedule-item"
                                @onclick="() => SelectSchedule(schedule)">
                            <div class="selected-schedule-time">@GetTimeDisplay(schedule)</div>
                            <div class="selected-schedule-info">
                                <strong>@schedule.PatientName</strong>
                                <span>@DisplayOrPlaceholder(schedule.Clinician) • @DisplayOrPlaceholder(schedule.Status)</span>
                            </div>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="selected-day-empty">
                    No schedules for this day with the current filters.
                </div>
            }
        </div>
    }

    @if (SelectedSchedule is not null)
    {
        <div class="schedule-details-panel">
            <div class="schedule-details-header">
                <div>
                    <span>Schedule Details</span>
                    <h3>@SelectedSchedule.PatientName</h3>
                </div>

                <button class="close-panel-button" @onclick="ClearSelectedSchedule">×</button>
            </div>

            <div class="schedule-details-content">
                <div class="detail-row">
                    <span>Date</span>
                    <strong>@SelectedSchedule.ScheduledDate.ToString("MMMM d, yyyy")</strong>
                </div>

                <div class="detail-row">
                    <span>Time</span>
                    <strong>@GetTimeDisplay(SelectedSchedule)</strong>
                </div>

                <div class="detail-row">
                    <span>Assigned Clinician</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.Clinician)</strong>
                </div>

                <div class="detail-row">
                    <span>Type of Visit</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.VisitType)</strong>
                </div>

                <div class="detail-row">
                    <span>Visit Status</span>
                    <span class="status-badge @GetVisitStatusClass(SelectedSchedule.Status)">@DisplayOrPlaceholder(SelectedSchedule.Status)</span>
                </div>

                <div class="detail-row">
                    <span>Confirmation Status</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.ConfirmationStatus)</strong>
                </div>

                <div class="detail-row detail-row-wide">
                    <span>Call Notes</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.CallNotes)</strong>
                </div>

                <div class="detail-row detail-row-wide">
                    <span>Notes / Flag</span>
                    <strong>@DisplayOrPlaceholder(SelectedSchedule.NotesFlag)</strong>
                </div>

                @if (SelectedSchedule.CompletedDate.HasValue)
                {
                    <div class="detail-row detail-row-wide">
                        <span>Completed</span>
                        <strong>@SelectedSchedule.CompletedDate.Value.ToString("MMMM d, yyyy h:mm tt")</strong>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (ShowImportReview)
{
    <div class="import-review-overlay" @onclick:stopPropagation="true">
        <div class="import-review-modal" role="dialog" aria-modal="true" aria-labelledby="schedule-import-title">
            <div class="import-review-header">
                <div>
                    <h3 id="schedule-import-title">Review Schedule Import</h3>
                    <p>
                        Schedules are imported independently of the CCAP Patient record.
                        A patient match is used when available, but it is <strong>not required to save the schedule</strong>.
                    </p>
                </div>

                <button type="button"
                        class="import-review-close"
                        title="Close review"
                        aria-label="Close review"
                        @onclick="CloseImportReview"
                        @onclick:stopPropagation="true"
                        disabled="@IsImporting">
                    ×
                </button>
            </div>

            <div class="import-summary">
                <strong>@ImportPreview.Count schedule(s) found.</strong>
                <span>@ImportPreview.Count(x => x.IsDuplicate) duplicate(s).</span>
                <span>@ImportPreview.Count(x => !x.IsDuplicate) new schedule(s).</span>

                @if (ImportPreview.Any(x => x.HasWarning))
                {
                    <span class="text-warning-emphasis">
                        <strong>@ImportPreview.Count(x => x.HasWarning) warning(s).</strong>
                        These schedules can still be saved.
                    </span>
                }
            </div>

            @if (ImportPreview.Any(x => x.IsDuplicate || x.HasWarning))
            {
                <div class="import-review-notice" role="status">
                    <strong>Notice</strong>
                    @if (ImportPreview.Any(x => x.IsDuplicate))
                    {
                        <p>@ImportPreview.Count(x => x.IsDuplicate) duplicate visit(s) were detected. These will be skipped automatically and existing visits will not be changed.</p>
                    }
                    @if (ImportPreview.Any(x => x.HasWarning))
                    {
                        <p>@ImportPreview.Count(x => x.HasWarning) visit(s) have validation warnings. Review their details before importing.</p>
                    }
                </div>
            }

            @if (ShowDuplicateImportConfirmation)
            {
                <div class="import-duplicate-confirmation" role="group" aria-label="Confirm skipping duplicate visits">
                    <strong>Confirm import with duplicates</strong>
                    <p>@ImportPreview.Count(x => x.IsDuplicate) duplicate visit(s) will be skipped. Only @ImportPreview.Count(x => !x.IsDuplicate && x.CanImport) new eligible visit(s) will be submitted for import. Continue?</p>
                    <div class="import-duplicate-confirmation-actions">
                        <button type="button" class="btn btn-secondary" disabled="@IsImporting" @onclick="() => ShowDuplicateImportConfirmation = false">Back to Preview</button>
                        <button type="button" class="btn btn-primary" disabled="@IsImporting" @onclick="ProceedWithImport">Confirm &amp; Import New Visits</button>
                    </div>
                </div>
            }

            <div class="import-review-body">
                <div class="table-responsive import-table">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Time Block</th>
                                <th>Patient Name</th>
                                <th>Confirmation Status</th>
                                <th>Call Notes</th>
                                <th>Assigned Clinician</th>
                                <th>Type of Visit</th>
                                <th>Visit Status</th>
                                <th>Notes / Flag</th>
                                <th>Existing Schedule</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in ImportPreview)
                        {
                            <tr>
                                <td>
                                    @if (item.IsDuplicate)
                                    {
                                        <span class="text-warning-emphasis fw-semibold">Skip Duplicate</span>
                                    }
                                    else if (item.CanImport)
                                    {
                                        <span class="text-success-emphasis fw-semibold">Add</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger-emphasis fw-semibold">Skip</span>
                                    }

                                </td>
                                <td>@item.ScheduledDate.ToString("MMM d, yyyy")</td>
                                <td>@item.ScheduledDate.ToString("dddd")</td>
                                <td>@item.TimeBlock</td>
                                <td><strong>@item.PatientName</strong></td>
                                <td>@item.ConfirmationStatus</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.CallNotes))
                                    {
                                        <span>@item.CallNotes</span>
                                    }
                                </td>
                                <td>@item.ClinicianName</td>
                                <td>@item.VisitType</td>
                                <td><span class="status-badge @GetVisitStatusClass(item.VisitStatus)">@DisplayOrPlaceholder(item.VisitStatus)</span></td>
                                <td>@item.NotesFlag</td>
                                <td>
                                    @(item.IsDuplicate
                                        ? $"{item.ExistingClinicianName} — {item.ExistingStatus}"
                                        : "None")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="import-review-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseImportReview"
                        @onclick:stopPropagation="true"
                        disabled="@IsImporting">
                    Cancel
                </button>

                <button type="button"
                        class="btn @(ImportPreview.Any(x => x.HasWarning) ? "btn-warning" : "btn-primary")"
                        @onclick="RequestImportConfirmation"
                        @onclick:stopPropagation="true"
                        disabled="@(IsImporting || ShowDuplicateImportConfirmation)">
                    @(IsImporting
                        ? "Importing..."
                        : ShowDuplicateImportConfirmation
                            ? "Awaiting Confirmation"
                            : ImportPreview.Any(x => x.IsDuplicate)
                                ? "Review Duplicate Confirmation"
                                : ImportPreview.Any(x => x.HasWarning)
                                    ? "Proceed with Caution"
                                    : "Proceed with Import")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool CanManageScheduling;
    private List<SchedulingClinicianDto> CareCoordinators = [];
    private List<SchedulingLookupOptionDto> ConfirmationOptions = [];
    private readonly HashSet<Guid> SelectedCcVisitIds = [];
    private string SelectedCareCoordinatorId = string.Empty;
    private bool ShowCcConfirmation;
    private bool IsAssigningCc;
    private bool ShowDeleteConfirmation;
    private bool IsDeletingVisits;

    private void ToggleCcVisit(Guid visitId, bool selected)
    {
        if (selected) SelectedCcVisitIds.Add(visitId);
        else SelectedCcVisitIds.Remove(visitId);
    }
    private void ToggleCurrentPage(ChangeEventArgs e)
    {
        var selected = e.Value is true;
        foreach (var visit in PagedTrackerSchedules) ToggleCcVisit(visit.VisitId, selected);
    }
    private string GetSelectedCcName() => CareCoordinators.FirstOrDefault(c => c.UserId.ToString() == SelectedCareCoordinatorId)?.FullName ?? "selected Care Coordinator";

    private async Task ConfirmCcAssignmentAsync()
    {
        if (!CanManageScheduling || IsAssigningCc || !Guid.TryParse(SelectedCareCoordinatorId, out var ccId)) return;
        IsAssigningCc = true;
        StatusUpdateError = null;
        try
        {
            var count = await CalendarService.AssignCareCoordinatorAsync(ccId, SelectedCcVisitIds.ToArray());
            SelectedCcVisitIds.Clear();
            ShowCcConfirmation = false;
            await LoadSchedulesAsync();
            StatusUpdateError = $"Assigned Care Coordinator to {count} visit(s). Existing assignments were skipped.";
        }
        catch { StatusUpdateError = "Could not assign the Care Coordinator. Please try again."; }
        finally { IsAssigningCc = false; }
    }

    private async Task ConfirmDeleteVisitsAsync()
    {
        if (!CanManageScheduling || IsDeletingVisits || SelectedCcVisitIds.Count == 0) return;
        IsDeletingVisits = true;
        StatusUpdateError = null;
        try
        {
            var count = await CalendarService.DeleteVisitsAsync(SelectedCcVisitIds.ToArray());
            SelectedCcVisitIds.Clear();
            ShowDeleteConfirmation = false;
            await LoadSchedulesAsync();
            StatusUpdateError = $"Permanently deleted {count} scheduled visit(s).";
        }
        catch { StatusUpdateError = "Could not delete the selected visits. No further deletion was requested."; }
        finally { IsDeletingVisits = false; }
    }

    private async Task SaveTrackerFieldAsync(CalendarVisitDto visit, string? confirmation = null, string? callNotes = null,
        bool updateNotes = false, string? clinicianValue = null, bool updateClinician = false)
    {
        if (!CanManageScheduling || !SavingVisitIds.Add(visit.VisitId)) return;
        StatusUpdateError = null;
        var newConfirmation = confirmation ?? visit.ConfirmationStatus ?? string.Empty;
        var newNotes = updateNotes ? callNotes : visit.CallNotes;
        Guid? newClinician = updateClinician && Guid.TryParse(clinicianValue, out var parsed) ? parsed : (updateClinician ? null : visit.ClinicianId);
        try
        {
            await CalendarService.UpdateTrackerDetailsAsync(visit.VisitId, newConfirmation, newNotes, newClinician);
            visit.ConfirmationStatus = newConfirmation;
            visit.CallNotes = newNotes;
            visit.ClinicianId = newClinician;
            if (updateClinician) visit.Clinician = Clinicians.FirstOrDefault(c => c.UserId == newClinician)?.FullName ?? "Unassigned";
        }
        catch { StatusUpdateError = $"Could not save changes for {visit.PatientName}. Please refresh and try again."; }
        finally { SavingVisitIds.Remove(visit.VisitId); }
    }

    private static readonly string[] EditableVisitStatuses = ["Scheduled", "Completed", "Missed", "Rescheduled", "Cancelled"];
    private readonly HashSet<Guid> SavingVisitIds = [];
    private string? StatusUpdateError;

    private async Task ChangeVisitStatusAsync(CalendarVisitDto schedule, string? status)
    {
        if (!CanManageScheduling || status is null || !EditableVisitStatuses.Contains(status) ||
            status == schedule.Status || !SavingVisitIds.Add(schedule.VisitId))
            return;

        StatusUpdateError = null;
        try
        {
            await CalendarService.UpdateVisitStatusAsync(schedule.VisitId, status);
            schedule.Status = status;
        }
        catch
        {
            StatusUpdateError = $"Could not save the status for {schedule.PatientName}. Please try again.";
        }
        finally
        {
            SavingVisitIds.Remove(schedule.VisitId);
        }
    }



