    private static string GetVisitStatusClass(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "completed" => "status-completed",
            "missed" => "status-missed",
            "rescheduled" => "status-rescheduled",
            "cancelled" => "status-cancelled",
            _ => "status-empty"
        };
    }

    private async Task HandleScheduleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        var extension = Path.GetExtension(file.Name);
        if (!string.Equals(extension, ".xlsx", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(extension, ".csv", StringComparison.OrdinalIgnoreCase))
        {
            await ShowScheduleErrorAsync(
                "Invalid File",
                "Please select an Excel (.xlsx) or CSV schedule file.");
            return;
        }

        IsImporting = true;
        ShowImportReview = false;
        ShowDuplicateImportConfirmation = false;
        ImportPreview.Clear();

        await ShowScheduleLoadingAsync(
            "Validating Schedule",
            "Reading the uploaded schedule and checking its format...");

        try
        {
            ImportPreview = await CalendarService.PreviewImportAsync(file);

            await CloseScheduleAlertAsync();

            if (ImportPreview.Count == 0)
            {
                await ShowScheduleErrorAsync(
                    "No Schedule Found",
                    "The uploaded file does not contain any valid scheduled visits.");
                return;
            }

            ShowDuplicateImportConfirmation = false;
            ShowImportReview = true;
        }
        catch (HttpRequestException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync(
                "Schedule Validation Failed",
                GetScheduleErrorMessage(ex));
        }
        catch (InvalidOperationException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync(
                "Invalid Schedule File",
                GetScheduleErrorMessage(ex));
        }
        catch (Exception)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync(
                "Unable to Read Schedule",
                "The uploaded file could not be processed. Please verify that it is a valid weekly schedule file.");
        }
        finally
        {
            IsImporting = false;
        }
    }

    private async Task RequestImportConfirmation()
    {
        if (IsImporting || ImportPreview.Count == 0) return;
        if (ImportPreview.Any(x => x.IsDuplicate))
        {
            ShowDuplicateImportConfirmation = true;
            return;
        }
        await ProceedWithImport();
    }

    private async Task ProceedWithImport()
    {
        if (IsImporting || ImportPreview.Count == 0)
            return;

        IsImporting = true;

        ShowImportReview = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        await ShowScheduleLoadingAsync(
            "Importing Schedule",
            "Saving the selected schedules to CCAP...");

        ScheduleImportResult result;

        try
        {
            result = await CalendarService.CommitImportAsync(ImportPreview);
        }
        catch (HttpRequestException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync("Import Failed", GetScheduleErrorMessage(ex));
            IsImporting = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (InvalidOperationException ex)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync("Import Validation Failed", GetScheduleErrorMessage(ex));
            IsImporting = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (Exception)
        {
            await CloseScheduleAlertAsync();
            await ShowScheduleErrorAsync("Import Failed", "The schedules could not be imported. Please try again.");
            IsImporting = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        ImportPreview.Clear();

        await CloseScheduleAlertAsync();
        await LoadSchedulesAsync();

        var resultMessage =
            $"{result.Added} added, {result.Overwritten} overwritten, {result.Kept} kept" +
            (result.Skipped > 0 ? $", {result.Skipped} skipped" : "") + ".";

        if (result.Warnings > 0 || result.Skipped > 0)
        {
            var warningMessage = resultMessage;

            if (result.Warnings > 0)
                warningMessage += $" {result.Warnings} schedule(s) were saved with mapping warnings.";

            if (result.Skipped > 0)
                warningMessage += " Rows that could not be imported were skipped.";

            await ShowScheduleWarningAsync("Import Completed with Warnings", warningMessage);
        }
        else
        {
            await ShowScheduleSuccessAsync("Schedule Imported", resultMessage);
        }

        IsImporting = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowScheduleLoadingAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.loading", title, text);
    }

    private async Task CloseScheduleAlertAsync()
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.close");
    }

    private async Task ShowScheduleErrorAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.error", title, text);
    }

    private async Task ShowScheduleSuccessAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.success", title, text);
    }

    private async Task ShowScheduleWarningAsync(string title, string text)
    {
        await JS.InvokeVoidAsync("ccapScheduleAlert.warning", title, text);
    }

    private static string GetScheduleErrorMessage(Exception ex)
    {
        return string.IsNullOrWhiteSpace(ex.Message)
            ? "The schedule file could not be validated."
            : ex.Message;
    }

    private void CloseImportReview()
    {
        if (IsImporting)
            return;

        ShowImportReview = false;
        ShowDuplicateImportConfirmation = false;
        ImportPreview.Clear();
        StateHasChanged();
    }
