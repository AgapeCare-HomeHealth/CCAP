@page "/scheduling/calendar"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CCAP.Web.Features.Scheduling.Calendar.Components
@using CCAP.Web.Features.Scheduling.Calendar.Models
@using CCAP.Web.Features.Scheduling.Calendar.Services
@inject CalendarService CalendarService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@attribute [CcapAuthorize(Policy = "scheduling.view")]

<div class="scheduling-calendar-page">
    <div class="calendar-page-header">
        <div>
            <h1>Scheduling Calendar</h1>
            <p>View and manage patient schedules by day.</p>
        </div>
    </div>

    <div class="calendar-card">
        <div class="calendar-toolbar">
            <div class="calendar-navigation">
                <button type="button" class="toolbar-button" @onclick="GoToToday">Today</button>
                <button type="button" class="toolbar-button navigation-button" aria-label="Previous month" @onclick="PreviousMonth">‹</button>
                <button type="button" class="toolbar-button navigation-button" aria-label="Next month" @onclick="NextMonth">›</button>
                <h2 class="month-title">@CurrentMonth.ToString("MMMM yyyy")</h2>
            </div>
        </div>

        <div class="filters-panel">
            <div class="filter-group physician-filter">
                <label for="physicianFilter">Physician / Clinician</label>
                <select id="physicianFilter" class="filter-select" @bind="SelectedPhysician">
                    <option value="">All Physicians / Clinicians</option>
                    @foreach (var physician in PhysicianOptions)
                    {
                        <option value="@physician">@physician</option>
                    }
                </select>
            </div>
            <div class="filter-group patient-filter">
                <label for="patientSearch">Search Patient / Clinician / CC</label>
                <input id="patientSearch" class="filter-input" type="text"
                       placeholder="Search patient, clinician, or CC"
                       @bind="PatientSearchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group filter-action-group">
                <label>&nbsp;</label>
                <button type="button" class="btn-clear-filters" @onclick="ClearFilters">Clear Filters</button>
            </div>
        </div>

        <div class="toolbar-summary">
            <div class="summary-pill"><strong>@FilteredSchedules.Count</strong> visit(s) shown</div>
            <div class="summary-pill muted"><strong>@GetSchedulesForDate(DateTime.Today).Count</strong> visit(s) today</div>
            @if (!string.IsNullOrWhiteSpace(SelectedPhysician))
            {
                <div class="summary-pill accent">Filtered by: @SelectedPhysician</div>
            }
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="calendar-feedback success" role="status">@StatusMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(StatusError))
            {
                <div class="calendar-feedback error" role="alert">@StatusError</div>
            }
        </div>

        @if (IsLoading)
        {
            <div class="alert alert-info m-3 mb-0">Loading schedules...</div>
        }
        else if (!string.IsNullOrWhiteSpace(CalendarLoadErrorMessage))
        {
            <div class="alert alert-danger m-3 mb-0">@CalendarLoadErrorMessage</div>
        }
        else
        {
            <div class="calendar-grid">
                @foreach (var weekday in Weekdays)
                {
                    <div class="calendar-weekday" @key="weekday">@weekday</div>
                }

                @foreach (var day in CalendarDays)
                {
                    var daySchedules = GetSchedulesForDate(day);
                    <div @key="day"
                         class="calendar-day @(day.Month != CurrentMonth.Month ? "other-month" : "") @(SelectedDate.Date == day.Date ? "selected-day" : "") @(DraggingVisitId.HasValue ? "drop-target-ready" : "")"
                         @onclick="() => SelectDate(day)"
                         @ondragover:preventDefault="true"
                         @ondrop:preventDefault="true"
                         @ondrop="() => HandleScheduleDropAsync(day)">
                        <div class="calendar-day-header">
                            <div class="day-number">@day.Day</div>
                            <div class="calendar-day-actions">
                                @if (daySchedules.Count > 0)
                                {
                                    <div class="day-count">@daySchedules.Count</div>
                                }
                                @if (CanManageScheduling)
                                {
                                    <button type="button" class="calendar-add-day-button"
                                            title="Add schedule for @day.ToString("MMMM d, yyyy")"
                                            aria-label="Add schedule for @day.ToString("MMMM d, yyyy")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenAddScheduleModal(day)">
                                        <span aria-hidden="true">+</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="day-events">
                            @foreach (var schedule in daySchedules.Take(4))
                            {
                                <div @key="schedule.VisitId" class="schedule-event-wrapper">
                                    <button type="button"
                                            class="schedule-event @(DraggingVisitId == schedule.VisitId ? "is-dragging" : "")"
                                            draggable="@(CanModifySchedule(schedule) && !string.Equals(schedule.Status, "Completed", StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                            title="Drag to reschedule; click to view or edit this schedule"
                                            @ondragstart="() => BeginDragging(schedule)"
                                            @ondragend="EndDragging"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => SelectSchedule(schedule)">
                                        <div class="event-title">@schedule.PatientName</div>
                                        <div class="event-meta">
                                            @GetTimeDisplay(schedule)
                                            @if (!string.IsNullOrWhiteSpace(schedule.Clinician) && !string.Equals(schedule.Clinician, "Unassigned", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span>• @schedule.Clinician</span>
                                            }
                                        </div>
                                    </button>
                                    @if (CanDeleteSchedule(schedule))
                                    {
                                        <button type="button" class="schedule-card-delete" title="Delete this schedule" aria-label="Delete schedule for @schedule.PatientName"
                                                @onclick:stopPropagation="true" @onclick="() => DeleteScheduleFromCardAsync(schedule)">×</button>
                                    }
                                </div>
                            }
                            @if (daySchedules.Count > 4)
                            {
                                <div class="more-events">+@(daySchedules.Count - 4) more</div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="calendar-legend">
                @if (CanManageScheduling)
                {
                    <span><span aria-hidden="true">↕</span> Drag a visit to another day to reschedule it.</span>
                }
                <span><span aria-hidden="true">▦</span> Multi-date schedules share a recurring group.</span>
            </div>
        }
    </div>

    @if (SelectedDate != DateTime.MinValue)
    {
        <div class="selected-day-panel">
            <div class="selected-day-header">
                <div>
                    <span>Selected Day</span>
                    <h3>@SelectedDate.ToString("dddd, MMMM d, yyyy")</h3>
                </div>
                <button type="button" class="close-panel-button" aria-label="Close selected day" @onclick="ClearSelectedDate">×</button>
            </div>

            @{
                var selectedSchedules = GetSchedulesForDate(SelectedDate);
            }
            @if (selectedSchedules.Any())
            {
                <div class="selected-schedule-list">
                    @foreach (var schedule in selectedSchedules)
                    {
                        <div class="selected-schedule-row" @key="schedule.VisitId">
                            <button type="button" class="selected-schedule-item" @onclick="() => SelectSchedule(schedule)">
                                <div class="selected-schedule-time">@GetTimeDisplay(schedule)</div>
                                <div class="selected-schedule-info">
                                    <strong>@schedule.PatientName</strong>
                                    <span>@DisplayOrPlaceholder(schedule.Clinician) • @DisplayOrPlaceholder(schedule.Status) • CC: @DisplayOrPlaceholder(schedule.CareCoordinatorName)</span>
                                    @if (!string.IsNullOrWhiteSpace(schedule.NotesFlag))
                                    {
                                        <div class="selected-schedule-note selected-schedule-flag" title="@schedule.NotesFlag">
                                            <span class="selected-schedule-note-label">Flag</span>
                                            <span class="selected-schedule-note-value">@schedule.NotesFlag</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(schedule.CallNotes))
                                    {
                                        <div class="selected-schedule-note selected-schedule-call-notes" title="@schedule.CallNotes">
                                            <span class="selected-schedule-note-label">Call notes</span>
                                            <span class="selected-schedule-note-value">@schedule.CallNotes</span>
                                        </div>
                                    }
                                </div>
                            </button>
                            @if (CanDeleteSchedule(schedule))
                            {
                                <button type="button" class="schedule-card-delete selected-day-delete" title="Delete this schedule" aria-label="Delete schedule for @schedule.PatientName" @onclick="() => DeleteScheduleFromCardAsync(schedule)">×</button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="selected-day-empty">
                    <span>No visits scheduled for this day with the current filters.</span>
                </div>
            }
        </div>
    }

</div>

@if (ShowAddScheduleModal)
{
    <AddScheduleModal InitialDate="ModalInitialDate"
                      Clinicians="Clinicians"
                      CareCoordinators="CareCoordinators"
                      ConfirmationOptions="ConfirmationOptions"
                      VisitStatusOptions="VisitStatusOptions"
                      CurrentUserId="CurrentUserId"
                      IsCareCoordinator="IsCareCoordinator"
                      CanAssignCareCoordinator="CanAssignCareCoordinator"
                      OnClose="CloseAddScheduleModal"
                      OnSaved="HandleScheduleCreatedAsync" />
}

@if (ShowEditScheduleModal && SelectedSchedule is not null)
{
    <EditScheduleModal Visit="SelectedSchedule"
                       Clinicians="Clinicians"
                       ConfirmationOptions="ConfirmationOptions"
                       VisitStatusOptions="VisitStatusOptions"
                       CanEdit="@(SelectedSchedule is not null && CanModifySchedule(SelectedSchedule))"
                       CurrentUserId="CurrentUserId"
                       OnClose="CloseEditScheduleModal"
                       OnSaved="HandleScheduleDetailsSavedAsync"
                       OnDeleted="HandleScheduleDeletedAsync" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool CanManageScheduling;
    private bool IsCareCoordinator;
    private bool IsAdministrator;
    private bool CanAssignCareCoordinator;
    private Guid CurrentUserId;
    private List<SchedulingClinicianDto> Clinicians = [];
    private List<SchedulingClinicianDto> CareCoordinators = [];
    private List<SchedulingLookupOptionDto> ConfirmationOptions = [];
    private List<SchedulingLookupOptionDto> VisitStatusOptions = [];

    private DateTime CurrentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime SelectedDate = DateTime.Today;
    private DateTime ModalInitialDate = DateTime.Today;
    private CalendarVisitDto? SelectedSchedule;
    private readonly string[] Weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private List<DateTime> CalendarDays = [];
    private List<CalendarVisitDto> Schedules = [];
    private bool IsLoading;
    private string? CalendarLoadErrorMessage;
    private string? StatusMessage;
    private string? StatusError;
    private bool ShowAddScheduleModal;
    private bool ShowEditScheduleModal;
    private Guid? DraggingVisitId;
    private readonly HashSet<Guid> ReschedulingVisitIds = [];

    private string _selectedPhysician = string.Empty;
    private string SelectedPhysician
    {
        get => _selectedPhysician;
        set
        {
            if (_selectedPhysician == value) return;
            _selectedPhysician = value;
            SyncSelectionWithFilters();
        }
    }

    private string _patientSearchTerm = string.Empty;
    private string PatientSearchTerm
    {
        get => _patientSearchTerm;
        set
        {
            if (_patientSearchTerm == value) return;
            _patientSearchTerm = value;
            SyncSelectionWithFilters();
        }
    }

    private List<string> PhysicianOptions => Clinicians.Select(x => x.FullName)
        .Concat(Schedules.Select(x => x.Clinician))
        .Where(x => !string.IsNullOrWhiteSpace(x) && !string.Equals(x, "Unassigned", StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();

    private List<CalendarVisitDto> FilteredSchedules => Schedules.Where(MatchesCurrentFilters)
        .OrderBy(x => x.ScheduledDate).ThenBy(x => x.PatientName).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;
            CanManageScheduling = user.HasClaim("permission", "scheduling.manage");
            IsCareCoordinator = user.IsInRole("Care Coordinator");
            IsAdministrator = user.IsInRole("Administrator") || user.IsInRole("Admin");
            CanAssignCareCoordinator = user.IsInRole("Administrator") || user.IsInRole("Admin") || user.IsInRole("Scheduler");
            Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out CurrentUserId);
        }

        GenerateCalendarDays();
        await LoadSchedulingOptionsAsync();
        await LoadSchedulesAsync();
    }

    private async Task LoadSchedulingOptionsAsync()
    {
        try
        {
            var options = await CalendarService.GetSchedulingOptionsAsync();
            Clinicians = options.Clinicians;
            CareCoordinators = options.CareCoordinators;
            ConfirmationOptions = options.ConfirmationStatuses;
            VisitStatusOptions = options.VisitStatuses;
        }
        catch
        {
            Clinicians = [];
            CareCoordinators = [];
            ConfirmationOptions = [];
            VisitStatusOptions = [];
        }
    }

    private async Task LoadSchedulesAsync()
    {
        IsLoading = true;
        CalendarLoadErrorMessage = null;
        try
        {
            var (start, end) = GetVisibleDateRange();
            Schedules = await CalendarService.GetVisitsAsync(start, end);
            SyncSelectionWithFilters();
        }
        catch
        {
            Schedules = [];
            CalendarLoadErrorMessage = "Unable to load schedules right now. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private (DateTime Start, DateTime End) GetVisibleDateRange() =>
        (CalendarDays.First().Date, CalendarDays.Last().Date.AddDays(1));

    private void GenerateCalendarDays()
    {
        CalendarDays.Clear();
        var calendarStart = CurrentMonth.AddDays(-(int)CurrentMonth.DayOfWeek);
        var lastDayOfMonth = CurrentMonth.AddMonths(1).AddDays(-1);
        var calendarEnd = lastDayOfMonth.AddDays(6 - (int)lastDayOfMonth.DayOfWeek);
        for (var date = calendarStart; date <= calendarEnd; date = date.AddDays(1))
            CalendarDays.Add(date);
    }

    private bool MatchesCurrentFilters(CalendarVisitDto schedule)
    {
        var matchesPhysician = string.IsNullOrWhiteSpace(SelectedPhysician) ||
            string.Equals(schedule.Clinician, SelectedPhysician, StringComparison.OrdinalIgnoreCase);
        var search = PatientSearchTerm.Trim();
        var matchesSearch = string.IsNullOrEmpty(search) ||
            (schedule.PatientName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (schedule.Clinician?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (schedule.CareCoordinatorName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
        return matchesPhysician && matchesSearch;
    }

    private List<CalendarVisitDto> GetSchedulesForDate(DateTime date) => FilteredSchedules
        .Where(x => x.ScheduledDate.Date == date.Date)
        .OrderBy(x => x.ScheduledDate).ThenBy(x => x.PatientName).ToList();

    private void SelectDate(DateTime date)
    {
        SelectedDate = date.Date;
        SelectedSchedule = null;
        ShowEditScheduleModal = false;
        StatusMessage = null;
        StatusError = null;
    }

    private void SelectSchedule(CalendarVisitDto schedule)
    {
        SelectedSchedule = schedule;
        SelectedDate = schedule.ScheduledDate.Date;
        ShowEditScheduleModal = true;
    }

    private void ClearSelectedDate()
    {
        SelectedDate = DateTime.MinValue;
        SelectedSchedule = null;
        ShowEditScheduleModal = false;
    }

    private Task CloseEditScheduleModal()
    {
        ShowEditScheduleModal = false;
        return Task.CompletedTask;
    }

    private async Task GoToToday()
    {
        var today = DateTime.Today;
        CurrentMonth = new DateTime(today.Year, today.Month, 1);
        SelectedDate = today;
        SelectedSchedule = null;
        ShowEditScheduleModal = false;
        GenerateCalendarDays();
        await LoadSchedulesAsync();
    }

    private async Task PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        SelectedDate = CurrentMonth;
        SelectedSchedule = null;
        ShowEditScheduleModal = false;
        GenerateCalendarDays();
        await LoadSchedulesAsync();
    }

    private async Task NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        SelectedDate = CurrentMonth;
        SelectedSchedule = null;
        ShowEditScheduleModal = false;
        GenerateCalendarDays();
        await LoadSchedulesAsync();
    }

    private void ClearFilters()
    {
        _selectedPhysician = string.Empty;
        _patientSearchTerm = string.Empty;
        SyncSelectionWithFilters();
    }

    private void SyncSelectionWithFilters()
    {
        var visible = FilteredSchedules;
        if (SelectedSchedule is not null && visible.All(x => x.VisitId != SelectedSchedule.VisitId))
        {
            SelectedSchedule = null;
            ShowEditScheduleModal = false;
        }
        if (SelectedDate != DateTime.MinValue && GetSchedulesForDate(SelectedDate).Count == 0)
            SelectedDate = DateTime.Today.Month == CurrentMonth.Month && DateTime.Today.Year == CurrentMonth.Year
                ? DateTime.Today
                : CurrentMonth;
    }

    private void OpenAddScheduleModal(DateTime date)
    {
        if (!CanManageScheduling) return;
        ModalInitialDate = date.Date;
        ShowAddScheduleModal = true;
        StatusMessage = null;
        StatusError = null;
    }

    private Task CloseAddScheduleModal()
    {
        ShowAddScheduleModal = false;
        return Task.CompletedTask;
    }

    private async Task HandleScheduleCreatedAsync(string message)
    {
        StatusMessage = message;
        StatusError = null;
        await LoadSchedulesAsync();
        SelectedDate = ModalInitialDate.Date;
    }

    private async Task HandleScheduleDetailsSavedAsync(string message)
    {
        StatusMessage = message;
        StatusError = null;
        var visitId = SelectedSchedule?.VisitId;
        await LoadSchedulesAsync();
        if (visitId.HasValue)
            SelectedSchedule = Schedules.FirstOrDefault(x => x.VisitId == visitId.Value);
        ShowEditScheduleModal = false;
    }

    private async Task DeleteScheduleFromCardAsync(CalendarVisitDto schedule)
    {
        if (schedule.AssignedUserId != CurrentUserId || !(CanManageScheduling || IsCareCoordinator))
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete the schedule for {schedule.PatientName} on {schedule.ScheduledDate:MMMM d, yyyy}? This cannot be undone.");
        if (!confirmed) return;

        try
        {
            await CalendarService.DeleteVisitsAsync([schedule.VisitId]);
            if (SelectedSchedule?.VisitId == schedule.VisitId)
            {
                SelectedSchedule = null;
                ShowEditScheduleModal = false;
            }
            StatusMessage = $"Deleted the schedule for {schedule.PatientName}.";
            StatusError = null;
            await LoadSchedulesAsync();
        }
        catch
        {
            StatusError = "Could not delete this schedule. Only the user who created this calendar entry can delete it.";
            StatusMessage = null;
        }
    }

    private async Task HandleScheduleDeletedAsync(string message)
    {
        StatusMessage = message;
        StatusError = null;
        ShowEditScheduleModal = false;
        SelectedSchedule = null;
        await LoadSchedulesAsync();
    }

    private bool IsAssignedToCurrentCoordinator(CalendarVisitDto schedule) =>
        schedule.CareCoordinatorId == CurrentUserId ||
        (!schedule.CareCoordinatorId.HasValue && schedule.AssignedUserId == CurrentUserId);

    private bool CanModifySchedule(CalendarVisitDto schedule)
    {
        if (CurrentUserId == Guid.Empty)
            return false;

        // Administrators may view all CC schedules, but may only modify entries
        // assigned to themselves (or their own legacy, unassigned entries).
        if (IsAdministrator)
            return IsAssignedToCurrentCoordinator(schedule);

        // Care Coordinators stay inside their own assignment scope.
        if (IsCareCoordinator)
            return IsAssignedToCurrentCoordinator(schedule);

        // Scheduler / other scheduling-manage roles retain their existing scope.
        return CanManageScheduling;
    }

    private bool CanDeleteSchedule(CalendarVisitDto schedule)
    {
        if ((!CanManageScheduling && !IsCareCoordinator) || CurrentUserId == Guid.Empty || schedule.AssignedUserId != CurrentUserId)
            return false;

        // Do not let Admin delete a visit belonging to another Care Coordinator.
        if (IsAdministrator && schedule.CareCoordinatorId.HasValue && schedule.CareCoordinatorId != CurrentUserId)
            return false;

        return true;
    }

    private void BeginDragging(CalendarVisitDto schedule)
    {
        if (!CanModifySchedule(schedule) || string.Equals(schedule.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            DraggingVisitId = null;
            return;
        }
        DraggingVisitId = schedule.VisitId;
        StatusMessage = null;
        StatusError = null;
    }

    private void EndDragging() => DraggingVisitId = null;

    private async Task HandleScheduleDropAsync(DateTime targetDay)
    {
        if (!DraggingVisitId.HasValue) return;
        var visitId = DraggingVisitId.Value;
        DraggingVisitId = null;
        var schedule = Schedules.FirstOrDefault(x => x.VisitId == visitId);
        if (schedule is null || schedule.ScheduledDate.Date == targetDay.Date) return;
        if (!CanModifySchedule(schedule))
        {
            StatusError = "You cannot reschedule a visit assigned to another Care Coordinator.";
            return;
        }
        if (string.Equals(schedule.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            StatusError = "Completed visits cannot be rescheduled.";
            return;
        }
        if (!ReschedulingVisitIds.Add(visitId)) return;

        StatusError = null;
        StatusMessage = null;
        var originalTime = schedule.ScheduledDate.TimeOfDay;
        try
        {
            await CalendarService.RescheduleVisitAsync(visitId, targetDay.Date);
            schedule.ScheduledDate = targetDay.Date.Add(originalTime);
            schedule.Status = "Scheduled";
            SelectedDate = targetDay.Date;
            SelectedSchedule = schedule;
            await LoadSchedulesAsync();
            SelectedSchedule = Schedules.FirstOrDefault(x => x.VisitId == visitId);
            StatusMessage = $"Rescheduled {schedule.PatientName} to {targetDay:MMMM d, yyyy}.";
        }
        catch
        {
            StatusError = "Could not reschedule this visit. Verify your permissions and try again.";
        }
        finally
        {
            ReschedulingVisitIds.Remove(visitId);
        }
    }

    private static string GetTimeDisplay(CalendarVisitDto schedule) =>
        !string.IsNullOrWhiteSpace(schedule.TimeBlock) ? schedule.TimeBlock : schedule.ScheduledDate.ToString("h:mm tt");

    private static string DisplayOrPlaceholder(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
