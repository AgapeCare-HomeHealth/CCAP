@page "/notifications/activity"
@attribute [CcapAuthorize(Policy = "notifications.view")]

@using CCAP.Web.Features.Notifications.Models
@using CCAP.Web.Features.Notifications.Services
@inject NotificationCenterService NotificationCenter
@inject NavigationManager Navigation

<PageTitle>All Activity</PageTitle>

<div class="container-fluid py-4 activity-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1">All Activity</h2>
            <p class="text-muted mb-0">Notifications, items needing attention, and recent activity with date and time.</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@Loading">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-warning">@ErrorMessage</div>
    }
    @if (Loading)
    {
        <div class="text-center py-5"><span class="spinner-border" role="status"></span><div class="mt-2 text-muted">Loading activity...</div></div>
    }
    else if (Activities.Count == 0)
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
            <i class="bi bi-check-circle fs-1 text-success"></i>
            <h5 class="mt-3">You're all caught up!</h5>
            <p class="text-muted mb-0">No activity or items needing attention were found.</p>
        </div></div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr>
                        <th>Activity</th><th>Patient</th><th>Details</th><th>Priority</th><th>Status</th><th>Date &amp; Time</th><th></th>
                    </tr></thead>
                    <tbody>
                    @foreach (var item in Activities)
                    {
                        <tr @key="item.NotificationId">
                            <td><i class="@GetIcon(item.Type) me-2 text-secondary"></i><strong>@item.Title</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(item.PatientName) ? "—" : item.PatientName)</td>
                            <td>@item.Message
                                @if (item.DueDate.HasValue)
                                {
                                    <div class="small text-muted">Due @item.DueDate.Value.ToString("MMM d, yyyy")</div>
                                }
                            </td>
                            <td><span class="badge @GetSeverityClass(item.Severity)">@item.Severity</span></td>
                            <td><span class="badge @(item.IsRead ? "bg-secondary" : "bg-primary")">@(item.IsRead ? "Read" : "Needs attention")</span></td>
                            <td class="text-nowrap">@FormatTimestamp(item.CreatedAt)</td>
                            <td>
                                @if (item.PatientId != Guid.Empty)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenActivityAsync(item)">Open</button>
                                }
                                else if (!item.IsRead)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarkReadAsync(item)">Mark read</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<UserNotificationDto> Activities = [];
    private bool Loading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        ErrorMessage = null;
        try
        {
            Activities = (await NotificationCenter.GetAsync())
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load activity: {ex.Message}";
            Activities = [];
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task MarkReadAsync(UserNotificationDto item)
    {
        try
        {
            await NotificationCenter.MarkReadAsync(item);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to update notification: {ex.Message}";
        }
    }

    private async Task OpenActivityAsync(UserNotificationDto item)
    {
        if (!item.IsRead)
            await NotificationCenter.MarkReadAsync(item);
        Navigation.NavigateTo($"/tracker/patient/{item.PatientId}");
    }

    private static string FormatTimestamp(DateTime timestamp)
        => (timestamp.Kind == DateTimeKind.Utc ? timestamp.ToLocalTime() : timestamp).ToString("MMM d, yyyy h:mm:ss tt");

    private static string GetSeverityClass(string severity) => severity switch
    {
        "Critical" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };

    private static string GetIcon(string type) => type switch
    {
        "Order" => "bi bi-file-earmark-text",
        "Lab" => "bi bi-eyedropper",
        "Supply" => "bi bi-box-seam",
        "Foley" => "bi bi-heart-pulse",
        "Fax" => "bi bi-printer",
        _ => "bi bi-bell"
    };
}
