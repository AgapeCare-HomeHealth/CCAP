<div class="action-menu">

    <button class="action-button"
            @onclick="ToggleMenu">

        <i class="bi bi-three-dots-vertical"></i>

    </button>

    @if (showMenu)
    {
        <div class="action-dropdown">

            <hr />

            <button class="danger">
                <i class="bi bi-archive"></i>
                <span>Discharge</span>
            </button>

        </div>
    }

</div>

@code {

    private bool showMenu;

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

}