<span class="status-badge @GetStatusClass()">

    @Status

</span>

@code {

    [Parameter]
    public string Status { get; set; } = "";

    private string GetStatusClass()
    {
        return Status switch
        {
            "Active" => "active",
            "On Hold" => "hold",
            "Discharged" => "discharged",
            _ => "default"
        };
    }

}