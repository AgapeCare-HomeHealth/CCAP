@using CCAP.Web.Features.Patients.Models
@inject NavigationManager Navigation

<div class="patient-table-card">

    <table class="patient-table">

        <thead>

            <tr>

                <th>Patient</th>
                <th>MRN</th>
                <th>Status</th>
                <th>Primary Diagnosis</th>
                <th>Assigned Clinician</th>

            </tr>

        </thead>

        <tbody>
            @if (Patients.Any())
            {
                @foreach (var patient in Patients)
                {
                    <tr class="clickable-row"
                        @onclick="() => OpenPatient(patient)">

                        <td>
                            <div class="fw-semibold">@patient.Name</div>
                            @if (!string.IsNullOrWhiteSpace(patient.MyAssignmentRole))
                            {
                                <span class="badge @(patient.MyAssignmentRole == "Primary CC" ? "bg-success" : patient.MyAssignmentRole == "Secondary CC" ? "bg-info text-dark" : "bg-warning text-dark")">@patient.MyAssignmentRole</span>
                            }
                        </td>

                        <td>@patient.MRN</td>

                        <td>
                            <PatientStatusBadge Status="@patient.Status" />
                        </td>

                        <td>@patient.PrimaryDiagnosis</td>

                        <td>@patient.AssignedClinician</td>



                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="5"
                        class="text-center py-5">

                        No data available.

                    </td>

                </tr>
            }
            
        </tbody>

    </table>

</div>

@code {

    [Parameter]
    public List<PatientListItem> Patients { get; set; } = [];

    private void OpenPatient(PatientListItem patient)
    {
        Navigation.NavigateTo($"/tracker/patient/{patient.PatientId}");
    }

}

