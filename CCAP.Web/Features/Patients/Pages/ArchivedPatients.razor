@page "/patients/archive"
@attribute [CcapAuthorize(Policy = "patients.view")]
@using CCAP.Web.Common.Models
@using CCAP.Web.Features.Patients.Models
@using CCAP.Web.Features.Patients.Components
@using CCAP.Web.Features.Admin.Users.Models
@using CCAP.Web.Features.Admin.Users.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CCAP.Web.Features.Patients.Services.PatientService PatientService
@inject UserServices UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Archived Patients</PageTitle>

<div class="patients-page">
    <div class="page-header d-flex justify-content-between align-items-start">
        <div><h2>Archived Patients</h2><p>Patient workflow retained for history and audit.</p></div>
        <a class="btn btn-outline-primary" href="/patients">Back to Active Patients</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(CoordinatorLoadError))
    {
        <SweetAlertError Message="@CoordinatorLoadError" />
    }
    <PatientToolbar Filter="Filter" OnFilter="ApplyFilter" HideStatusFilter="true"
                    ShowCareCoordinatorFilter="@IsAdministrator" CareCoordinators="@CareCoordinators" />
    @if (IsLoading)
    {
        <div class="py-5 text-center">Loading archived patients...</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <SweetAlertError Message="@ErrorMessage" />
    }
    else
    {
        <PatientTable Patients="PatientList" />
        <div class="patient-pagination d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
    <div class="pagination-info">
        Showing @StartItem to @EndItem of @(Result?.TotalCount ?? 0) patients
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <label class="small text-muted" for="active-page-size">Rows per page</label>
        <select id="active-page-size"
                class="form-select form-select-sm"
                style="width: 90px"
                value="@PageSize"
                @onchange="ChangePageSize"
                disabled="@IsLoading">
            <option value="20">20</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
        <nav aria-label="Active patients pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
                    <button type="button" class="page-link" aria-label="Previous page"
                            disabled="@(IsLoading || CurrentPage <= 1)"
                            @onclick="PreviousPage">Previous</button>
                </li>
                @foreach (var pageNumber in GetPageNumbers())
                {
                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                        <button type="button" class="page-link"
                                aria-current="@(pageNumber == CurrentPage ? "page" : null)"
                                disabled="@(IsLoading || pageNumber == CurrentPage)"
                                @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                    </li>
                }
                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                    <button type="button" class="page-link" aria-label="Next page"
                            disabled="@(IsLoading || CurrentPage >= TotalPages)"
                            @onclick="NextPage">Next</button>
                </li>
            </ul>
        </nav>
    </div>
</div>
    }
</div>

@code {
    private List<PatientListItem> PatientList = [];
    private PagedResult<PatientListItem>? Result;
    private PatientListQuery Filter = new() { Status = "Archived" };
    private int CurrentPage = 1;
    private int PageSize = 20;
    private bool IsLoading;
    private string? ErrorMessage;
    private bool IsAdministrator;
    private List<UserDto> CareCoordinators = [];
    private string? CoordinatorLoadError;

    private int TotalPages => Result?.TotalCount > 0
        ? (int)Math.Ceiling(Result.TotalCount / (double)PageSize)
        : 0;

    private int StartItem => Result?.TotalCount > 0
        ? ((CurrentPage - 1) * PageSize) + 1
        : 0;

    private int EndItem => Math.Min(CurrentPage * PageSize, Result?.TotalCount ?? 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        IsAdministrator = authState.User.IsInRole("Administrator");
        if (IsAdministrator)
        {
            try
            {
                CareCoordinators = (await UserService.GetUsersAsync())
                    .Where(x => string.Equals(x.Role?.Trim(), "Care Coordinator", StringComparison.OrdinalIgnoreCase))
                    .OrderBy(x => x.FullName)
                    .ToList();
            }
            catch (Exception ex)
            {
                CoordinatorLoadError = $"Unable to load care coordinators: {ex.Message}";
            }
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Filter.Status = "Archived";
            Result = await PatientService.GetPatientsAsync(CurrentPage, PageSize, Filter);
            PatientList = Result.Items;
            // Keep the selected page valid if records were removed between requests.
            if (TotalPages > 0 && CurrentPage > TotalPages)
            {
                CurrentPage = TotalPages;
                Result = await PatientService.GetPatientsAsync(CurrentPage, PageSize, Filter);
                PatientList = Result.Items;
            }
        }
        catch (Exception ex)
        {
            PatientList = [];
            ErrorMessage = $"Unable to load archived patients: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFilter(PatientListQuery filter)
    {
        filter.Status = "Archived";
        Filter = filter;
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        if (IsLoading || page < 1 || page > TotalPages || page == CurrentPage)
            return;

        CurrentPage = page;
        await LoadAsync();
    }

    private Task PreviousPage() => GoToPage(CurrentPage - 1);

    private Task NextPage() => GoToPage(CurrentPage + 1);

    private async Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size) && size > 0 && size != PageSize)
        {
            PageSize = size;
            CurrentPage = 1;
            await LoadAsync();
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        if (TotalPages <= 0)
            return [];

        var first = Math.Max(1, CurrentPage - 2);
        var last = Math.Min(TotalPages, first + 4);
        first = Math.Max(1, last - 4);

        return Enumerable.Range(first, last - first + 1);
    }
}
