@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CCAP.Web.Features.Authentication.Services
@using CCAP.Web.Features.Authentication.State

@inject AuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-page">

    <div class="login-card">

        <!-- Logo -->
        <div class="login-logo-container">
            <img src="/images/logo.png"
                 alt="CCAP"
                 class="login-logo" />
        </div>

        <!-- Header -->
        <div class="login-header">
               <h2>CCAP Login</h2> 
            <p>Sign in to access the CCAP application.</p>
        </div>

        <!-- Error -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
            <div class="login-error">
                <i class="bi bi-exclamation-circle"></i>
                <span>@ErrorMessage</span>
            </div>
            }

        <!-- Email -->
        <div class="form-group">

            <label for="email">
                Email
            </label>

            <div class="input-wrapper">

                <i class="bi bi-person input-icon"></i>

                <input id="email"
                       class="login-input"
                       @bind="Email"
                       @bind:event="oninput"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="username" />

            </div>

        </div>

        <!-- Password -->
        <div class="form-group">

            <label for="password">
                Password
            </label>

            <div class="input-wrapper">

                <i class="bi bi-lock input-icon"></i>

                <input id="password"
                       class="login-input"
                       @bind="Password"
                       @bind:event="oninput"
                       type="password"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <i class="bi bi-eye password-icon"></i>

            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input class="form-control" @bind="Password" @bind:event="oninput" type="password" autocomplete="current-password" />
            </div>

        <!-- Login Button -->
        <button class="login-button"
                    @onclick="LoginAsync"
                    disabled="@IsLoading">

                @(IsLoading ? "Signing in..." : "Sign In")

            </button>

        <!-- Divider -->
        <div class="login-divider">
            <span>USE</span>
        </div>

        <!-- Development Account -->
        <div class="development-account">

            <div class="development-icon">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="development-info">

                <span class="development-label">
                    Development account:
                </span>

                <strong>
                    admin@ccap.local / Admin123!
                </strong>

            </div>

        </div>

    </div>

</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string Email = string.Empty;
    private string Password = string.Empty;
    private string? ErrorMessage;
    private bool IsLoading;

    private async Task LoginAsync()
    {
        ErrorMessage = null;
        IsLoading = true;

        try
        {
            var result = await AuthenticationService.LoginAsync(Email, Password);

            if (!result.Success)
            {
                ErrorMessage = result.Message;
                return;
            }

            if (AuthenticationStateProvider is CcapAuthenticationStateProvider provider)
            {
                await provider.NotifyLoginAsync();
            }

            var target =
                string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/')
                ? "/dashboard"
                : ReturnUrl;

            Navigation.NavigateTo(target);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to connect to CCAP API: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
