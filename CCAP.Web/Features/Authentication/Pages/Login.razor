@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout

@using CCAP.Web.Features.Authentication.Models
@using CCAP.Web.Features.Authentication.Services
@using CCAP.Web.Features.Authentication.State
@using CCAP.Web.Features.MockData
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject MockDataOptions MockOptions
@inject AuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject SessionExpirationService SessionExpirationService

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-card">

        <div class="login-logo-container">
            <img src="/images/logo.png"
                 alt="CCAP"
                 class="login-logo" />
        </div>

        <div class="login-header">
            <h2>CCAP Login</h2>
            <p>Sign in to access the CCAP application.</p>
        </div>

        @if (MockOptions.Enabled)
        {
            <div class="login-info">
                <i class="bi bi-info-circle"></i>
                <span>
                    Mock mode is enabled.
                    API authentication is temporarily disconnected.
                </span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="login-error" role="alert" aria-live="polite">
                <i class="bi bi-exclamation-circle"></i>
                <span>@ErrorMessage</span>
            </div>
        }

        <EditForm Model="LoginModel"
                  class="login-form"
                  OnValidSubmit="LoginAsync"
                  OnInvalidSubmit="HandleInvalidSubmit"
                  FormName="ccap-login">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">Email</label>

                <div class="input-wrapper">
                    <i class="bi bi-person input-icon"></i>

                    <InputText id="email"
                               class="login-input"
                               @bind-Value="LoginModel.Email"
                               type="email"
                               placeholder="Enter your email"
                               autocomplete="username" />
                </div>

                <ValidationMessage For="@(() => LoginModel.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <div class="input-wrapper">
                    <i class="bi bi-lock input-icon"></i>

                    <InputText id="password"
                               class="login-input password-input"
                               @bind-Value="LoginModel.Password"
                               type="@PasswordInputType"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                    <button type="button"
                            class="password-toggle"
                            @onclick="TogglePasswordVisibility"
                            aria-label="@PasswordToggleLabel"
                            title="@PasswordToggleLabel">
                        <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>

                <ValidationMessage For="@(() => LoginModel.Password)" />
            </div>

            <button type="submit"
                    class="login-button"
                    disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span>
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        Signing in...
                    </span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        @if (MockOptions.Enabled)
        {
            <div class="login-divider">
                <span>USE</span>
            </div>

            <div class="development-account">
                <div class="development-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="development-info">
                    <span class="development-label">
                        Development account:
                    </span>

                    <strong>
                        admin@ccap.local / Admin123!
                    </strong>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private LoginFormModel LoginModel { get; } = new();
    private string? ErrorMessage;
    private bool IsLoading;
    private bool ShowPassword;

    private string PasswordInputType => ShowPassword ? "text" : "password";
    private string PasswordToggleLabel => ShowPassword ? "Hide password" : "Show password";

    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }

    private void HandleInvalidSubmit(EditContext _)
    {
        // Do not leave a previous authentication/network error visible
        // when the current issue is local form validation.
        ErrorMessage = null;
    }

    private async Task LoginAsync()
    {
        if (IsLoading)
            return;

        ErrorMessage = null;
        IsLoading = true;

        try
        {
            var result = await AuthenticationService.LoginAsync(
                LoginModel.Email.Trim(),
                LoginModel.Password);

            if (!result.Success)
            {
                ErrorMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? "Unable to sign in. Please check your credentials and try again."
                    : result.Message;

                return;
            }

            if (AuthenticationStateProvider is CcapAuthenticationStateProvider provider)
            {
                await provider.NotifyLoginAsync();
            }

            SessionExpirationService.Reset();

            var target =
                string.IsNullOrWhiteSpace(ReturnUrl) ||
                !ReturnUrl.StartsWith('/') ||
                ReturnUrl.StartsWith("//")
                    ? "/dashboard"
                    : ReturnUrl;

            Navigation.NavigateTo(target);
        }
        catch
        {
            // AuthenticationService already converts expected API/network failures
            // to a safe user-facing result. This is only a final UI safety net.
            ErrorMessage = "Something went wrong while signing in. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
