@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CCAP.Web.Features.Authentication.Services
@using CCAP.Web.Features.Authentication.State
@using CCAP.Web.Features.MockData

@inject MockDataOptions MockOptions
@inject AuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-page">

    <div class="login-card">

        <!-- Logo -->
        <div class="login-logo-container">
            <img src="/images/logo.png"
                 alt="CCAP"
                 class="login-logo" />
        </div>

        <!-- Header -->
        <div class="login-header">
            <h2>CCAP Login</h2>
            <p>Sign in to access the CCAP application.</p>
        </div>

        <!-- Mock Mode -->
        @if (MockOptions.Enabled)
        {
            <div class="login-info">
                <i class="bi bi-info-circle"></i>

                <span>
                    Mock mode is enabled.
                    API authentication is temporarily disconnected.
                </span>
            </div>
        }

        <!-- Error -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="login-error">

                <i class="bi bi-exclamation-circle"></i>

                <span>
                    @ErrorMessage
                </span>

            </div>
        }

        <!-- Email -->
        <div class="form-group">

            <label for="email">
                Email
            </label>

            <div class="input-wrapper">

                <i class="bi bi-person input-icon"></i>

                <input id="email"
                       class="login-input"
                       @bind="Email"
                       @bind:event="oninput"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="username" />

            </div>

        </div>

        <!-- Password -->
        <div class="form-group">

            <label for="password">
                Password
            </label>

            <div class="input-wrapper">

                <i class="bi bi-lock input-icon"></i>

                <input id="password"
                       class="login-input"
                       @bind="Password"
                       @bind:event="oninput"
                       type="password"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <i class="bi bi-eye password-icon"></i>

            </div>

        </div>

        <!-- Login Button -->
        <button class="login-button"
                @onclick="LoginAsync"
                disabled="@IsLoading">

            @if (IsLoading)
            {
                <span>
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Signing in...
                </span>
            }
            else
            {
                <span>
                    Sign In
                </span>
            }

        </button>

        <!-- Divider -->
        <div class="login-divider">
            <span>USE</span>
        </div>

        <!-- Development Account -->
        <div class="development-account">

            <div class="development-icon">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="development-info">

                <span class="development-label">
                    Development account:
                </span>

                <strong>
                    admin@ccap.local / Admin123!
                </strong>

            </div>

        </div>

    </div>

</div>

@code {

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string Email = string.Empty;

    private string Password = string.Empty;

    private string? ErrorMessage;

    private bool IsLoading;


    private async Task LoginAsync()
    {
        ErrorMessage = null;

        // ============================================
        // Basic validation
        // ============================================

        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Please enter your email.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "Please enter your password.";
            return;
        }

        IsLoading = true;

        try
        {
            // ============================================
            // AuthenticationService handles:
            //
            // Mock mode  -> Mock validation
            // API mode   -> CCAP API authentication
            // ============================================

            var result =
                await AuthenticationService.LoginAsync(
                    Email.Trim(),
                    Password);

            if (!result.Success)
            {
                ErrorMessage = result.Message;
                return;
            }

            // ============================================
            // Update Blazor authentication state
            // ============================================

            if (AuthenticationStateProvider
                is CcapAuthenticationStateProvider provider)
            {
                await provider.NotifyLoginAsync();
            }

            // ============================================
            // Redirect
            // ============================================

            var target =
                string.IsNullOrWhiteSpace(ReturnUrl) ||
                !ReturnUrl.StartsWith("/")
                    ? "/dashboard"
                    : ReturnUrl;

            Navigation.NavigateTo(target);
        }
        catch (Exception ex)
        {
            ErrorMessage = MockOptions.Enabled
                ? $"Unable to complete mock login: {ex.Message}"
                : $"Unable to connect to CCAP API: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}