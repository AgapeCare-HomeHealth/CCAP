            Route = "/clinical"
        },

        new()
        {
            Sequence = 4,
            StageCode = "ADMISSION",
            StageName = "Admission",
            Description = "Pending",
            Status = WorkflowStatus.Pending
        },

        new()
        {
            Sequence = 5,
            StageCode = "VISITS",
            StageName = "Visits",
            Description = "Pending",
            Status = WorkflowStatus.Pending
        },

        new()
        {
            Sequence = 6,
            StageCode = "RECERT",
            StageName = "Recertification",
            Description = "Pending",
            Status = WorkflowStatus.Pending
        },

        new()
        {
            Sequence = 7,
