        Status = "Active",

        Coordinator = "Jennifer LVN",

        Branch = "Main Office",

        EpisodeNumber = 1,

        SocDate = new DateOnly(2026, 8, 8)
    };

    private readonly List<WorkflowTabDto> Tabs =
[
