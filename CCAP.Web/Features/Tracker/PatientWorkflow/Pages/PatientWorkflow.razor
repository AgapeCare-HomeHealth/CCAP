@* @page "/tracker/patient/{id:int}" *@
@page "/tracker/patient"
@using CCAP.Web.Features.Tracker.PatientWorkflow.Components
@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<PageTitle>Patient Workflow</PageTitle>

<div class="patient-workflow-page">

    <!-- ================= Header ================= -->

    <PatientHeader Patient="@Header" />

    <!-- ================= Workflow ================= -->

    <section class="mt-4">
        <WorkflowTabs Tabs="@Tabs"
                      OnTabChanged="OnTabChanged" />
    </section>

    <section class="mt-4">

        <WorkflowProgress Stages="@WorkflowStages" />

    </section>

    <!-- ================= Dashboard ================= -->

    <section class="mt-4">

        <div class="row g-4">

            <div class="col-xl-4 col-lg-6">

                <NextActionCard />

            </div>

            <div class="col-xl-4 col-lg-6">

                <KeyInformationCard />

            </div>

            <div class="col-xl-4 col-lg-12">

                <RecentActivityCard />

            </div>

        </div>

    </section>

    <!-- ================= Summary ================= -->

    <section class="mt-4">

        <PatientSummaryBar />

    </section>

    <!-- ================= Dynamic Content ================= -->

<section class="mt-4">

    @switch (SelectedTab)
    {
        case "Overview":

                <OverviewTab OnChangeTab="OnTabChanged" />

            break;

        case "Insurance":

            <InsuranceTab />

            break;

        case "Clinical":

            <ClinicalTab />

            break;

        case "Compliance":

            <ComplianceTab />

            break;

        case "Documents":

            <DocumentsTab />

            break;

        case "Communication":

            <CommunicationTab />

            break;

        case "Timeline":

            <TimelineTab />

            break;

        case "Audit Log":

            <AuditLogTab />

            break;
    }

</section>

</div>

@code {

    private string SelectedTab = "Overview";

    private void OnTabChanged(string tabTitle)
    {
        SelectedTab = tabTitle;

        foreach (var tab in Tabs)
        {
            tab.Active = tab.Title == tabTitle;
        }
    }

    private readonly List<WorkflowStageDto> WorkflowStages =
    [
        new()
        {
            Sequence = 1,
            StageCode = "REFERRAL",
            StageName = "Referral",
            Description = "Completed",
            Status = WorkflowStatus.Completed,
            CompletedDate = DateTime.Today.AddDays(-4),
            IsClickable = true,
            Route = "/overview"
        },

        new()
        {
            Sequence = 2,
