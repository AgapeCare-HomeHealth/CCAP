@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@inject NavigationManager Navigation

<div class="patient-header-wrapper">

    <!-- Back -->
    <button class="back-button"
            @onclick="GoBack">

        <i class="bi bi-arrow-left"></i>

        Back to Active Patients

    </button>

    <!-- Header -->
    <div class="card shadow-sm border-0 patient-header-card">

        <div class="card-body">

            <div class="row align-items-center g-4">

                <!-- Avatar -->
                @* <div class="col-auto">

                    <div class="patient-avatar">

                        @Patient.Initials

                    </div>

                </div> *@

                <!-- Patient Information -->
                <div class="col">

                    <h2 class="patient-name">

                        @Patient.FullName

                    </h2>

                    <div class="patient-meta">

                        <span>

                            <i class="bi bi-person"></i>

                            @Patient.Age Years Old

                        </span>

                        <span>

                            <i class="bi bi-credit-card"></i>

                            MRN: @Patient.MRN

                        </span>

                        @* <span>

                            <i class="bi bi-building"></i>

                            @Patient.Branch

                        </span> *@

                    </div>

                </div>

                <!-- Status -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Status</label>

                        <span class="badge @StatusBadgeClass">

                            @Patient.Status

                        </span>

                    </div>

                </div>

                <!-- Referral -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Referral #</label>

                        <strong>

                            @Patient.ReferralNumber

                        </strong>

                    </div>

                </div>

                <!-- SOC -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>SOC Date</label>

                        <strong>

                            @(Patient.SocDate?.ToString("MM/dd/yyyy") ?? "-")

                        </strong>

                    </div>

                </div>

                <!-- Coordinator -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Coordinator</label>

                        <strong>

                            @Patient.Coordinator

                        </strong>

                    </div>

                </div>

                <!-- Episode -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Episode</label>

                        <strong>

                            @Patient.EpisodeNumber

                        </strong>

                    </div>

                </div>

                <!-- Edit -->
                <div class="col-auto ms-xl-auto">

                    <button type="button" class="btn btn-success" @onclick="OpenEdit">
                        <i class="bi bi-pencil-square"></i>
                        Edit Patient
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<PatientEditModal Visible="ShowEditModal"
                  Model="Editor"
                  Saving="Saving"
                  ErrorMessage="EditError"
                  OnSave="SaveEdit"
                  OnClose="CloseEdit" />

@code {

    [Parameter]
    public PatientHeaderDto Patient { get; set; } = new();

    [Parameter]
    public EventCallback<PatientEditModel> OnSave { get; set; }

    private string StatusBadgeClass =>
        Patient.Status switch
        {
            "Active" => "bg-success",
            "Pending" => "bg-warning text-dark",
            "On Hold" => "bg-secondary",
            "Discharged" => "bg-dark",
            _ => "bg-light text-dark"
        };

    private bool ShowEditModal;
    private bool Saving;
    private string? EditError;
    private PatientEditModel Editor = new();

    private void OpenEdit()
    {
        EditError = null;
        Editor = new PatientEditModel
        {
            PatientId = Patient.PatientId,
            FirstName = Patient.FirstName,
            MiddleName = Patient.MiddleName,
            LastName = Patient.LastName,
            MRN = Patient.MRN,
            Status = Patient.Status,
            SocDate = Patient.SocDate,
            Coordinator = Patient.Coordinator
        };
        ShowEditModal = true;
    }

    private void CloseEdit()
    {
        ShowEditModal = false;
        EditError = null;
    }

    private async Task SaveEdit()
    {
        Saving = true;
        EditError = null;
        try
        {
            await OnSave.InvokeAsync(Editor);
            ShowEditModal = false;
        }
        catch (Exception ex)
        {
            EditError = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/patients");
    }

    
}