@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@inject NavigationManager Navigation

<div class="patient-header-wrapper">

    <!-- Back -->
    <button class="back-button"
            @onclick="GoBack">

        <i class="bi bi-arrow-left"></i>

        Back to Active Patients

    </button>

    <!-- Header -->
    <div class="card shadow-sm border-0 patient-header-card">

        <div class="card-body">

            <div class="row align-items-center g-4">

                <!-- Avatar -->
                @* <div class="col-auto">

                    <div class="patient-avatar">

                        @Patient.Initials

                    </div>

                </div> *@

                <!-- Patient Information -->
                <div class="col">

                    <h2 class="patient-name">

                        @Patient.FullName

                    </h2>

                    <div class="patient-meta">

                        <span>

                            <i class="bi bi-person"></i>

                            @Patient.Age Years Old

                        </span>

                        <span>

                            <i class="bi bi-credit-card"></i>

                            MRN: @Patient.MRN

                        </span>

                        @* <span>

                            <i class="bi bi-building"></i>

                            @Patient.Branch

                        </span> *@

                    </div>

                </div>

                <!-- Status -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Status</label>

                        <span class="badge @StatusBadgeClass">

                            @Patient.Status

                        </span>

                    </div>

                </div>

                <!-- Referral -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Referral #</label>

                        <strong>

                            @Patient.ReferralNumber

                        </strong>

                    </div>

                </div>

                <!-- SOC -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>SOC Date</label>

                        <strong>

                            @(Patient.SocDate?.ToString("MM/dd/yyyy") ?? "-")

                        </strong>

                    </div>

                </div>

                <!-- Coordinator -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Coordinator</label>

                        <strong>

                            @Patient.Coordinator

                        </strong>

                    </div>

                </div>

                <!-- Episode -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Episode</label>

                        <strong>

                            @Patient.EpisodeNumber

                        </strong>

                    </div>

                </div>

                <!-- Edit -->
                <div class="col-auto ms-xl-auto">

                    <button class="btn btn-success">

                        <i class="bi bi-pencil-square"></i>

                        Edit Patient

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public PatientHeaderDto Patient { get; set; } = new();

    private string StatusBadgeClass =>
        Patient.Status switch
        {
            "Active" => "bg-success",
            "Pending" => "bg-warning text-dark",
            "On Hold" => "bg-secondary",
            "Discharged" => "bg-dark",
            _ => "bg-light text-dark"
        };

    private void GoBack()
    {
        Navigation.NavigateTo("/patients");
    }

    
}