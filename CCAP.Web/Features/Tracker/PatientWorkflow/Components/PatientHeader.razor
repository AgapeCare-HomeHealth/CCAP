@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Admin.Users.Models
@using CCAP.Web.Features.Admin.Users.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject UserServices UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="patient-header-wrapper">

    <!-- Back -->
    <button class="back-button"
            @onclick="GoBack">

        <i class="bi bi-arrow-left"></i>

        Back to Active Patients

    </button>

    <!-- Header -->
    <div class="card shadow-sm border-0 patient-header-card">

        <div class="card-body">

            <div class="row align-items-center g-4">

                <!-- Avatar -->
                @* <div class="col-auto">

                    <div class="patient-avatar">

                        @Patient.Initials

                    </div>

                </div> *@

                <!-- Patient Information -->
                <div class="col">

                    <h2 class="patient-name">

                        @Patient.FullName

                    </h2>

                    <div class="patient-meta">

                        <span>

                            <i class="bi bi-person"></i>

                            @Patient.Age Years Old

                        </span>

                        <span>

                            <i class="bi bi-credit-card"></i>

                            MRN: @Patient.MRN

                        </span>

                        @* <span>

                            <i class="bi bi-building"></i>

                            @Patient.Branch

                        </span> *@

                    </div>

                </div>

                <!-- Status -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Status</label>

                        <span class="badge @StatusBadgeClass">

                            @Patient.Status

                        </span>

                    </div>

                </div>

                <!-- Referral -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Referral #</label>

                        <strong>

                            @Patient.ReferralNumber

                        </strong>

                    </div>

                </div>

                <!-- SOC -->
                <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>SOC Date</label>

                        <strong>

                            @(Patient.SocDate?.ToString("MM/dd/yyyy") ?? "-")

                        </strong>

                    </div>

                </div>

                <div class="col-xl-auto col-md-6">
                    <div class="info-block">
                        <label>Primary CC</label>
                        <strong>@Patient.Coordinator</strong>
                    </div>
                </div>
                <div class="col-xl-auto col-md-6">
                    <div class="info-block">
                        <label>Secondary CC</label>
                        <strong>@(string.IsNullOrWhiteSpace(Patient.SecondaryCoordinator) ? "Not assigned" : Patient.SecondaryCoordinator)</strong>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Patient.BackupCoordinator))
                {
                    <div class="col-xl-auto col-md-6">
                        <div class="info-block">
                            <label>Backup CC</label>
                            <strong>@Patient.BackupCoordinator</strong>
                        </div>
                    </div>
                }

                <!-- Episode -->
                @* <div class="col-xl-auto col-md-6">

                    <div class="info-block">

                        <label>Episode</label>

                        <strong>

                            @Patient.EpisodeNumber

                        </strong>

                    </div>

                </div> *@

                <!-- Edit -->
                <div class="col-auto ms-xl-auto">

                    <button type="button" class="btn btn-success" @onclick="OpenEdit">
                        <i class="bi bi-pencil-square"></i>
                        Edit Patient
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<PatientEditModal Visible="ShowEditModal"
                  Model="Editor"
                  Saving="Saving"
                  IsAdministrator="IsAdministrator"
                  Coordinators="Coordinators"
                  ErrorMessage="@EditError"
                  OnSave="SaveEdit"
                  OnClose="CloseEdit" />

@code {
    private static List<EmergencyContactEditModel> LoadEmergencyContacts(
        string? json,
        string? legacyName,
        string? legacyRelationship,
        string? legacyPhone)
    {
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                // The value is stored as JSON text inside the API response.
                // Use web defaults and case-insensitive matching so records
                // written with either PascalCase or camelCase property names load.
                var options = new System.Text.Json.JsonSerializerOptions(
                    System.Text.Json.JsonSerializerDefaults.Web)
                {
                    PropertyNameCaseInsensitive = true
                };

                var jsonToRead = json.Trim();

                // Be tolerant of older records where the JSON array was itself
                // serialized as a JSON string.
                if (jsonToRead.StartsWith("\""))
                {
                    var unwrapped = System.Text.Json.JsonSerializer.Deserialize<string>(jsonToRead);
                    if (!string.IsNullOrWhiteSpace(unwrapped))
                        jsonToRead = unwrapped;
                }

                var contacts = System.Text.Json.JsonSerializer.Deserialize<List<EmergencyContactEditModel>>(
                    jsonToRead, options);

                if (contacts is { Count: > 0 })
                {
                    return contacts.Where(c => c is not null).ToList();
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // Fall back to the legacy single-contact columns below.
            }
        }

        if (!string.IsNullOrWhiteSpace(legacyName)
            || !string.IsNullOrWhiteSpace(legacyRelationship)
            || !string.IsNullOrWhiteSpace(legacyPhone))
        {
            return new()
            {
                new EmergencyContactEditModel
                {
                    Name = legacyName ?? string.Empty,
                    Relationship = legacyRelationship ?? string.Empty,
                    Phone = legacyPhone ?? string.Empty
                }
            };
        }

        return new();
    }


    [Parameter]
    public PatientHeaderDto Patient { get; set; } = new();

    [Parameter]
    public EventCallback<PatientEditModel> OnSave { get; set; }

    private string StatusBadgeClass =>
        Patient.Status switch
        {
            "Active" => "bg-success",
            "Pending" => "bg-warning text-dark",
            "On Hold" => "bg-secondary",
            "Discharged" => "bg-dark",
            _ => "bg-light text-dark"
        };

    private bool ShowEditModal;
    private bool Saving;
    private string? EditError;
    private PatientEditModel Editor = new();
    private bool IsAdministrator;
    private List<UserDto> Coordinators = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        IsAdministrator = state.User.IsInRole("Administrator");
        if (IsAdministrator)
        {
            var users = await UserService.GetUsersAsync();
            Coordinators = users.Where(x => x.IsActive &&
                string.Equals(x.Role?.Trim(), "Care Coordinator", StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void OpenEdit()
    {
        EditError = null;
        Editor = new PatientEditModel
        {
            PatientId = Patient.PatientId,
            FirstName = Patient.FirstName,
            MiddleName = Patient.MiddleName,
            LastName = Patient.LastName,
            MRN = Patient.MRN,
            ReferralNumber = Patient.ReferralNumber,
            Status = Patient.Status,
            SocDate = Patient.SocDate,
            Coordinator = Patient.Coordinator,
            CoordinatorId = Patient.CoordinatorId,
            SecondaryCoordinatorId = Patient.SecondaryCoordinatorId,
            BackupCoordinatorId = Patient.BackupCoordinatorId,
            BackupCoordinator = Patient.BackupCoordinator,
            DateOfBirth = Patient.DateOfBirth,
            Gender = Patient.Gender,
            PrimaryPhone = Patient.PrimaryPhone,
            AlternatePhone = Patient.AlternatePhone,
            StreetAddress = Patient.StreetAddress,
            City = Patient.City,
            State = Patient.State,
            ZipCode = Patient.ZipCode,
            EmergencyContactName = Patient.EmergencyContactName,
            EmergencyContactRelationship = Patient.EmergencyContactRelationship,
            EmergencyContactPhone = Patient.EmergencyContactPhone,
            EmergencyContactsJson = Patient.EmergencyContactsJson,
            EmergencyContacts = LoadEmergencyContacts(Patient.EmergencyContactsJson, Patient.EmergencyContactName, Patient.EmergencyContactRelationship, Patient.EmergencyContactPhone),
            ReferralDate = Patient.ReferralDate,
            ReferralType = Patient.ReferralType,
            ReferralSource = Patient.ReferralSource,
            ReferralChannel = Patient.ReferralChannel,
            Priority = Patient.Priority,
            ReferringPhysician = Patient.ReferringPhysician,
            PhysicianPhone = Patient.PhysicianPhone,
            PhysicianFax = Patient.PhysicianFax,
            PhysicianNpi = Patient.PhysicianNpi,
            PcosRegistered = Patient.PcosRegistered,
            PrimaryDiagnosis = Patient.PrimaryDiagnosis,
            SecondaryDiagnosis = Patient.SecondaryDiagnosis,
            ReferralNotes = Patient.ReferralNotes,
            VisitPriority = Patient.VisitPriority,
            CaseStatus = Patient.CaseStatus,
            InternalNotes = Patient.InternalNotes
        };
        ShowEditModal = true;
    }

    private void CloseEdit()
    {
        ShowEditModal = false;
        EditError = null;
    }

    private async Task SaveEdit()
    {
        Saving = true;
        EditError = null;
        try
        {
            await OnSave.InvokeAsync(Editor);
            ShowEditModal = false;
        }
        catch (Exception ex)
        {
            EditError = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/patients");
    }

    
}