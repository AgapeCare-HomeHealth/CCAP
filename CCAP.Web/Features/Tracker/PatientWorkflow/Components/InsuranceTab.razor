@using CCAP.Web.Features.Tracker.PatientWorkflow.Model
@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services

@inject PatientWorkflowService WorkflowService

<div class="insurance-page">

    @if (Workflow is null)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-shield-exclamation fs-2 d-block mb-2"></i>

            <div>
                Insurance information is unavailable.
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <!-- ===================================================== -->
            <!-- Header                                                -->
            <!-- ===================================================== -->

            <div class="card-header bg-white
                d-flex justify-content-between
                align-items-center">

                <div>
                    <h5 class="mb-1">
                        Insurance Information
                    </h5>

                    <small class="text-muted">
                        Review and verify the patient's insurance coverage.
                    </small>
                </div>

                <div>
                    @if (IsVerified)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Verified
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Needs Verification
                        </span>
                    }
                </div>

            </div>


            <!-- ===================================================== -->
            <!-- Insurance Information                                 -->
            <!-- ===================================================== -->

            <div class="card-body">

                @if (!IsEditing)
                {
                    <!-- ================================================= -->
                    <!-- READ MODE                                         -->
                    <!-- ================================================= -->

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Primary Insurance
                            </div>

                            <div class="fw-semibold">
                                @Display(Workflow.Summary.Insurance)
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Insurance Member ID
                            </div>

                            <div class="fw-semibold">
                                @Display(Workflow.Summary.InsuranceMemberId)
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="small text-muted mb-1">
                                Authorization Date
                            </div>

                            <div class="fw-semibold">
                                @(Workflow.Summary.AuthorizationDate.HasValue
                                    ? Workflow.Summary.AuthorizationDate.Value
                                        .ToString("MM/dd/yyyy")
                                    : "Not provided")
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="small text-muted mb-1">
                                Approved Visits
                            </div>

                            <div class="fw-semibold">
                                @(Workflow.Summary.AuthorizedVisits?.ToString()
                                    ?? "Not provided")
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="small text-muted mb-1">
                                Authorization Required
                            </div>

                            <div class="fw-semibold">
                                @(Workflow.Summary.AuthorizationRequired
                                    ? "Yes"
                                    : "No")
                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- Actions                                            -->
                    <!-- ================================================= -->

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="BeginEdit"
                                disabled="@IsProcessing">

                            <i class="bi bi-pencil me-1"></i>

                            Edit Information

                        </button>


                        @if (!IsVerified)
                        {
                            <button type="button"
                                    class="btn btn-success"
                                    @onclick="VerifyInsurance"
                                    disabled="@IsProcessing">

                                @if (IsProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"
                                          role="status"></span>

                                    <span>
                                        Verifying...
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-shield-check me-1"></i>

                                    <span>
                                        Verify Insurance
                                    </span>
                                }

                            </button>
                        }

                    </div>


                    <!-- ================================================= -->
                    <!-- Verification Information                          -->
                    <!-- ================================================= -->
                    @if (IsVerified)
                    {
                        <div class="border-top mt-4 pt-4">

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <div class="small text-muted mb-1">
                                        Verified On
                                    </div>

                                    <div class="fw-semibold">
                                        @DisplayVerifiedDate(
                                            Workflow.Summary.InsuranceVerifiedAt)
                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="small text-muted mb-1">
                                        Verified By
                                    </div>

                                    <div class="fw-semibold">
                                        @Display(
                                            Workflow.Summary.InsuranceVerifiedBy)
                                    </div>

                                </div>

                            </div>


                            <div class="alert alert-success mt-4 mb-0">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-shield-check me-2 mt-1"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Insurance has been verified.
                                        </div>

                                        <div class="small">
                                            The insurance information was reviewed
                                            and confirmed.
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                }
                else
                {
                    <!-- ================================================= -->
                    <!-- EDIT MODE                                         -->
                    <!-- ================================================= -->

                    <EditForm Model="@EditModel"
                              OnValidSubmit="SaveInsurance">

                        <DataAnnotationsValidator />

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Primary Insurance
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="EditModel.PrimaryInsurance" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Insurance Member ID
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="EditModel.InsuranceMemberId" />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Authorization Date
                                </label>

                                <InputDate class="form-control"
                                           @bind-Value="EditModel.AuthorizationDate" />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Approved Visits
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="EditModel.ApprovedVisits" />

                            </div>


                            <div class="col-md-4">

                                <div class="form-check mt-4">

                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="EditModel.AuthorizationRequired" />

                                    <label class="form-check-label">
                                        Authorization Required
                                    </label>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- Edit Actions                                      -->
                        <!-- ================================================= -->

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="CancelEdit"
                                    disabled="@IsProcessing">

                                Cancel

                            </button>


                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@IsProcessing">

                                @if (IsProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"
                                          role="status"></span>

                                    <span>
                                        Saving...
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>

                                    <span>
                                        Save Changes
                                    </span>
                                }

                            </button>

                        </div>

                    </EditForm>
                }

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public Guid PatientId { get; set; }


    [Parameter]
    public PatientWorkflowDto? Workflow { get; set; }


    [Parameter]
    public EventCallback OnCompleted { get; set; }


    private bool IsEditing { get; set; }

    private bool IsProcessing { get; set; }


    private InsuranceEditModel EditModel { get; set; } = new();


    private bool IsVerified =>
        Workflow?.Summary.InsuranceVerified == true;


    private void BeginEdit()
    {
        if (Workflow is null)
            return;

        EditModel = new InsuranceEditModel
        {
            PrimaryInsurance =
                Workflow.Summary.Insurance,

            InsuranceMemberId =
                Workflow.Summary.InsuranceMemberId,

            AuthorizationDate =
                Workflow.Summary.AuthorizationDate,

            ApprovedVisits =
                Workflow.Summary.AuthorizedVisits,

            AuthorizationRequired =
                Workflow.Summary.AuthorizationRequired
        };

        IsEditing = true;
    }


    private void CancelEdit()
    {
        IsEditing = false;

        EditModel = new InsuranceEditModel();
    }


    private async Task SaveInsurance()
    {
        if (Workflow is null || IsProcessing)
            return;

        IsProcessing = true;

        try
        {
            await WorkflowService.UpdateInsuranceAsync(
                PatientId,
                EditModel);

            IsEditing = false;

            EditModel = new InsuranceEditModel();

            await ReloadWorkflow();
        }
        finally
        {
            IsProcessing = false;
        }
    }


    private async Task VerifyInsurance()
    {
        if (Workflow is null || IsProcessing)
            return;

        IsProcessing = true;

        try
        {
            await WorkflowService.CompleteInsuranceVerificationAsync(
                PatientId);

            await ReloadWorkflow();

            if (OnCompleted.HasDelegate)
            {
                await OnCompleted.InvokeAsync();
            }
        }
        finally
        {
            IsProcessing = false;
        }
    }


    private async Task ReloadWorkflow()
    {
        var updatedWorkflow =
            await WorkflowService.GetAsync(PatientId);

        if (updatedWorkflow is not null)
        {
            Workflow = updatedWorkflow;
        }
    }


    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value;
    }


    private static string DisplayVerifiedDate(
        DateTime? value)
    {
        return value.HasValue
            ? value.Value
                .ToLocalTime()
                .ToString("MM/dd/yyyy h:mm tt")
            : "Not available";
    }

}