@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-1">@Title</h5>
        <small class="text-muted">@Description</small>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var item in Items)
            {
                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="fw-semibold">@item.RequirementName</div>
                                <div class="small text-muted">@item.Description</div>
                            </div>

                            @if (item.IsCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => OnComplete.InvokeAsync(item.RequirementCode)"
                                        disabled="@IsSaving">
                                    @(IsSaving && SavingCode == item.RequirementCode ? "Saving..." : "Mark Complete")
                                </button>
                            }
                        </div>

                        @if (item.IsCompleted && item.CompletedAt.HasValue)
                        {
                            <div class="small text-muted mt-2">
                                Confirmed @item.CompletedAt.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                                @if (!string.IsNullOrWhiteSpace(item.CompletedByUserName))
                                {
                                    <span>by @item.CompletedByUserName</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public IEnumerable<ComplianceItemDto> Items { get; set; } = [];
    [Parameter] public EventCallback<string> OnComplete { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? SavingCode { get; set; }
}
