@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services
@using CCAP.Web.Features.Admin.LookupOptions.Models
@using CCAP.Web.Features.Admin.LookupOptions.Services
@inject PatientWorkflowService WorkflowService
@inject LookupOptionService LookupService
@inject NavigationManager Navigation

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-1">Final Outcome</h5>
        <small class="text-muted">Close the patient episode by recording Discharge or Permanent Transfer. TIF/ROC does not close the episode.</small>
    </div>

    <div class="card-body">
        @if (Workflow is null)
        {
            <div class="text-muted">Workflow unavailable.</div>
        }
        else if (JourneyCompleted)
        {
            <div class="card border-success shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="display-5 text-success mb-3">✓</div>
                    <h4 class="text-success">Patient Journey Closed</h4>
                    <p class="text-muted mb-1">The final outcome has been completed.</p>
                    <p class="text-muted">The episode outcome has been recorded. Any outstanding discharge compliance items can still be completed in the Compliance tab.</p>
                    @if (!DischargeStageComplete)
                    {
                        <div class="alert alert-warning mt-3">Discharge compliance is still outstanding. Complete the Discharge group in the Compliance tab before archiving this patient.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3">@ErrorMessage</div>
                    }
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        @if (JourneyArchived)
                        {
                            <span class="badge text-bg-secondary align-self-center px-3 py-2">Archived</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success" @onclick="ArchiveJourneyAsync" disabled="@(IsSaving || !DischargeStageComplete)">
                                @(IsSaving ? "Archiving..." : "Archive Patient Journey")
                            </button>
                        }
                        <button type="button" class="btn btn-outline-primary" @onclick="GoToPatients">Back to Active Patients</button>
                    </div>
                    @if (JourneyArchived)
                    {
                        <div class="alert alert-success mt-4 mb-0">Patient journey is closed and discharged. The patient no longer belongs in the active patient list.</div>
                    }
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }

            @if (!CanCloseEpisode)
            {
                <div class="alert alert-warning">Complete Admission, SOC, On-Going Care, and Recert or Discharge requirements before recording the final outcome.</div>
            }

            <div class="card border mb-3">
                <div class="card-header bg-light"><strong>Episode Outcome</strong></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Outcome</label>
                            <select class="form-select" @bind="FinalStatus">
                                @foreach (var option in FinalStatusOptions)
                                {
                                    <option value="@option.Code">@option.DisplayName</option>
                                }
                            </select>
                        </div>
                        @if (IsTransfer)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Transfer Date</label>
                                <InputDate class="form-control" @bind-Value="OutcomeDate" />
                            </div>
                        }
                        @if (IsTransfer)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Transfer Destination</label>
                                <InputText class="form-control" @bind-Value="TransferDestination" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Transfer Reason</label>
                                <InputText class="form-control" @bind-Value="TransferReason" />
                            </div>
                        }

                    </div>
                </div>
            </div>


            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-danger" @onclick="CompleteCareAsync" disabled="@(IsSaving || !CanCloseEpisode || !CanSubmitOutcome)">
                    @(IsSaving ? "Saving..." : (IsTransfer ? "Complete Transfer" : "Complete Discharge"))
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public PatientWorkflowDto? Workflow { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private string FinalStatus = "Discharged";
    private DateOnly? OutcomeDate = DateOnly.FromDateTime(DateTime.Today);
    private string TransferDestination = "";
    private string TransferReason = "";
    private bool IsSaving;
    private string? ErrorMessage;
    private string? SavingRequirementCode;
    private List<LookupOptionDto> FinalStatusOptions = [];

    private bool IsTransfer => string.Equals(FinalStatus, "Transferred", StringComparison.OrdinalIgnoreCase);
    private bool JourneyCompleted => string.Equals(Workflow?.Header.Status, "Completed", StringComparison.OrdinalIgnoreCase) || JourneyArchived;
    private bool JourneyArchived => string.Equals(Workflow?.Header.Status, "Archived", StringComparison.OrdinalIgnoreCase);
    private bool DischargeStageComplete => Workflow?.WorkflowStages.FirstOrDefault(x =>
        string.Equals(x.StageCode, "DISCHARGE", StringComparison.OrdinalIgnoreCase))?.Status == WorkflowStatus.Completed;
    // The episode outcome is available after the Recert or Discharge group.
    // Discharge documents remain independently completable after the episode closes.
    private bool CanCloseEpisode => Workflow?.WorkflowStages.FirstOrDefault(x =>
        string.Equals(x.StageCode, "RECERT_OR_DISCHARGE", StringComparison.OrdinalIgnoreCase))?.Status == WorkflowStatus.Completed;
    private bool CanSubmitOutcome => IsTransfer
        ? OutcomeDate.HasValue && !string.IsNullOrWhiteSpace(TransferDestination)
        : Workflow?.WorkflowDetails.DischargeDate.HasValue == true;

    protected override async Task OnInitializedAsync()
    {
        try { FinalStatusOptions = await LookupService.GetAsync("FinalDischargeStatus", true); }
        catch { FinalStatusOptions = []; }
        if (FinalStatusOptions.Count == 0)
            FinalStatusOptions = [new LookupOptionDto { Code = "Discharged", DisplayName = "Discharged" }, new LookupOptionDto { Code = "Transferred", DisplayName = "Transferred" }];
    }

    private async Task CompleteComplianceAsync(string code)
    {
        if (Workflow is null || IsSaving) return;
        IsSaving = true; SavingRequirementCode = code; ErrorMessage = null;
        try { await WorkflowService.CompleteComplianceAsync(Workflow.Header.PatientId, code); await OnCompleted.InvokeAsync(); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; SavingRequirementCode = null; }
    }

    private async Task CompleteCareAsync()
    {
        if (Workflow is null || IsSaving || !CanSubmitOutcome) return;
        IsSaving = true; ErrorMessage = null;
        try
        {
            await WorkflowService.CompleteCareAsync(Workflow.Header.PatientId, FinalStatus, IsTransfer ? TransferDestination : null, IsTransfer ? OutcomeDate : Workflow.WorkflowDetails.DischargeDate, IsTransfer ? TransferReason : null, IsTransfer ? null : Workflow.WorkflowDetails.DischargeFeedback);
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private async Task ArchiveJourneyAsync()
    {
        if (Workflow is null || IsSaving || !JourneyCompleted || !DischargeStageComplete || JourneyArchived) return;
        IsSaving = true; ErrorMessage = null;
        try
        {
            await WorkflowService.ArchivePatientAsync(Workflow.Header.PatientId);
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private void GoToPatients() => Navigation.NavigateTo("/patients");
}
