<div class="documents-page">

    <!-- ================= Summary ================= -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3">

            <div class="status-card primary">

                <h6>Total Documents</h6>

                <h2>18</h2>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="status-card success">

                <h6>OCR Processed</h6>

                <h2>12</h2>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="status-card warning">

                <h6>Pending Review</h6>

                <h2>3</h2>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="status-card danger">

                <h6>Missing</h6>

                <h2>2</h2>

            </div>

        </div>

    </div>

    <!-- ================= Toolbar ================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-lg-4">

                    <label class="form-label">

                        Search

                    </label>

                    <input class="form-control" value="@SearchText" @oninput="SearchChanged" placeholder="Search documents..." />

                </div>

                <div class="col-lg-3">

                    <label class="form-label">

                        Category

                    </label>

                    <select class="form-select" @bind="CategoryFilter">
                        <option value="">All</option><option>Referral</option><option>Insurance</option><option>Orders</option><option>Plan of Care</option><option>OASIS</option><option>Lab</option><option>Consent</option>
                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label">

                        Status

                    </label>

                    <select class="form-select" @bind="StatusFilter">
                        <option value="">All</option><option value="Reviewed">Reviewed</option><option value="Pending Review">Pending Review</option><option value="Missing Signature">Missing Signature</option>
                    </select>

                </div>

                <div class="col-lg-2 d-grid">

                    <button type="button" class="btn btn-success" @onclick="OpenUpload">
                        <i class="bi bi-upload me-2"></i>
                        Upload
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= Documents ================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Patient Documents

            </h5>

        </div>

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th>Document</th>
                        <th>Category</th>
                        <th>Version</th>
                        <th>Status</th>
                        <th>OCR</th>
                        <th>Uploaded By</th>
                        <th>Date</th>
                        <th width="220">Actions</th>

                    </tr>

                </thead>

                <tbody>
                @foreach (var doc in PagedDocuments)
                {
                    <tr>
                        <td><i class="bi bi-file-earmark-pdf text-danger me-2"></i>@doc.Name</td>
                        <td>@doc.Category</td><td>@doc.Version</td>
                        <td><span class="badge @doc.StatusClass">@doc.Status</span></td>
                        <td><span class="badge @doc.OcrClass">@doc.Ocr</span></td>
                        <td>@doc.UploadedBy</td><td>@doc.Date</td>
                        <td><button type="button" class="btn btn-sm btn-outline-primary" @onclick='() => ViewDocument(doc.Name)'>View</button> @if(doc.Replaceable){<button type="button" class="btn btn-sm btn-outline-success" @onclick='() => OpenReplace(doc.Name)'>Replace</button>}</td>
                    </tr>
                }
                @if (!FilteredDocuments.Any()) { <tr><td colspan="8" class="text-center text-muted py-5">No documents match the current filter.</td></tr> }
                </tbody>

            </table>

        </div>
        <TablePager CurrentPage="@CurrentPage" PageSize="@PageSize" TotalItems="@FilteredDocuments.Count" OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />

    </div>

</div>
@if (ShowUploadModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45);" @onclick="CloseUpload">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(ReplaceDocumentName is null ? "Upload Document" : "Replace Document")</h5>
                    <button type="button" class="btn-close" @onclick="CloseUpload"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(ReplaceDocumentName))
                    {
                        <div class="alert alert-info">Replacing: <strong>@ReplaceDocumentName</strong></div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Document</label>
                        <InputFile OnChange="OnFileSelected" class="form-control" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(SelectedFileName))
                    {
                        <div class="small text-muted">Selected: @SelectedFileName</div>
                    }
                    <div class="mt-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" @bind="UploadCategory">
                            <option>Referral</option>
                            <option>Insurance</option>
                            <option>Orders</option>
                            <option>Plan of Care</option>
                            <option>OASIS</option>
                            <option>Lab</option>
                            <option>Consent</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="CloseUpload">Cancel</button>
                    <button type="button" class="btn btn-success" disabled="@string.IsNullOrWhiteSpace(SelectedFileName)" @onclick="CompleteUpload">
                        @(ReplaceDocumentName is null ? "Upload" : "Replace")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ActionMessage))
{
    <div class="alert alert-info mt-3">@ActionMessage</div>
}

@code {
    private bool ShowUploadModal;
    private string? ReplaceDocumentName;
    private string? SelectedFileName;
    private string UploadCategory = "Referral";
    private string? ActionMessage;
    private string SearchText = string.Empty;
    private string CategoryFilter = string.Empty;
    private string StatusFilter = string.Empty;
    private int CurrentPage = 1;
    private int PageSize = 20;
    private List<DocumentRow> Documents =
    [
        new("Referral.pdf", "Referral", "1.0", "Reviewed", "Complete", "Jennifer LVN", "08/04/2026", false),
        new("Insurance Card.pdf", "Insurance", "1.0", "Pending Review", "N/A", "Jennifer LVN", "08/05/2026", false),
        new("Plan of Care.pdf", "Orders", "2.0", "Missing Signature", "Complete", "Renald LVN", "08/06/2026", true)
    ];
    private List<DocumentRow> FilteredDocuments => Documents.Where(x => (string.IsNullOrWhiteSpace(SearchText) || x.Name.Contains(SearchText,StringComparison.OrdinalIgnoreCase) || x.Category.Contains(SearchText,StringComparison.OrdinalIgnoreCase) || x.UploadedBy.Contains(SearchText,StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(CategoryFilter) || x.Category == CategoryFilter) && (string.IsNullOrWhiteSpace(StatusFilter) || x.Status == StatusFilter)).ToList();
    private IEnumerable<DocumentRow> PagedDocuments => FilteredDocuments.Skip((CurrentPage-1)*PageSize).Take(PageSize);
    private void SearchChanged(ChangeEventArgs e){SearchText=e.Value?.ToString()??string.Empty;CurrentPage=1;}
    private void GoToPage(int page)=>CurrentPage=Math.Max(1,page);
    private void ChangePageSize(int size){PageSize=Math.Clamp(size,1,100);CurrentPage=1;}
    private sealed record DocumentRow(string Name,string Category,string Version,string Status,string Ocr,string UploadedBy,string Date,bool Replaceable)
    { public string StatusClass=>Status=="Reviewed"?"bg-success":Status=="Pending Review"?"bg-warning text-dark":"bg-danger"; public string OcrClass=>Ocr=="Complete"?"bg-success":"bg-secondary"; }

    private void OpenUpload()
    {
        ReplaceDocumentName = null;
        SelectedFileName = null;
        ActionMessage = null;
        ShowUploadModal = true;
    }

    private void OpenReplace(string name)
    {
        ReplaceDocumentName = name;
        SelectedFileName = null;
        ActionMessage = null;
        ShowUploadModal = true;
    }

    private void CloseUpload()
    {
        ShowUploadModal = false;
        SelectedFileName = null;
        ReplaceDocumentName = null;
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        SelectedFileName = args.File.Name;
    }

    private void CompleteUpload()
    {
        ActionMessage = ReplaceDocumentName is null
            ? $"Mock upload completed for {SelectedFileName}."
            : $"Mock replacement completed for {ReplaceDocumentName} using {SelectedFileName}.";
        CloseUpload();
    }

    private void ViewDocument(string name)
    {
        ActionMessage = $"Mock preview opened for {name}.";
    }

    private void DownloadDocument(string name)
    {
        ActionMessage = $"Mock download requested for {name}.";
    }
}
