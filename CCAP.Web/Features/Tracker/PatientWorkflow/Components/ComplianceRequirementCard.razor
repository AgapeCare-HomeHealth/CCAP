@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<div class="border rounded p-3 h-100 compliance-requirement-card">
    <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
            <div class="fw-semibold">@Item.RequirementName</div>
            @if (!string.IsNullOrWhiteSpace(Item.Description))
            {
                <div class="small text-muted mt-1">@Item.Description</div>
            }
        </div>

        @if (Item.IsCompleted)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success">Completed</span>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="() => OnUnmark.InvokeAsync(Item.RequirementCode)"
                        disabled="@IsUnmarking">
                    @(IsUnmarking ? "Unmarking..." : "Unmark Complete")
                </button>
            </div>
        }
        else
        {
            <button class="btn btn-sm btn-primary"
                    @onclick="() => OnComplete.InvokeAsync(Item.RequirementCode)"
                    disabled="@IsSaving">
                @(IsSaving ? "Saving..." : "Mark Complete")
            </button>
        }
    </div>

    @if (Item.IsCompleted && Item.CompletedAt.HasValue)
    {
        <div class="small text-muted border-top mt-3 pt-3">
            Completed @Item.CompletedAt.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
            @if (!string.IsNullOrWhiteSpace(Item.CompletedByUserName))
            {
                <span>by @Item.CompletedByUserName</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ComplianceItemDto Item { get; set; } = new();
    [Parameter] public EventCallback<string> OnComplete { get; set; }
    [Parameter] public EventCallback<string> OnUnmark { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool IsUnmarking { get; set; }
}
