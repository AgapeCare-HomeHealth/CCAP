@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">Patient Timeline</h5>
            <small class="text-muted">Complete patient history from referral through the current episode. This is separate from the administrative audit log.</small>
        </div>
        <span class="badge bg-light text-dark">@TimelineEvents.Count event(s)</span>
    </div>
    <div class="card-body">
        @if (TimelineEvents.Any())
        {
            <div class="timeline-list">
                @foreach (var item in TimelineEvents)
                {
                    <div class="timeline-item border-bottom pb-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="fw-semibold">@item.Title</div>
                                    <span class="badge bg-light text-dark">@item.EventType</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="text-muted mt-1">@item.Description</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.PerformedBy))
                                {
                                    <div class="small text-muted mt-2"><i class="bi bi-person me-1"></i>@item.PerformedBy</div>
                                }
                            </div>
                            <div class="text-end text-nowrap small text-muted">
                                @item.EventDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">No patient timeline events recorded.</div>
        }
    </div>
</div>

@code {
    [Parameter] public PatientWorkflowDto? Workflow { get; set; }

    private IReadOnlyList<PatientTimelineEventDto> TimelineEvents =>
        (Workflow?.TimelineEvents ?? [])
            .OrderByDescending(x => x.EventDate)
            .ToList();
}
