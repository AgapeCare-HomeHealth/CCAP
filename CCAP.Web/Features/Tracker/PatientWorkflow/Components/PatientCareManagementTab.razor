@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services
@inject PatientCareManagementService CareService

<div class="patient-care-management">
 @if(IsLoading){<div class="text-center py-5"><div class="spinner-border"></div></div>}
 else if(!string.IsNullOrWhiteSpace(ErrorMessage)){<div class="alert alert-danger">@ErrorMessage</div>}
 else if(Care is null){<div class="alert alert-warning">Patient care information is unavailable.</div>}
 else{
  <div class="row g-4">
   <div class="col-12"><div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between align-items-center"><div><h5 class="mb-0">Discipline Orders</h5><small class="text-muted">Orders maintained in CCAP for care coordination.</small></div><button class="btn btn-primary btn-sm" @onclick="ShowAddOrder"><i class="bi bi-plus-lg me-1"></i>Add Order</button></div>
    @if(ShowOrderForm){<div class="p-3 bg-light border-bottom"><div class="row g-2"><div class="col-md-4"><label class="form-label">Discipline *</label><select class="form-select" @bind="NewOrder.ServiceTypeId"><option value="">Select service</option>@foreach(var x in ServiceTypes){<option value="@x.ServiceTypeId">@x.Name (@x.Code)</option>}</select></div><div class="col-md-3"><label class="form-label">Frequency</label><input class="form-control" maxlength="100" @bind="NewOrder.Frequency" /></div></div><button class="btn btn-primary btn-sm mt-3" disabled="@SavingOrder" @onclick="SaveOrderAsync">@(SavingOrder?"Saving...":"Save Order")</button><button class="btn btn-outline-secondary btn-sm mt-3 ms-2" @onclick="HideAddOrder">Cancel</button></div>}
    <div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Discipline</th><th>Order Date</th><th>Frequency</th><th>Actions</th></tr></thead><tbody>@if(Care.ServiceOrders.Any()){@foreach(var o in Care.ServiceOrders){<tr><td><strong>@o.ServiceName</strong><div class="small text-muted">@o.ServiceCode</div></td><td>@o.OrderDate.ToLocalTime().ToString("MM/dd/yyyy")</td><td>@Display(o.Frequency)</td><td><button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditOrder(o)"><i class="bi bi-pencil me-1"></i>Edit</button><button class="btn btn-sm btn-outline-danger" disabled="@SavingOrder" @onclick="() => DeleteOrderAsync(o)"><i class="bi bi-trash me-1"></i>Delete</button></td></tr>}}else{<tr><td colspan="4" class="text-center text-muted py-4">No service orders.</td></tr>}</tbody></table></div>
   </div></div>
   <div class="col-xl-6"><CareLogTable Title="Supply" LogType="Wound Supply" Logs="@Care.CareLogs.Where(x => x.LogType == "Wound Supply").ToList()" OnAdd="@(type => ShowAddCareLog(type))" OnEdit="@(log => EditCareLog(log))" OnDelete="@(log => DeleteCareLogAsync(log))" Busy="@SavingCareLog" /></div>
   <div class="col-xl-6"><CareLogTable Title="Foley Catheter Changes" LogType="Foley" Logs="@Care.CareLogs.Where(x => x.LogType == "Foley").ToList()" OnAdd="@(type => ShowAddCareLog(type))" OnEdit="@(log => EditCareLog(log))" OnDelete="@(log => DeleteCareLogAsync(log))" Busy="@SavingCareLog" /></div>
  </div>
  @if (ShowCareLogForm)
{
    <div class="modal-backdrop fade show"></div><div class="modal d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">@(EditingCareLogId.HasValue ? "Edit" : "Add") @(NewCareLog.LogType == "Wound Supply" ? "Supply" : NewCareLog.LogType)</h5><button class="btn-close" @onclick="HideCareLog"></button></div><div class="modal-body">
            <div class="mb-3"><label class="form-label">Item / Description *</label><input class="form-control" maxlength="200" @bind="NewCareLog.Item" /></div>@if(NewCareLog.LogType == "Wound Supply"){
    <div class="mb-3"><label class="form-label">Status *</label><select class="form-select" @bind="NewCareLog.Status"><option value="">Select status</option><option value="FAX">FAX</option><option value="QA Approval">QA Approval</option><option value="Signed">Signed</option></select></div>
}
<div class="row g-2"><div class="col-6"><label class="form-label">Quantity</label><input class="form-control" type="number" min="0" step="1" @bind="NewCareLog.Quantity" /></div></div><div class="mt-3"><label class="form-label">Notes</label><textarea class="form-control" rows="4" maxlength="2000" @bind="NewCareLog.Notes"></textarea></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="HideCareLog">Cancel</button><button class="btn btn-primary" disabled="@SavingCareLog" @onclick="SaveCareLogAsync">@(SavingCareLog ? "Saving..." : "Save")</button></div></div></div></div>
  }
 }
</div>

@code{
 [Parameter] public Guid PatientId { get; set; }
 [Parameter] public EventCallback OnChanged { get; set; }
 private PatientCareProfileDto? Care; private bool IsLoading; private string? ErrorMessage;
 private List<ServiceTypeDto> ServiceTypes=[]; private bool ShowOrderForm,SavingOrder; private OrderFormModel NewOrder=new(); private Guid? EditingOrderId;
 private bool ShowCareLogForm,SavingCareLog; private Guid? EditingCareLogId; private CareLogFormModel NewCareLog=new();
 protected override async Task OnParametersSetAsync(){await LoadAsync();}
 private async Task LoadAsync(){IsLoading=true;ErrorMessage=null;try{Care=await CareService.GetAsync(PatientId);}catch(Exception ex){ErrorMessage=ex.Message;}finally{IsLoading=false;}}
 private async Task ShowAddOrder(){try{ServiceTypes=await CareService.GetServiceTypesAsync();NewOrder=new();EditingOrderId=null;ShowOrderForm=true;}catch(Exception ex){ErrorMessage=ex.Message;}}
 private void EditOrder(PatientServiceOrderDto order){EditingOrderId=order.PatientServiceOrderId;NewOrder=new(){ServiceTypeId=order.ServiceTypeId,Frequency=order.Frequency};ShowOrderForm=true;ErrorMessage=null;}
 private void HideAddOrder(){ShowOrderForm=false;EditingOrderId=null;}
 private async Task SaveOrderAsync(){if(NewOrder.ServiceTypeId==Guid.Empty){ErrorMessage="Select a discipline.";return;}SavingOrder=true;try{if(EditingOrderId.HasValue) await CareService.UpdateServiceOrderAsync(PatientId,EditingOrderId.Value,NewOrder.ServiceTypeId,NewOrder.Frequency); else await CareService.AddServiceOrderAsync(PatientId,NewOrder.ServiceTypeId,NewOrder.Frequency,null,false);await LoadAsync();ShowOrderForm=false;EditingOrderId=null;await OnChanged.InvokeAsync();}catch(Exception ex){ErrorMessage=ex.Message;}finally{SavingOrder=false;}}
 private async Task DeleteOrderAsync(PatientServiceOrderDto order){SavingOrder=true;ErrorMessage=null;try{await CareService.DeleteServiceOrderAsync(PatientId,order.PatientServiceOrderId);await LoadAsync();await OnChanged.InvokeAsync();}catch(Exception ex){ErrorMessage=ex.Message;}finally{SavingOrder=false;}}
 private void ShowAddCareLog(string type){ErrorMessage=null;EditingCareLogId=null;NewCareLog=new(){LogType=type,Status=""};ShowCareLogForm=true;}
 private void EditCareLog(PatientCareLogDto log){ErrorMessage=null;EditingCareLogId=log.PatientCareLogId;NewCareLog=new(){LogType=log.LogType,Item=log.Item,Quantity=log.Quantity,Unit=log.Unit,Notes=log.Notes,Status=log.Status};ShowCareLogForm=true;}
 private void HideCareLog(){ShowCareLogForm=false;EditingCareLogId=null;}
 private async Task DeleteCareLogAsync(PatientCareLogDto log){SavingCareLog=true;ErrorMessage=null;try{await CareService.DeleteCareLogAsync(PatientId,log.PatientCareLogId);await LoadAsync();await OnChanged.InvokeAsync();}catch(Exception ex){ErrorMessage=ex.Message;}finally{SavingCareLog=false;}}
 private async Task SaveCareLogAsync(){if(string.IsNullOrWhiteSpace(NewCareLog.Item)){ErrorMessage="Item / Description is required.";return;}SavingCareLog=true;try{if(NewCareLog.LogType == "Wound Supply" && string.IsNullOrWhiteSpace(NewCareLog.Status)){ErrorMessage="Select a supply status.";return;}if(EditingCareLogId.HasValue) await CareService.UpdateCareLogAsync(PatientId,EditingCareLogId.Value,NewCareLog.Item,NewCareLog.Quantity,NewCareLog.Unit,NewCareLog.Notes,NewCareLog.Status);else await CareService.AddCareLogAsync(PatientId,NewCareLog.LogType,NewCareLog.Item,NewCareLog.Quantity,NewCareLog.Unit,NewCareLog.Notes,NewCareLog.Status);await LoadAsync();ShowCareLogForm=false;EditingCareLogId=null;await OnChanged.InvokeAsync();}catch(Exception ex){ErrorMessage=ex.Message;}finally{SavingCareLog=false;}}
 private static string Display(string? x)=>string.IsNullOrWhiteSpace(x)?"-":x; private static string GetStatusClass(string? s)=>s?.ToLowerInvariant() switch{"completed"=>"bg-success","active"=>"bg-success","scheduled"=>"bg-primary","ordered"=>"bg-primary","pending"=>"bg-secondary","cancelled"=>"bg-danger",_=>"bg-secondary"};
 private sealed class OrderFormModel{public Guid ServiceTypeId{get;set;}public string? Frequency{get;set;}}
 private sealed class CareLogFormModel{public string LogType{get;set;}="";public string Item{get;set;}="";public decimal? Quantity{get;set;}public string? Unit{get;set;}public string? Notes{get;set;}public string? Status{get;set;}}
}
