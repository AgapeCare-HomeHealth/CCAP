@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services
@inject PatientCareManagementService CareService

<div class="patient-care-management">
 @if(IsLoading){<div class="text-center py-5"><div class="spinner-border"></div></div>}
 else if(!string.IsNullOrWhiteSpace(ErrorMessage)){<div class="alert alert-danger">@ErrorMessage</div>}
 else if(Care is null){<div class="alert alert-warning">Patient care information is unavailable.</div>}
 else{
  <div class="row g-4">
   <div class="col-12"><div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between align-items-center"><div><h5 class="mb-0">Service Orders</h5><small class="text-muted">Orders maintained in CCAP for care coordination.</small></div><button class="btn btn-primary btn-sm" @onclick="ShowAddOrder"><i class="bi bi-plus-lg me-1"></i>Add Order</button></div>
    @if(ShowOrderForm){<div class="p-3 bg-light border-bottom"><div class="row g-2"><div class="col-md-4"><label class="form-label">Service *</label><select class="form-select" @bind="NewOrder.ServiceTypeId"><option value="">Select service</option>@foreach(var x in ServiceTypes){<option value="@x.ServiceTypeId">@x.Name (@x.Code)</option>}</select></div><div class="col-md-3"><label class="form-label">Frequency</label><input class="form-control" maxlength="100" @bind="NewOrder.Frequency" /></div><div class="col-md-3"><label class="form-label">Duration</label><input class="form-control" maxlength="100" @bind="NewOrder.Duration" /></div><div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" @bind="NewOrder.IsPrimary" id="primary-order"/><label class="form-check-label" for="primary-order">Primary</label></div></div></div><button class="btn btn-primary btn-sm mt-3" disabled="@SavingOrder" @onclick="SaveOrderAsync">@(SavingOrder?"Saving...":"Save Order")</button><button class="btn btn-outline-secondary btn-sm mt-3 ms-2" @onclick="HideAddOrder">Cancel</button></div>}
    <div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Service</th><th>Frequency</th><th>Duration</th><th>Status</th><th>Primary</th></tr></thead><tbody>@if(Care.ServiceOrders.Any()){@foreach(var o in Care.ServiceOrders){<tr><td><strong>@o.ServiceName</strong><div class="small text-muted">@o.ServiceCode</div></td><td>@Display(o.Frequency)</td><td>@Display(o.Duration)</td><td><span class="badge @GetStatusClass(o.Status)">@o.Status</span></td><td>@(o.IsPrimaryDiscipline?"Yes":"No")</td></tr>}}else{<tr><td colspan="5" class="text-center text-muted py-4">No service orders.</td></tr>}</tbody></table></div>
   </div></div>
   <div class="col-xl-6"><CareLogTable Title="Wound Supplies" LogType="Wound Supply" Logs="@Care.CareLogs.Where(x => x.LogType == "Wound Supply").ToList()" OnAdd="@(type => ShowAddCareLog(type))" /></div>
   <div class="col-xl-6"><CareLogTable Title="Foley Catheter Changes" LogType="Foley" Logs="@Care.CareLogs.Where(x => x.LogType == "Foley").ToList()" OnAdd="@(type => ShowAddCareLog(type))" /></div>
  </div>
  @if(ShowCareLogForm){<div class="modal-backdrop fade show"></div><div class="modal d-block" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Add @NewCareLog.LogType</h5><button class="btn-close" @onclick="HideCareLog"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Item / Description *</label><input class="form-control" maxlength="200" @bind="NewCareLog.Item" /></div><div class="row g-2"><div class="col-6"><label class="form-label">Quantity</label><input class="form-control" type="number" min="0" step="0.01" @bind="NewCareLog.Quantity" /></div><div class="col-6"><label class="form-label">Unit</label><input class="form-control" maxlength="50" @bind="NewCareLog.Unit" /></div></div><div class="mt-3"><label class="form-label">Notes</label><textarea class="form-control" rows="4" maxlength="2000" @bind="NewCareLog.Notes"></textarea></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="HideCareLog">Cancel</button><button class="btn btn-primary" disabled="@SavingCareLog" @onclick="SaveCareLogAsync">@(SavingCareLog?"Saving...":"Save")</button></div></div></div></div>}
 }
</div>

@code{
 [Parameter] public Guid PatientId { get; set; }
 [Parameter] public EventCallback OnChanged { get; set; }
 private PatientCareProfileDto? Care; private bool IsLoading; private string? ErrorMessage;
 private List<ServiceTypeDto> ServiceTypes=[]; private bool ShowOrderForm,SavingOrder; private OrderFormModel NewOrder=new();
 private bool ShowCareLogForm,SavingCareLog; private CareLogFormModel NewCareLog=new();
 protected override async Task OnParametersSetAsync(){await LoadAsync();}
 private async Task LoadAsync(){IsLoading=true;ErrorMessage=null;try{Care=await CareService.GetAsync(PatientId);}catch(Exception ex){ErrorMessage=ex.Message;}finally{IsLoading=false;}}
 private async Task ShowAddOrder(){try{ServiceTypes=await CareService.GetServiceTypesAsync();NewOrder=new();ShowOrderForm=true;}catch(Exception ex){ErrorMessage=ex.Message;}}
 private void HideAddOrder(){ShowOrderForm=false;}
 private async Task SaveOrderAsync(){if(NewOrder.ServiceTypeId==Guid.Empty){ErrorMessage="Select a service type.";return;}SavingOrder=true;try{await CareService.AddServiceOrderAsync(PatientId,NewOrder.ServiceTypeId,NewOrder.Frequency,NewOrder.Duration,NewOrder.IsPrimary);await LoadAsync();ShowOrderForm=false;await OnChanged.InvokeAsync();}catch(Exception ex){ErrorMessage=ex.Message;}finally{SavingOrder=false;}}
 private void ShowAddCareLog(string type){ErrorMessage=null;NewCareLog=new(){LogType=type};ShowCareLogForm=true;}
 private void HideCareLog(){ShowCareLogForm=false;}
 private async Task SaveCareLogAsync(){if(string.IsNullOrWhiteSpace(NewCareLog.Item)){ErrorMessage="Item / Description is required.";return;}SavingCareLog=true;try{await CareService.AddCareLogAsync(PatientId,NewCareLog.LogType,NewCareLog.Item,NewCareLog.Quantity,NewCareLog.Unit,NewCareLog.Notes);await LoadAsync();ShowCareLogForm=false;await OnChanged.InvokeAsync();}catch(Exception ex){ErrorMessage=ex.Message;}finally{SavingCareLog=false;}}
 private static string Display(string? x)=>string.IsNullOrWhiteSpace(x)?"-":x; private static string GetStatusClass(string? s)=>s?.ToLowerInvariant() switch{"completed"=>"bg-success","active"=>"bg-success","scheduled"=>"bg-primary","ordered"=>"bg-primary","pending"=>"bg-secondary","cancelled"=>"bg-danger",_=>"bg-secondary"};
 private sealed class OrderFormModel{public Guid ServiceTypeId{get;set;}public string? Frequency{get;set;}public string? Duration{get;set;}public bool IsPrimary{get;set;}}
 private sealed class CareLogFormModel{public string LogType{get;set;}="";public string Item{get;set;}="";public decimal? Quantity{get;set;}public string? Unit{get;set;}public string? Notes{get;set;}}
}
