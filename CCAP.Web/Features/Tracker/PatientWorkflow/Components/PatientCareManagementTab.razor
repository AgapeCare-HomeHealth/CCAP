@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services
@using CCAP.Web.Components

@inject PatientCareManagementService CareService

<div class="patient-care-management">

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div class="text-muted mt-3">
                Loading patient care information...
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @ErrorMessage
        </div>
    }
    else if (Care is null)
    {
        <div class="alert alert-warning">
            Patient care information is unavailable.
        </div>
    }
    else
    {
        <!-- ===================================================== -->
        <!-- FAX INFORMATION                                       -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white
                d-flex justify-content-between
                align-items-center">

                <div>
                    <h5 class="mb-1">
                        Fax Information
                    </h5>

                    <small class="text-muted">
                        Referring office and incoming referral
                        information.
                    </small>
                </div>

            </div>

            <div class="card-body">

                @if (HasFaxInformation)
                {
                    <div class="row g-3">

                        <div class="col-md-3">
                            <strong>Fax Number</strong>

                            <div>
                                @Display(Care.Fax.FaxNumber)
                            </div>
                        </div>

                        <div class="col-md-3">
                            <strong>Referring Provider</strong>

                            <div>
                                @Display(Care.Fax.ReferringProvider)
                            </div>
                        </div>

                        <div class="col-md-3">
                            <strong>Organization</strong>

                            <div>
                                @Display(Care.Fax.Organization)
                            </div>
                        </div>

                        <div class="col-md-3">
                            <strong>Received</strong>

                            <div>
                                @(Care.Fax.ReceivedAt.HasValue
                                    ? Care.Fax.ReceivedAt.Value
                                        .ToString("MM/dd/yyyy h:mm tt")
                                    : "-")
                            </div>
                        </div>

                    </div>

                    <div class="mt-3">

                        <span class="badge @(Care.Fax.Verified
                                                                                    ? "bg-success"
                                                                                    : "bg-warning text-dark")">

                            @(Care.Fax.Verified
                                ? "Verified"
                                : "Needs Verification")

                        </span>

                        @if (!string.IsNullOrWhiteSpace(Care.Fax.Notes))
                        {
                            <span class="text-muted ms-2">
                                @Care.Fax.Notes
                            </span>
                        }

                    </div>
                }
                else
                {
                    <EmptyState Icon="bi bi-printer"
                                Message="No fax information available." />

                    <div class="text-center small text-muted mt-2">
                        Fax persistence is not currently
                        represented by a Domain entity.
                    </div>
                }

            </div>
        </div>


        <!-- ===================================================== -->
        <!-- ROW                                                     -->
        <!-- ===================================================== -->

        <div class="row g-4">


            <!-- ================================================= -->
            <!-- ORDERS MANAGEMENT                                  -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white">

                        <div>
                            <h5 class="mb-1">
                                Orders Management
                            </h5>

                            <small class="text-muted">
                                Patient service orders currently
                                stored in the system.
                            </small>
                        </div>

                    </div>

                    <div class="card-body p-0">

                        @if (Care.ServiceOrders.Any())
                        {
                            <div class="table-responsive">

                                <table class="table table-hover mb-0">

                                    <thead class="table-light">

                                        <tr>
                                            <th>Service</th>
                                            <th>Frequency</th>
                                            <th>Duration</th>
                                            <th>Status</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var order in Care.ServiceOrders)
                                        {
                                            <tr>

                                                <td>

                                                    <strong>
                                                        @Display(order.ServiceName)
                                                    </strong>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        order.ServiceCode))
                                                    {
                                                        <div class="small text-muted">
                                                            @order.ServiceCode
                                                        </div>
                                                    }

                                                    @if (order.IsPrimaryDiscipline)
                                                    {
                                                        <span class="badge bg-primary mt-1">
                                                            Primary
                                                        </span>
                                                    }

                                                </td>

                                                <td>
                                                    @Display(order.Frequency)
                                                </td>

                                                <td>
                                                    @Display(order.Duration)
                                                </td>

                                                <td>
                                                    <span class="badge
                                                        @GetStatusClass(order.Status)">
                                                        @Display(order.Status)
                                                    </span>
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <EmptyState Icon="bi bi-file-earmark-text"
                                        Message="No patient service orders available." />
                        }

                    </div>
                </div>

            </div>


            <!-- ================================================= -->
            <!-- ACTIVE TASKS                                      -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white">

                        <div>
                            <h5 class="mb-1">
                                Orders & Tasks
                            </h5>

                            <small class="text-muted">
                                Current patient tasks requiring
                                attention.
                            </small>
                        </div>

                    </div>

                    <div class="card-body p-0">

                        @if (Care.Tasks.Any())
                        {
                            <div class="table-responsive">

                                <table class="table table-hover mb-0">

                                    <thead class="table-light">

                                        <tr>
                                            <th>Task</th>
                                            <th>Due</th>
                                            <th>Assigned To</th>
                                            <th>Status</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var task in Care.Tasks)
                                        {
                                            <tr>

                                                <td>

                                                    <strong>
                                                        @task.Title
                                                    </strong>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        task.Description))
                                                    {
                                                        <div class="small text-muted">
                                                            @task.Description
                                                        </div>
                                                    }

                                                </td>

                                                <td class="@(task.IsOverdue
                                                                                                                                      ? "text-danger fw-semibold"
                                                                                                                                      : "")">

                                                    @task.DueDate
                                                    .ToString("MM/dd/yyyy")

                                                    @if (task.IsOverdue)
                                                    {
                                                        <div class="small text-danger">
                                                            Overdue
                                                        </div>
                                                    }

                                                </td>

                                                <td>
                                                    @Display(task.AssignedTo)
                                                </td>

                                                <td>

                                                    <span class="badge
                                                        @GetStatusClass(task.Status)">
                                                        @Display(task.Status)
                                                    </span>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <EmptyState Icon="bi bi-check-circle"
                                        Message="No active patient tasks." />
                        }

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- PATIENT NOTES                                     -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white">

                        <div>

                            <h5 class="mb-1">
                                Patient Notes
                            </h5>

                            <small class="text-muted">
                                Recorded communication and call notes.
                            </small>

                        </div>

                    </div>

                    <div class="card-body">

                        @if (Care.Notes.Any())
                        {
                            @foreach (
                                var note in Care.Notes
                                    .OrderByDescending(x => x.CreatedAt)
                                    .Take(5))
                            {
                                <div class="border-bottom pb-3 mb-3">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                        <strong>
                                            @Display(note.Subject)
                                        </strong>

                                        <span class="badge
                                            @GetPriorityClass(note.Priority)">
                                            @Display(note.Priority)
                                        </span>

                                    </div>

                                    <div class="small text-muted mt-1">

                                        @Display(note.CreatedBy)

                                        ·

                                        @note.CreatedAt
                                        .ToString("MM/dd/yyyy h:mm tt")

                                    </div>

                                    <div class="small mt-2">
                                        @Display(note.Content)
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(note.Outcome))
                                    {
                                        <div class="small text-muted mt-2">

                                            <strong>Outcome:</strong>

                                            @note.Outcome

                                        </div>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <EmptyState Icon="bi bi-chat-left-text"
                                        Message="No patient notes available." />
                        }

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- UPCOMING VISITS                                   -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white">

                        <h5 class="mb-1">
                            Upcoming Schedule
                        </h5>

                        <small class="text-muted">
                            Scheduled patient visits.
                        </small>

                    </div>

                    <div class="card-body p-0">

                        @if (Care.UpcomingVisits.Any())
                        {
                            <div class="table-responsive">

                                <table class="table table-hover mb-0">

                                    <thead class="table-light">

                                        <tr>
                                            <th>Date</th>
                                            <th>Visit</th>
                                            <th>Assigned To</th>
                                            <th>Status</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var visit in Care.UpcomingVisits)
                                        {
                                            <tr>

                                                <td>
                                                    @visit.ScheduledDate
                                                    .ToString(
                                                    "MM/dd/yyyy h:mm tt")
                                                </td>

                                                <td>
                                                    Patient Visit
                                                </td>

                                                <td>
                                                    @Display(visit.AssignedTo)
                                                </td>

                                                <td>

                                                    <span class="badge
                                                        @GetStatusClass(visit.Status)">
                                                        @Display(visit.Status)
                                                    </span>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <EmptyState Icon="bi bi-calendar3"
                                        Message="No upcoming visits scheduled." />
                        }

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- LAB ORDERS                                        -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white">

                        <h5 class="mb-1">
                            Lab Orders Tracking
                        </h5>

                        <small class="text-muted">
                            Lab-order tracking is not currently
                            backed by a Domain entity.
                        </small>

                    </div>

                    <div class="card-body">

                        <EmptyState Icon="bi bi-eyedropper"
                                    Message="No lab-order records available." />

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- WOUND SUPPLIES                                    -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white">

                        <h5 class="mb-1">
                            Wound Supplies
                        </h5>

                        <small class="text-muted">
                            Supply tracking is not currently
                            backed by a Domain entity.
                        </small>

                    </div>

                    <div class="card-body">

                        <EmptyState Icon="bi bi-box-seam"
                                    Message="No wound-supply records available." />

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FOLEY                                             -->
            <!-- ================================================= -->

            <div class="col-xl-6">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white">

                        <h5 class="mb-1">
                            Foley Catheter Changes
                        </h5>

                        <small class="text-muted">
                            Foley tracking is not currently
                            backed by a Domain entity.
                        </small>

                    </div>

                    <div class="card-body">

                        <EmptyState Icon="bi bi-heart-pulse"
                                    Message="No Foley-change records available." />

                    </div>

                </div>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public Guid PatientId { get; set; }


    private PatientCareProfileDto? Care;

    private bool IsLoading;

    private string? ErrorMessage;


    private bool HasFaxInformation =>
        Care?.Fax is not null &&
        (
            !string.IsNullOrWhiteSpace(Care.Fax.FaxNumber) ||
            !string.IsNullOrWhiteSpace(Care.Fax.ReferringProvider) ||
            !string.IsNullOrWhiteSpace(Care.Fax.Organization) ||
            Care.Fax.ReceivedAt.HasValue
        );


    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        IsLoading = true;

        ErrorMessage = null;

        try
        {
            Care = await CareService.GetAsync(
                PatientId);
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Unable to load patient care information. " +
                ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }


    private static string Display(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }


    private static string GetStatusClass(
        string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" =>
                "bg-success",

            "active" =>
                "bg-success",

            "scheduled" =>
                "bg-primary",

            "inprogress" =>
                "bg-primary",

            "in progress" =>
                "bg-primary",

            "ordered" =>
                "bg-primary",

            "pending" =>
                "bg-secondary",

            "cancelled" =>
                "bg-danger",

            _ =>
                "bg-secondary"
        };
    }


    private static string GetPriorityClass(
        string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "high" =>
                "bg-danger",

            "medium" =>
                "bg-warning text-dark",

            "low" =>
                "bg-success",

            _ =>
                "bg-secondary"
        };
    }
}