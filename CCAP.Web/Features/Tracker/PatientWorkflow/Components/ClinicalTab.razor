@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services
@inject PatientClinicalService ClinicalService

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Ordered Services</h5>
        <button class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle"></i>
            Add Service
        </button>
    </div>

    <div class="card-body">
        @if (IsLoading)
        {
            <div class="py-4 text-center">Loading service types...</div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }
        else if (!Services.Any())
        {
            <div class="alert alert-info">
                No active service types are configured in the database.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var service in Services)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="service-card">
                            <div class="service-icon @service.CssClass">
                                <i class="@service.Icon"></i>
                            </div>
                            <h6>@service.Name</h6>
                            <p class="text-muted mb-2">Available service</p>
                        </div>
                    </div>
                }
            </div>

            <hr class="my-4" />

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-label">Primary Discipline</label>
                    <select class="form-select" @bind="SelectedServiceId">
                        <option value="">Select service</option>
                        @foreach (var service in Services)
                        {
                            <option value="@service.ServiceTypeId">@service.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Frequency</label>
                    <input class="form-control" @bind="Frequency"
                           placeholder="Example: 3 Visits / Week" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Duration</label>
                    <input class="form-control" @bind="Duration"
                           placeholder="Example: 8 Weeks" />
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<ServiceTypeDto> Services = [];
    private string? SelectedServiceId;
    private string? Frequency;
    private string? Duration;
    private bool IsLoading;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            Services = await ClinicalService.GetServiceTypesAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load service types: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
