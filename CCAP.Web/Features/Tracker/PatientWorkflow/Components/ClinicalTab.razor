@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
<div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-1">Clinical / SOC Reference</h5><small class="text-muted">CCAP is a coordination and confirmation system. Clinical documentation and SOC visit scheduling/completion remain in the EMR.</small></div><div class="card-body"><div class="alert alert-info mb-0"><i class="bi bi-info-circle me-2"></i><strong>SOC is managed in the EMR.</strong> Check the EMR for the actual visit, clinician documentation and clinical records. When the SOC meets the required compliance criteria, return to the <strong>Compliance</strong> tab and mark <strong>SOC Compliant</strong> complete in CCAP.</div>@if(Workflow?.Header.SocDate is not null){<div class="mt-3"><span class="small text-muted">SOC target/date</span><div class="fw-semibold">@Workflow.Header.SocDate.Value.ToString("MM/dd/yyyy")</div></div>}</div></div>
@code { [Parameter] public PatientWorkflowDto? Workflow {get;set;} }
