@using CCAP.Web.Features.Tracker.PatientWorkflow.Model
@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

@if (Workflow is null)
{
    <div class="audit-empty">
        <div class="audit-empty-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>

        <h5>Audit log unavailable</h5>

        <p>
            Patient workflow information could not be loaded.
        </p>
    </div>

    return;
}

<div class="audit-container">

    <!-- Header -->
    <div class="audit-header">

        <div>
            <h4 class="mb-1">Audit Log</h4>

            <div class="audit-patient-info">

                <span>
                    <i class="bi bi-person"></i>
                    @Workflow.Header.FirstName
                    @Workflow.Header.MiddleName
                    @Workflow.Header.LastName
                </span>

                <span>
                    <i class="bi bi-person-vcard"></i>
                    MRN: @Workflow.Header.MRN
                </span>

                @if (!string.IsNullOrWhiteSpace(Workflow.Header.ReferralNumber))
                {
                    <span>
                        <i class="bi bi-file-earmark-text"></i>
                        Referral: @Workflow.Header.ReferralNumber
                    </span>
                }

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Workflow.Header.Status))
        {
            <div class="audit-status">
                <span class="status-badge">
                    @Workflow.Header.Status
                </span>
            </div>
        }

    </div>

    <!-- Activity Records -->
    <section class="audit-section">

        <div class="section-heading">

            <div>
                <h5>Recent Patient Activity</h5>

                <p>
                    Activity records currently available from the patient workflow.
                </p>
            </div>

            <div class="record-count">
                @Workflow.RecentActivities.Count record(s)
            </div>

        </div>

        @if (Workflow.RecentActivities.Any())
        {
            <div class="audit-table-wrapper">

                <table class="audit-table">

                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Activity</th>
                            <th>Type</th>
                            <th>Performed By</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var activity in Workflow.RecentActivities
                            .OrderByDescending(x => x.ActivityDate))
                        {
                            <tr>

                                <td class="audit-date">
                                    <div>
                                        @activity.ActivityDate
                                        .ToLocalTime()
                                        .ToString("MMM dd, yyyy")
                                    </div>

                                    <small>
                                        @activity.ActivityDate
                                        .ToLocalTime()
                                        .ToString("h:mm tt")
                                    </small>
                                </td>

                                <td>
                                    <div class="activity-title">
                                        @activity.Title
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(activity.ActivityType))
                                    {
                                        <span class="activity-type">
                                            @activity.ActivityType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="not-available">
                                            Not specified
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(activity.PerformedBy))
                                    {
                                        <div class="performed-by">
                                            <i class="bi bi-person"></i>
                                            @activity.PerformedBy
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="performed-by">
                                            <i class="bi bi-gear"></i>
                                            System
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(activity.Description))
                                    {
                                        <span class="description">
                                            @activity.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="not-available">
                                            No description available
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="audit-info">
                <i class="bi bi-info-circle"></i>

                <span>
                    This view shows the recent activity records returned by
                    the patient workflow API. It does not display historical
                    audit changes that are not currently exposed by the API.
                </span>
            </div>
        }
        else
        {
            <div class="audit-no-records">

                <div class="audit-no-records-icon">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h6>No activity records</h6>

                <p>
                    There are currently no activity records available for
                    this patient.
                </p>

            </div>
        }

    </section>

    <!-- Workflow History -->
    @if (Workflow.WorkflowStages.Any())
    {
        <section class="audit-section">

            <div class="section-heading">

                <div>
                    <h5>Workflow History</h5>

                    <p>
                        Workflow stages and their recorded completion status.
                    </p>
                </div>

            </div>

            <div class="workflow-history">

                @foreach (var stage in Workflow.WorkflowStages
                    .OrderBy(x => x.Sequence))
                {
                    <div class="workflow-history-row">

                        <div class="workflow-sequence">
                            @stage.Sequence
                        </div>

                        <div class="workflow-details">

                            <div class="workflow-title">
                                @stage.StageName
                            </div>

                            @if (!string.IsNullOrWhiteSpace(stage.Description))
                            {
                                <div class="workflow-description">
                                    @stage.Description
                                </div>
                            }

                        </div>

                        <div class="workflow-assignment">

                            @if (!string.IsNullOrWhiteSpace(stage.AssignedUserName))
                            {
                                <span>
                                    <i class="bi bi-person"></i>
                                    @stage.AssignedUserName
                                </span>
                            }
                            else
                            {
                                <span class="not-available">
                                    Unassigned
                                </span>
                            }

                        </div>

                        <div class="workflow-status">

                            <span class="stage-status @GetStatusClass(stage.Status)">
                                @GetStatusText(stage.Status)
                            </span>

                            @if (stage.CompletedDate.HasValue)
                            {
                                <small>
                                    @stage.CompletedDate
                                    .Value
                                    .ToLocalTime()
                                    .ToString("MMM dd, yyyy h:mm tt")
                                </small>
                            }

                        </div>

                    </div>
                }

            </div>

        </section>
    }

</div>

@code {

    [Parameter]
    public PatientWorkflowDto? Workflow { get; set; }

    private static string GetStatusClass(WorkflowStatus status)
    {
        return status switch
        {
            WorkflowStatus.Completed => "status-completed",
            WorkflowStatus.Current => "status-current",
            _ => "status-pending"
        };
    }

    private static string GetStatusText(WorkflowStatus status)
    {
        return status switch
        {
            WorkflowStatus.Completed => "Completed",
            WorkflowStatus.Current => "Current",
            _ => "Pending"
        };
    }
}