@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services
@inject PatientWorkflowService WorkflowService

<div class="card shadow-sm border-0">
 <div class="card-header bg-white"><h5 class="mb-0">Audit Log</h5><small class="text-muted">CRUD history for patient records, including old and new values.</small></div>
 @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="alert alert-danger m-3">@ErrorMessage</div> }
 <div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
   <thead class="table-light"><tr><th>Date / Time</th><th>Action</th><th>Entity</th><th>Performed By</th><th>Description</th><th>Old Data</th><th>New Data</th></tr></thead>
   <tbody>
   @if (Logs.Any()) { @foreach(var log in Logs) { <tr><td>@log.OccurredAt.ToLocalTime().ToString("MM/dd/yyyy h:mm:ss tt")</td><td><span class="badge @ActionClass(log.Action)">@log.Action</span></td><td>@log.EntityType<br/><small class="text-muted">@log.EntityId</small></td><td>@log.PerformedBy</td><td>@log.Description</td><td><pre class="audit-json">@log.OldValues</pre></td><td><pre class="audit-json">@log.NewValues</pre></td></tr> } } else { <tr><td colspan="7" class="text-center text-muted py-5">No audit records found.</td></tr> }
   </tbody>
  </table>
 </div>
</div>
@code {
 [Parameter] public Guid PatientId {get;set;}
 [Parameter] public PatientWorkflowDto? Workflow {get;set;}
 private List<PatientAuditLogDto> Logs=[]; private string? ErrorMessage;
 protected override async Task OnParametersSetAsync(){try{Logs=await WorkflowService.GetAuditLogAsync(PatientId);}catch(Exception ex){ErrorMessage=ex.Message;Logs=[];}}
 private static string ActionClass(string action)=>action switch{"CREATE"=>"bg-success","UPDATE"=>"bg-primary","DELETE"=>"bg-danger",_=>"bg-secondary"};
}
