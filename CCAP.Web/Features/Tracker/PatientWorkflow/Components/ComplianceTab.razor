@using CCAP.Web.Features.Tracker.PatientWorkflow.Model
@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Tracker.PatientWorkflow.Services

@inject PatientWorkflowService WorkflowService

<div class="compliance-page">

    @* ========================================================= *@
    @* COMPLIANCE OVERVIEW                                      *@
    @* ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                Compliance Overview
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                @* Patient *@
                <div class="col-md-6">

                    <div class="small text-muted mb-1">
                        Patient
                    </div>

                    <div class="fw-semibold">
                        @Workflow.Header.FirstName
                        @Workflow.Header.MiddleName
                        @Workflow.Header.LastName
                    </div>

                </div>


                @* MRN *@
                <div class="col-md-6">

                    <div class="small text-muted mb-1">
                        MRN
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Header.MRN))
                    {
                        <div class="fw-semibold">
                            @Workflow.Header.MRN
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            Not provided
                        </div>
                    }

                </div>


                @* Referral Number *@
                <div class="col-md-6">

                    <div class="small text-muted mb-1">
                        Referral Number
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Header.ReferralNumber))
                    {
                        <div class="fw-semibold">
                            @Workflow.Header.ReferralNumber
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            Not provided
                        </div>
                    }

                </div>


                @* Patient Status *@
                <div class="col-md-6">

                    <div class="small text-muted mb-1">
                        Patient Status
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Header.Status))
                    {
                        <span class="badge @GetPatientStatusClass(
                                                        Workflow.Header.Status)">
                            @Workflow.Header.Status
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not available
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    @* ========================================================= *@
    @* COMPLIANCE PROGRESS                                     *@
    @* ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-0">
                        Compliance Progress
                    </h5>

                    <small class="text-muted">
                        Overall completion of required compliance items
                    </small>
                </div>

                <div class="text-end">

                    <div class="fs-4 fw-semibold">
                        @ComplianceCompletionPercentage%
                    </div>

                    <div class="small text-muted">
                        @CompletedComplianceCount /
                        @TotalComplianceCount Complete
                    </div>

                </div>

            </div>

        </div>

        <div class="card-body">

            @if (TotalComplianceCount == 0)
            {
                <div class="text-muted">
                    No compliance requirements are available.
                </div>
            }
            else
            {
                <div class="progress"
                     role="progressbar"
                     aria-valuenow="@ComplianceCompletionPercentage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     style="height: 12px;">

                    <div class="progress-bar"
                         style="width: @($"{ComplianceCompletionPercentage}%");">
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-2">

                    <small class="text-muted">
                        Completed:
                        @CompletedComplianceCount
                    </small>

                    <small class="text-muted">
                        Remaining:
                        @(TotalComplianceCount -
                          CompletedComplianceCount)
                    </small>

                </div>
            }

        </div>

    </div>


    @* ========================================================= *@
    @* COMPLIANCE CHECKLIST                                    *@
    @* ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white
            d-flex justify-content-between
            align-items-center">

            <div>

                <h5 class="mb-0">
                    Compliance Checklist
                </h5>

                <small class="text-muted">
                    Required compliance items for this patient
                </small>

            </div>

            <span class="fw-semibold">
                @CompletedComplianceCount /
                @TotalComplianceCount
                Complete
            </span>

        </div>


        <div class="card-body p-0">

            @if (!ComplianceItems.Any())
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-clipboard-check fs-2
                    d-block mb-2"></i>

                    <div>
                        No compliance requirements are available.
                    </div>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover
                        align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Requirement
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Completed
                                </th>

                                <th>
                                    Completed By
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in ComplianceItems)
                            {
                                <tr>

                                    @* ===================================== *@
                                    @* Requirement                           *@
                                    @* ===================================== *@

                                    <td>

                                        <div class="fw-semibold">
                                            @item.RequirementName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.RequirementCode))
                                        {
                                            <div class="small text-muted">
                                                @item.RequirementCode
                                            </div>
                                        }

                                    </td>


                                    @* ===================================== *@
                                    @* Description                           *@
                                    @* ===================================== *@

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.Description))
                                        {
                                            <span>
                                                @item.Description
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    @* ===================================== *@
                                    @* Status                                *@
                                    @* ===================================== *@

                                    <td>

                                        @if (item.IsCompleted)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1">
                                                </i>

                                                Completed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                bg-warning
                                                text-dark">

                                                <i class="bi bi-clock me-1">
                                                </i>

                                                Pending

                                            </span>
                                        }

                                    </td>


                                    @* ===================================== *@
                                    @* Completed Date                       *@
                                    @* ===================================== *@

                                    <td>

                                        @if (item.CompletedAt.HasValue)
                                        {
                                            <span>
                                                @item.CompletedAt.Value.ToString(
                                                    "MM/dd/yyyy hh:mm tt")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    @* ===================================== *@
                                    @* Completed By                         *@
                                    @* ===================================== *@

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.CompletedByUserName))
                                        {
                                            <span>
                                                @item.CompletedByUserName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    @* ===================================== *@
                                    @* Action                                *@
                                    @* ===================================== *@

                                    <td class="text-end">

                                        @if (!item.IsCompleted)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    @onclick="
                                                    () => CompleteComplianceAsync(
                                                        item.RequirementCode)"
    disabled="@IsSaving">

                                                @if (
                                                    IsSaving &&
                                                    string.Equals(
                                                        SavingRequirementCode,
                                                        item.RequirementCode,
                                                        StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="spinner-border
                                                        spinner-border-sm
                                                        me-1"
                                                          role="status"
                                                          aria-hidden="true">
                                                    </span>

                                                    <span>
                                                        Saving...
                                                    </span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2 me-1">
                                                    </i>

                                                    <span>
                                                        Mark Complete
                                                    </span>
                                                }

                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-success small">

                                                <i class="bi bi-check-circle me-1">
                                                </i>

                                                Completed

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    @* ========================================================= *@
    @* COMPLIANCE STATUS SUMMARY                               *@
    @* ========================================================= *@

    @if (TotalComplianceCount > 0)
    {
        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    Compliance Status
                </h5>

            </div>


            <div class="card-body">

                <div class="row g-4">

                    @* Completed *@

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Completed
                            </div>

                            <div class="fs-3 fw-semibold">
                                @CompletedComplianceCount
                            </div>

                            <div class="small text-muted">
                                compliance requirements
                            </div>

                        </div>

                    </div>


                    @* Pending *@

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Pending
                            </div>

                            <div class="fs-3 fw-semibold">
                                @(TotalComplianceCount -
                                  CompletedComplianceCount)
                            </div>

                            <div class="small text-muted">
                                compliance requirements
                            </div>

                        </div>

                    </div>


                    @* Completion *@

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Completion
                            </div>

                            <div class="fs-3 fw-semibold">
                                @ComplianceCompletionPercentage%
                            </div>

                            <div class="small text-muted">
                                of requirements complete
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

</div>


@code {

    // =============================================================
    // PARAMETERS
    // =============================================================

    [Parameter]
    public Guid PatientId { get; set; }


    [Parameter]
    public PatientWorkflowDto Workflow { get; set; } = new();


    [Parameter]
    public EventCallback OnCompleted { get; set; }


    // =============================================================
    // STATE
    // =============================================================

    private bool IsSaving { get; set; }

    private string? SavingRequirementCode { get; set; }


    // =============================================================
    // COMPLIANCE ITEMS
    // =============================================================

    private IEnumerable<ComplianceItemDto> ComplianceItems =>
        Workflow.ComplianceItems
        ?? Enumerable.Empty<ComplianceItemDto>();


    private int CompletedComplianceCount =>
        ComplianceItems.Count(
            x => x.IsCompleted);


    private int TotalComplianceCount =>
        ComplianceItems.Count();


    private int ComplianceCompletionPercentage
    {
        get
        {
            if (TotalComplianceCount == 0)
                return 0;

            return (int)Math.Round(
                CompletedComplianceCount *
                100.0 /
                TotalComplianceCount);
        }
    }


    // =============================================================
    // COMPLETE COMPLIANCE REQUIREMENT
    // =============================================================

    private async Task CompleteComplianceAsync(
        string requirementCode)
    {
        if (PatientId == Guid.Empty)
            return;

        if (string.IsNullOrWhiteSpace(
            requirementCode))
        {
            return;
        }

        var item =
            ComplianceItems.FirstOrDefault(
                x => string.Equals(
                    x.RequirementCode,
                    requirementCode,
                    StringComparison.OrdinalIgnoreCase));

        if (item is null ||
            item.IsCompleted)
        {
            return;
        }

        IsSaving = true;
        SavingRequirementCode = requirementCode;

        try
        {
            await WorkflowService.CompleteComplianceAsync(
                PatientId,
                requirementCode);

            await OnCompleted.InvokeAsync();
        }
        finally
        {
            IsSaving = false;
            SavingRequirementCode = null;
        }
    }


    // =============================================================
    // PATIENT STATUS
    // =============================================================

    private static string GetPatientStatusClass(
        string? status) =>
        status?.Trim().ToLowerInvariant() switch
        {
            "active" =>
                "bg-success",

            "pending" =>
                "bg-warning text-dark",

            "discharged" =>
                "bg-secondary",

            "closed" =>
                "bg-secondary",

            "cancelled" =>
                "bg-danger",

            _ =>
                "bg-secondary"
        };

}