@using CCAP.Web.Features.Tracker.PatientWorkflow.Model
@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<div class="communication-page">

    <!-- ========================================================= -->
    <!-- Communication Overview                                   -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                Communication
            </h5>
        </div>

        <div class="card-body">

            @if (Workflow is null)
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-chat-dots fs-2
                    d-block mb-2"></i>

                    <div>
                        Communication information is unavailable.
                    </div>

                </div>
            }
            else
            {
                <div class="row g-4">

                    <!-- Patient -->
                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Patient
                        </div>

                        <div class="fw-semibold">
                            @Workflow.Header.FirstName
                            @Workflow.Header.MiddleName
                            @Workflow.Header.LastName
                        </div>

                    </div>


                    <!-- MRN -->
                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            MRN
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            Workflow.Header.MRN))
                        {
                            <div class="fw-semibold">
                                @Workflow.Header.MRN
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                Not provided
                            </div>
                        }

                    </div>


                    <!-- Coordinator -->
                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Coordinator
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            Workflow.KeyInformation.Coordinator))
                        {
                            <div class="fw-semibold">
                                @Workflow.KeyInformation.Coordinator
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                Not assigned
                            </div>
                        }

                    </div>


                    <!-- Clinician -->
                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Clinician
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            Workflow.KeyInformation.Clinician))
                        {
                            <div class="fw-semibold">
                                @Workflow.KeyInformation.Clinician
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                Not assigned
                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- Recent Communication Activity                            -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white
            d-flex justify-content-between
            align-items-center">

            <div>

                <h5 class="mb-0">
                    Recent Communication Activity
                </h5>

                <small class="text-muted">
                    Activity currently available from the patient
                    workflow
                </small>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Workflow is null)
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-chat-square-text fs-2
                    d-block mb-2"></i>

                    <div>
                        Communication activity is unavailable.
                    </div>

                </div>
            }
            else if (!CommunicationActivities.Any())
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-chat-square-text fs-2
                    d-block mb-2"></i>

                    <div>
                        No communication activity is available.
                    </div>

                </div>
            }
            else
            {
                <div class="list-group list-group-flush">

                    @foreach (var activity in CommunicationActivities)
                    {
                        <div class="list-group-item py-3">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3">

                                <div class="flex-grow-1">

                                    <div class="d-flex
                                        align-items-center
                                        gap-2">

                                        <i class="@GetActivityIcon(
                                                                                       activity.ActivityType)">
                                        </i>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(
                                                activity.Title)
                                                ? "Communication activity"
                                                : activity.Title)
                                        </strong>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        activity.Description))
                                    {
                                        <div class="text-muted mt-2">
                                            @activity.Description
                                        </div>
                                    }


                                    <div class="small text-muted mt-2">

                                        @if (!string.IsNullOrWhiteSpace(
                                            activity.PerformedBy))
                                        {
                                            <span>
                                                @activity.PerformedBy
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                System
                                            </span>
                                        }

                                        <span class="mx-1">
                                            •
                                        </span>

                                        <span>
                                            @activity.ActivityDate
                                            .ToString(
                                            "MM/dd/yyyy hh:mm tt")
                                        </span>

                                    </div>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                    activity.ActivityType))
                                {
                                    <span class="badge
                                        @GetActivityBadgeClass(
                                            activity.ActivityType)">
                                        @activity.ActivityType
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- Communication Data Limitation                             -->
    <!-- ========================================================= -->
    @if (Workflow is not null &&
             Workflow.RecentActivities.Count > 0)
    {
        <div class="alert alert-light border mt-4 mb-0">

            <div class="d-flex align-items-start">

                <i class="bi bi-info-circle me-2 mt-1"></i>

                <div>

                    <div class="fw-semibold">
                        Recent activity only
                    </div>

                    <div class="small text-muted">
                        This view displays communication-related
                        activity currently returned by the patient
                        workflow. Complete call-note history is not
                        shown here until a dedicated call-note
                        read endpoint is available.
                    </div>

                </div>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public PatientWorkflowDto? Workflow { get; set; }


    [Parameter]
    public PatientCareProfileDto? Care { get; set; }


    // =============================================================
    // COMMUNICATION ACTIVITIES
    // =============================================================

    private IEnumerable<ActivityDto> CommunicationActivities =>
        Workflow?.RecentActivities?
            .Where(IsCommunicationActivity)
            .OrderByDescending(x => x.ActivityDate)
            ?? Enumerable.Empty<ActivityDto>();


    // =============================================================
    // ACTIVITY FILTER
    // =============================================================

    private static bool IsCommunicationActivity(
        ActivityDto activity)
    {
        return ContainsCommunicationKeyword(
                   activity.ActivityType)
            || ContainsCommunicationKeyword(
                   activity.Title)
            || ContainsCommunicationKeyword(
                   activity.Description);
    }


    private static bool ContainsCommunicationKeyword(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return value.Contains(
                   "call",
                   StringComparison.OrdinalIgnoreCase)
            || value.Contains(
                   "communication",
                   StringComparison.OrdinalIgnoreCase)
            || value.Contains(
                   "contact",
                   StringComparison.OrdinalIgnoreCase)
            || value.Contains(
                   "phone",
                   StringComparison.OrdinalIgnoreCase)
            || value.Contains(
                   "message",
                   StringComparison.OrdinalIgnoreCase)
            || value.Contains(
                   "note",
                   StringComparison.OrdinalIgnoreCase)
            || value.Contains(
                   "fax",
                   StringComparison.OrdinalIgnoreCase);
    }


    // =============================================================
    // ACTIVITY ICON
    // =============================================================

    private static string GetActivityIcon(
        string? activityType)
    {
        if (string.IsNullOrWhiteSpace(activityType))
        {
            return "bi bi-chat-square-text";
        }

        return activityType.Trim().ToLowerInvariant() switch
        {
            "call" =>
                "bi bi-telephone",

            "communication" =>
                "bi bi-chat-dots",

            "note" =>
                "bi bi-journal-text",

            "fax" =>
                "bi bi-printer",

            "message" =>
                "bi bi-envelope",

            _ =>
                "bi bi-chat-square-text"
        };
    }


    // =============================================================
    // ACTIVITY BADGE
    // =============================================================

    private static string GetActivityBadgeClass(
        string? activityType)
    {
        return activityType?.Trim().ToLowerInvariant() switch
        {
            "call" =>
                "bg-primary",

            "communication" =>
                "bg-info text-dark",

            "note" =>
                "bg-secondary",

            "fax" =>
                "bg-warning text-dark",

            "message" =>
                "bg-primary",

            "created" =>
                "bg-success",

            "updated" =>
                "bg-warning text-dark",

            "completed" =>
                "bg-success",

            _ =>
                "bg-secondary"
        };
    }

}