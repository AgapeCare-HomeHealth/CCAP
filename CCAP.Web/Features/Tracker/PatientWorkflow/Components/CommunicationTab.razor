<div class="communication-page">

    <!-- ================= Summary ================= -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3">

            <div class="status-card primary">

                <h6>Total Communications</h6>

                <h2>18</h2>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="status-card success">

                <h6>Today's Calls</h6>

                <h2>3</h2>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="status-card warning">

                <h6>Follow Ups</h6>

                <h2>2</h2>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="status-card danger">

                <h6>Unread Notes</h6>

                <h2>1</h2>

            </div>

        </div>

    </div>

    <!-- ================= Toolbar ================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-end g-3">

                <div class="col-lg-3">

                    <label class="form-label">

                        Communication Type

                    </label>

                    <select class="form-select">

                        <option>Phone Call</option>
                        <option>Email</option>
                        <option>SMS</option>
                        <option>Fax</option>
                        <option>Patient Note</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label">

                        Contact

                    </label>

                    <select class="form-select">

                        <option>Patient</option>
                        <option>Physician</option>
                        <option>Insurance</option>
                        <option>Clinician</option>
                        <option>Family</option>

                    </select>

                </div>

                <div class="col-lg-4">

                    <label class="form-label">

                        Subject

                    </label>

                    <input class="form-control"
                           placeholder="Reason for communication" />

                </div>

                <div class="col-lg-2 d-grid">

                    <button class="btn btn-success">

                        <i class="bi bi-plus-circle me-2"></i>

                        Add

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= Timeline ================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Communication History

            </h5>

        </div>

        <div class="card-body">

            <div class="timeline">

                <div class="timeline-item">

                    <div class="timeline-icon bg-primary">

                        <i class="bi bi-telephone"></i>

                    </div>

                    <div class="timeline-content">

                        <div class="d-flex justify-content-between">

                            <strong>

                                Phone Call - Physician

                            </strong>

                            <small>

                                Aug 6, 2026 10:20 AM

                            </small>

                        </div>

                        <p class="mb-1">

                            Confirmed signed Plan of Care will be faxed this afternoon.

                        </p>

                        <small class="text-muted">

                            By Jennifer LVN

                        </small>

                    </div>

                </div>

                <div class="timeline-item">

                    <div class="timeline-icon bg-success">

                        <i class="bi bi-envelope"></i>

                    </div>

                    <div class="timeline-content">

                        <div class="d-flex justify-content-between">

                            <strong>

                                Email - Insurance

                            </strong>

                            <small>

                                Aug 5, 2026

                            </small>

                        </div>

                        <p class="mb-1">

                            Authorization request submitted.

                        </p>

                        <small class="text-muted">

                            By Jennifer LVN

                        </small>

                    </div>

                </div>

                <div class="timeline-item">

                    <div class="timeline-icon bg-warning">

                        <i class="bi bi-chat-left-text"></i>

                    </div>

                    <div class="timeline-content">

                        <div class="d-flex justify-content-between">

                            <strong>

                                Patient Note

                            </strong>

                            <small>

                                Aug 4, 2026

                            </small>

                        </div>

                        <p class="mb-1">

                            Patient requested morning visits only.

                        </p>

                        <small class="text-muted">

                            By Care Coordinator

                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>