@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<div class="overview-tab">

    <!-- ================= Quick Actions ================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Quick Actions

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-lg-3 col-md-6">

                    <button class="btn btn-success w-100"
                            @onclick="OpenInsurance">

                        <i class="bi bi-shield-check me-2"></i>

                        Verify Insurance

                    </button>

                </div>

                <div class="col-lg-3 col-md-6">

                    <button class="btn btn-primary w-100"
                            @onclick="OpenClinical">

                        <i class="bi bi-calendar-plus me-2"></i>

                        Schedule SOC

                    </button>

                </div>

                <div class="col-lg-3 col-md-6">

                    <button class="btn btn-warning w-100"
                            @onclick="OpenDocuments">

                        <i class="bi bi-folder2-open me-2"></i>

                        Upload Document

                    </button>

                </div>

                <div class="col-lg-3 col-md-6">

                    <button class="btn btn-outline-success w-100"
                            @onclick="OpenCommunication">

                        <i class="bi bi-chat-dots me-2"></i>

                        Add Note

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= Dashboard ================= -->

    <div class="row g-4">

        <div class="col-xl-4">

            <NextActionCard />

        </div>

        <div class="col-xl-4">

            <KeyInformationCard />

        </div>

        <div class="col-xl-4">

            <RecentActivityCard />

        </div>

    </div>

    <!-- ================= Summary ================= -->

    <div class="mt-4">

        <PatientSummaryBar />

    </div>

    <!-- ================= Assigned Team ================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Assigned Care Team

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Coordinator</strong>

                    <p>Jennifer LVN</p>

                </div>

                <div class="col-md-4">

                    <strong>Primary Clinician</strong>

                    <p>Renald LVN</p>

                </div>

                <div class="col-md-4">

                    <strong>Physician</strong>

                    <p>Dr. Robert Miller</p>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= Upcoming Schedule ================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Upcoming Schedule

            </h5>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th>Date</th>

                        <th>Visit</th>

                        <th>Assigned To</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>08/08/2026</td>

                        <td>Start of Care</td>

                        <td>Renald LVN</td>

                        <td>

                            <span class="badge bg-primary">

                                Scheduled

                            </span>

                        </td>

                    </tr>

                    <tr>

                        <td>08/10/2026</td>

                        <td>Skilled Nursing</td>

                        <td>Jennifer LVN</td>

                        <td>

                            <span class="badge bg-secondary">

                                Pending

                            </span>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

    <!-- ================= Recent Documents ================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Recent Documents

            </h5>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th>Document</th>

                        <th>Category</th>

                        <th>Date</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>Referral.pdf</td>

                        <td>Referral</td>

                        <td>08/04/2026</td>

                        <td>

                            <span class="badge bg-success">

                                Processed

                            </span>

                        </td>

                    </tr>

                    <tr>

                        <td>Insurance Card.pdf</td>

                        <td>Insurance</td>

                        <td>08/05/2026</td>

                        <td>

                            <span class="badge bg-warning text-dark">

                                Pending Review

                            </span>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

@code {


    [Parameter]
    public EventCallback<string> OnChangeTab { get; set; }

    private async Task OpenInsurance()
    {
        await OnChangeTab.InvokeAsync("Insurance");
    }

    private async Task OpenClinical()
    {
        await OnChangeTab.InvokeAsync("Clinical");
    }

    private async Task OpenDocuments()
    {
        await OnChangeTab.InvokeAsync("Documents");
    }

    private async Task OpenCommunication()
    {
        await OnChangeTab.InvokeAsync("Communication");
    }
}