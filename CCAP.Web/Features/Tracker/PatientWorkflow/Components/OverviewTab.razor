@using CCAP.Web.Features.Tracker.PatientWorkflow.Model
@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@using CCAP.Web.Features.Notifications.Models

<div class="overview-tab">

    <!-- ===================================================== -->
    <!-- Quick Actions                                         -->
    <!-- ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                Quick Actions
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <button class="btn btn-success w-100"
                            @onclick="OpenInsurance">

                        <i class="bi bi-shield-check me-2"></i>
                        Verify Insurance

                    </button>
                </div>

                <div class="col-md-4">
                    <button class="btn btn-primary w-100"
                            @onclick="OpenClinical">

                        <i class="bi bi-calendar-plus me-2"></i>
                        Schedule SOC

                    </button>
                </div>

                <div class="col-md-4">
                    <button class="btn btn-outline-success w-100"
                            @onclick="OpenCommunication">

                        <i class="bi bi-chat-dots me-2"></i>
                        Add Note

                    </button>
                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Current Status / Next Action                          -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Current Status -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Current Status
                    </h5>
                </div>

                <div class="card-body">

                    @if (CurrentStage is not null)
                    {
                        <span class="@GetWorkflowStatusClass(CurrentStage.Status)">
                            @GetWorkflowStatusText(CurrentStage.Status)
                        </span>

                        <h5 class="mt-3">
                            @CurrentStage.StageName
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(CurrentStage.Description))
                        {
                            <p class="text-muted mb-0">
                                @CurrentStage.Description
                            </p>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(Workflow?.Header?.Status))
                    {
                        <span class="badge @GetPatientStatusBadgeClass(Workflow.Header.Status)">
                            @Workflow.Header.Status
                        </span>

                        <h5 class="mt-3">
                            No active workflow stage
                        </h5>

                        <p class="text-muted mb-0">
                            There is currently no active workflow stage for this patient.
                        </p>
                    }
                    else
                    {
                        <div class="text-muted">
                            Patient workflow information is unavailable.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Next Action -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Next Action
                    </h5>
                </div>

                <div class="card-body">

                    @if (HasNextAction)
                    {
                        <h5>
                            @Workflow!.NextAction.Title
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(
                            Workflow.NextAction.Description))
                        {
                            <p class="text-muted">
                                @Workflow.NextAction.Description
                            </p>
                        }

                        <div class="small text-muted mb-3">
                            Due:
                            @Workflow.NextAction.DueDate
                            .ToString("MM/dd/yyyy")
                        </div>

                        @if (Workflow.NextAction.IsOverdue)
                        {
                            <span class="badge bg-danger me-2">
                                Overdue
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            Workflow.NextAction.PageRoute))
                        {
                            <button class="btn btn-primary btn-sm"
                                    @onclick="OpenNextAction">

                                Open Task

                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">

                            <i class="bi bi-check-circle text-success fs-4"></i>

                            <div class="mt-2">
                                No pending action.
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Patient Notes / Notifications / Fax                  -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Patient Notes -->

        <div class="col-xl-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white
                    d-flex justify-content-between
                    align-items-center">

                    <h5 class="mb-0">
                        Patient Notes
                    </h5>

                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="OpenCommunication">

                        View All

                    </button>

                </div>

                <div class="card-body">

                    @if (Care?.Notes?.Any() == true)
                    {
                        @foreach (var note in Care.Notes
                            .OrderByDescending(x => x.CreatedAt)
                            .Take(3))
                        {
                            <div class="border-bottom pb-3 mb-3">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-2">

                                    <strong>
                                        @note.Subject
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        note.Priority))
                                    {
                                        <span class="badge @GetPriorityClass(note.Priority)">
                                            @note.Priority
                                        </span>
                                    }

                                </div>

                                <div class="small text-muted mt-1">

                                    @note.CreatedBy
                                    ·
                                    @note.CreatedAt.ToString("MM/dd/yyyy")

                                </div>

                                @if (!string.IsNullOrWhiteSpace(note.Content))
                                {
                                    <div class="small mt-2">
                                        @note.Content
                                    </div>
                                }

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-3">
                            No patient notes.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Active Alerts -->

        <div class="col-xl-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white
                    d-flex justify-content-between
                    align-items-center">

                    <h5 class="mb-0">
                        Active Alerts
                    </h5>

                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="OpenOrdersCare">

                        View Details

                    </button>

                </div>

                <div class="card-body">

                    @if (ActiveNotifications.Any())
                    {
                        @foreach (var notification in
                            ActiveNotifications.Take(3))
                        {
                            <div class="border-bottom pb-3 mb-3">

                                <div class="d-flex
                                    justify-content-between
                                    gap-2">

                                    <strong class="small">
                                        @notification.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        notification.Severity))
                                    {
                                        <span class="badge @GetNotificationBadgeClass(notification.Severity)">
                                            @notification.Severity
                                        </span>
                                    }

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    notification.PatientName))
                                {
                                    <div class="small text-muted mt-1">
                                        @notification.PatientName
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    notification.Message))
                                {
                                    <div class="small mt-1">
                                        @notification.Message
                                    </div>
                                }

                                @if (notification.DueDate.HasValue)
                                {
                                    <div class="small text-muted mt-1">
                                        Due
                                        @notification.DueDate.Value
                                        .ToString("MM/dd/yyyy")
                                    </div>
                                }

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">

                            <i class="bi bi-check-circle text-success fs-4"></i>

                            <div class="mt-2 small">
                                No active alerts.
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Fax Information -->

        <div class="col-xl-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white
                    d-flex justify-content-between
                    align-items-center">

                    <h5 class="mb-0">
                        Fax Information
                    </h5>

                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="OpenOrdersCare">

                        View

                    </button>

                </div>

                <div class="card-body">

                    @if (HasFaxInformation)
                    {
                        <div class="mb-3">

                            <div class="small text-muted">
                                Referring Provider
                            </div>

                            <div class="fw-semibold">
                                @Care!.Fax.ReferringProvider
                            </div>

                        </div>


                        <div class="mb-3">

                            <div class="small text-muted">
                                Fax Number
                            </div>

                            <div>
                                @Care.Fax.FaxNumber
                            </div>

                        </div>


                        <div class="mb-3">

                            <div class="small text-muted">
                                Organization
                            </div>

                            <div>
                                @Care.Fax.Organization
                            </div>

                        </div>


                        @if (Care.Fax.Verified)
                        {
                            <span class="badge bg-success">
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Needs Verification
                            </span>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-3">
                            No fax information available.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Recent Activity                                       -->
    <!-- ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                Recent Activity
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Workflow?.RecentActivities?.Any() == true)
            {
                <div class="list-group list-group-flush">

                    @foreach (var activity in Workflow.RecentActivities)
                    {
                        <div class="list-group-item">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3">

                                <div>

                                    <strong>
                                        @activity.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        activity.Description))
                                    {
                                        <div class="small text-muted mt-1">
                                            @activity.Description
                                        </div>
                                    }

                                    <div class="small text-muted mt-1">

                                        @if (!string.IsNullOrWhiteSpace(
                                            activity.PerformedBy))
                                        {
                                            @activity.PerformedBy
                                            <span> · </span>
                                        }

                                        @activity.ActivityDate
                                        .ToString("MM/dd/yyyy hh:mm tt")

                                    </div>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    activity.ActivityType))
                                {
                                    <span class="badge bg-secondary">
                                        @activity.ActivityType
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No recent activity.
                </div>
            }

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Patient Summary                                       -->
    <!-- ===================================================== -->
    @if (Workflow?.Summary is not null)
    {
        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Patient Summary
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Summary.PrimaryDiagnosis))
                    {
                        <div class="col-md-6 col-lg-4">

                            <div class="small text-muted">
                                Primary Diagnosis
                            </div>

                            <div class="fw-semibold">
                                @Workflow.Summary.PrimaryDiagnosis
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Summary.Insurance))
                    {
                        <div class="col-md-6 col-lg-4">

                            <div class="small text-muted">
                                Insurance
                            </div>

                            <div class="fw-semibold">
                                @Workflow.Summary.Insurance
                            </div>

                        </div>
                    }


                    @if (Workflow.Summary.SocDate.HasValue)
                    {
                        <div class="col-md-6 col-lg-4">

                            <div class="small text-muted">
                                SOC Date
                            </div>

                            <div class="fw-semibold">
                                @Workflow.Summary.SocDate.Value
                                .ToString("MM/dd/yyyy")
                            </div>

                        </div>
                    }


                    @if (Workflow.Summary.AuthorizedVisits > 0)
                    {
                        <div class="col-md-6 col-lg-4">

                            <div class="small text-muted">
                                Authorized Visits
                            </div>

                            <div class="fw-semibold">
                                @Workflow.Summary.AuthorizedVisits
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Summary.Address))
                    {
                        <div class="col-md-6 col-lg-4">

                            <div class="small text-muted">
                                Address
                            </div>

                            <div class="fw-semibold">
                                @Workflow.Summary.Address
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                        Workflow.Summary.PhoneNumber))
                    {
                        <div class="col-md-6 col-lg-4">

                            <div class="small text-muted">
                                Phone
                            </div>

                            <div class="fw-semibold">
                                @Workflow.Summary.PhoneNumber
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public Guid PatientId { get; set; }


    [Parameter]
    public PatientWorkflowDto? Workflow { get; set; }


    [Parameter]
    public PatientCareProfileDto? Care { get; set; }


    [Parameter]
    public IReadOnlyList<UserNotificationDto> Notifications { get; set; } = [];


    [Parameter]
    public EventCallback<string> OnChangeTab { get; set; }


    private IEnumerable<UserNotificationDto> ActiveNotifications =>
        Notifications
            .Where(x => !x.IsRead)
            .OrderBy(x => x.DueDate ?? DateTime.MaxValue)
            .ThenByDescending(x => x.CreatedAt);


    private WorkflowStageDto? CurrentStage =>
        Workflow?.WorkflowStages?
            .Where(x => x.Status == WorkflowStatus.Current)
            .OrderBy(x => x.Sequence)
            .FirstOrDefault();


    private bool HasNextAction =>
        Workflow?.NextAction is not null &&
        Workflow.NextAction.TaskId != Guid.Empty &&
        !string.IsNullOrWhiteSpace(
            Workflow.NextAction.Title);


    private bool HasFaxInformation =>
        Care?.Fax is not null &&
        (
            !string.IsNullOrWhiteSpace(
                Care.Fax.ReferringProvider) ||

            !string.IsNullOrWhiteSpace(
                Care.Fax.FaxNumber) ||

            !string.IsNullOrWhiteSpace(
                Care.Fax.Organization)
        );


    private async Task OpenInsurance()
    {
        await OnChangeTab.InvokeAsync("Insurance");
    }


    private async Task OpenClinical()
    {
        await OnChangeTab.InvokeAsync("Clinical");
    }


    private async Task OpenCommunication()
    {
        await OnChangeTab.InvokeAsync("Communication");
    }


    private async Task OpenOrdersCare()
    {
        await OnChangeTab.InvokeAsync("Orders & Care");
    }


    private async Task OpenNextAction()
    {
        if (Workflow?.NextAction is null)
            return;

        if (string.IsNullOrWhiteSpace(
            Workflow.NextAction.PageRoute))
            return;

        await OnChangeTab.InvokeAsync(
            Workflow.NextAction.PageRoute);
    }


    private static string GetWorkflowStatusClass(
        WorkflowStatus status)
    {
        return status switch
        {
            WorkflowStatus.Completed =>
                "badge bg-success mb-3",

            WorkflowStatus.Current =>
                "badge bg-primary mb-3",

            _ =>
                "badge bg-secondary mb-3"
        };
    }


    private static string GetWorkflowStatusText(
        WorkflowStatus status)
    {
        return status switch
        {
            WorkflowStatus.Completed => "Completed",

            WorkflowStatus.Current => "Current",

            _ => "Pending"
        };
    }


    private static string GetPatientStatusBadgeClass(
        string status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "active" =>
                "bg-success",

            "completed" =>
                "bg-success",

            "on hold" =>
                "bg-warning text-dark",

            "onhold" =>
                "bg-warning text-dark",

            "cancelled" =>
                "bg-danger",

            "archived" =>
                "bg-secondary",

            _ =>
                "bg-secondary"
        };
    }


    private static string GetPriorityClass(
        string priority)
    {
        return priority?.Trim().ToLowerInvariant() switch
        {
            "high" =>
                "bg-danger",

            "medium" =>
                "bg-warning text-dark",

            "low" =>
                "bg-success",

            _ =>
                "bg-secondary"
        };
    }


    private static string GetNotificationBadgeClass(
        string severity)
    {
        return severity?.Trim().ToLowerInvariant() switch
        {
            "critical" =>
                "bg-danger",

            "warning" =>
                "bg-warning text-dark",

            "info" =>
                "bg-info text-dark",

            _ =>
                "bg-secondary"
        };
    }

}