@using CCAP.Web.Features.Tracker.PatientWorkflow.Models
@inject NavigationManager Navigation

<div class="overview-tab">

    <!-- Top summary cards -->
    <div class="row g-4">

        <!-- Needs Attention -->
        <div class="col-xl-5">
            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">Needs Attention</h5>
                </div>

                <div class="card-body">

                    @if (NeedsAttention.Any())
                    {
                        <ul class="list-group list-group-flush">

                            @foreach (var item in NeedsAttention)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-start">

                                    <div class="pe-3">
                                        <strong>@item.Title</strong>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="small text-muted mt-1">
                                                @item.Description
                                            </div>
                                        }
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary flex-shrink-0"
                                            @onclick="() => OpenTab(item.Tab)">
                                        Open
                                    </button>

                                </li>
                            }

                        </ul>
                    }
                    else
                    {
                        <div class="text-success py-3">
                            <i class="bi bi-check-circle me-2"></i>
                            No urgent items.
                        </div>
                    }

                </div>
            </div>
        </div>


        <!-- Next Action -->
        <div class="col-xl-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">Next Action</h5>
                </div>

                <div class="card-body">

                    @if (HasNextAction && !Workflow!.NextAction!.IsOverdue)
                    {
                        <h5 class="mb-2">
                            @Workflow.NextAction.Title
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(Workflow.NextAction.Description))
                        {
                            <p class="text-muted mb-3">
                                @Workflow.NextAction.Description
                            </p>
                        }

                        <div class="small text-muted mb-3">
                            Due: @Workflow.NextAction.DueDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                        </div>

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="OpenNextAction">
                            Open
                        </button>
                    }
                    else if (HasNextAction && Workflow!.NextAction!.IsOverdue)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-exclamation-circle text-danger fs-2"></i>
                            <div class="mt-2 fw-semibold">Resolve the overdue item above</div>
                            <div class="small text-muted">The overdue task is shown under Needs Attention.</div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-success py-4">
                            <i class="bi bi-check-circle fs-2"></i>
                            <div class="mt-2">No upcoming action.</div>
                        </div>
                    }

                </div>
            </div>

        </div>


        <!-- Current Stage -->
        <div class="col-xl-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">Current Workflow</h5>
                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(CurrentStageText))
                    {
                        <div class="mb-3">

                            <div class="small text-muted">
                                Current Stage
                            </div>

                            <div class="fw-semibold">
                                @CurrentStageText
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(WorkflowStatusText))
                    {
                        <div>

                            <div class="small text-muted">
                                Status
                            </div>

                            <span class="badge @WorkflowStatusClass">
                                @WorkflowStatusText
                            </span>

                        </div>
                    }

                </div>
            </div>

        </div>

    </div>


    <!-- Unified Patient Notes -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Patient Notes</h5>
                <small class="text-muted">Notes from referral, communication, care, and compliance in one chronological view.</small>
            </div>
            <span class="badge bg-light text-dark">@NoteFeed.Count</span>
        </div>
        <div class="card-body">
            @if (NoteFeed.Count == 0)
            {
                <div class="text-muted py-3">No patient notes have been recorded.</div>
            }
            else
            {
                <div class="patient-notes-feed">
                    @foreach (var note in NoteFeed)
                    {
                        <article class="patient-note-entry">
                            <div class="patient-note-marker"><i class="@note.Icon"></i></div>
                            <div class="patient-note-content">
                                <div class="patient-note-header">
                                    <div>
                                        <div class="fw-semibold">@note.Title</div>
                                        <span class="patient-note-source">@note.Source</span>
                                    </div>
                                    <time class="small text-muted">@note.Date.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</time>
                                </div>
                                <div class="patient-note-text">@note.Content</div>
                                @if (!string.IsNullOrWhiteSpace(note.Author))
                                {
                                    <div class="small text-muted mt-2"><i class="bi bi-person me-1"></i>@note.Author</div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>

</div>


@code {

    [Parameter]
    public Guid PatientId { get; set; }

    [Parameter]
    public PatientWorkflowDto? Workflow { get; set; }

    [Parameter]
    public PatientCareProfileDto? Care { get; set; }

    [Parameter]
    public EventCallback<string> OnChangeTab { get; set; }


    private sealed record NoteFeedItem(
        DateTime Date,
        string Source,
        string Title,
        string Content,
        string Author,
        string Icon);

    private List<NoteFeedItem> NoteFeed
    {
        get
        {
            var items = new List<NoteFeedItem>();

            if (!string.IsNullOrWhiteSpace(Workflow?.ReferralNotes))
                items.Add(new NoteFeedItem(Workflow.ReferralDate ?? DateTime.MinValue, "Referral", "Referral Notes", Workflow.ReferralNotes, "", "bi bi-file-earmark-text"));

            if (!string.IsNullOrWhiteSpace(Workflow?.InternalNotes))
                items.Add(new NoteFeedItem(Workflow.ReferralDate ?? DateTime.MinValue, "Referral / Internal", "Internal Referral Notes", Workflow.InternalNotes, "", "bi bi-shield-lock"));

            foreach (var note in Care?.Notes ?? [])
            {
                if (!string.IsNullOrWhiteSpace(note.Content))
                    items.Add(new NoteFeedItem(note.CreatedAt, "Communication", string.IsNullOrWhiteSpace(note.Subject) ? "Communication Note" : note.Subject, note.Content, note.CreatedBy, "bi bi-chat-left-text"));
            }

            foreach (var log in Care?.CareLogs ?? [])
            {
                if (!string.IsNullOrWhiteSpace(log.Notes))
                    items.Add(new NoteFeedItem(log.RecordedAt, "Care", string.IsNullOrWhiteSpace(log.Item) ? "Care Log" : log.Item, log.Notes!, log.RecordedBy, "bi bi-clipboard2-pulse"));
            }

            foreach (var item in Workflow?.ComplianceItems ?? [])
            {
                if (!string.IsNullOrWhiteSpace(item.Description) && item.CompletedAt.HasValue)
                    items.Add(new NoteFeedItem(item.CompletedAt.Value, "Compliance", item.RequirementName, item.Description, item.CompletedByUserName, "bi bi-clipboard-check"));
            }

            return items.Where(x => x.Date != DateTime.MinValue).OrderByDescending(x => x.Date).ToList();
        }
    }

    private bool HasNextAction =>
        Workflow?.NextAction is not null &&
        Workflow.NextAction.TaskId != Guid.Empty;


    private IEnumerable<(string Title, string Description, string Tab)> NeedsAttention
    {
        get
        {
            if (Workflow?.NextAction is null || Workflow.NextAction.TaskId == Guid.Empty)
                return Array.Empty<(string, string, string)>();

            // Needs Attention is reserved for overdue work. This keeps it
            // distinct from the normal Next Action card.
            if (!Workflow.NextAction.IsOverdue)
                return Array.Empty<(string, string, string)>();

            return new[]
            {
                (
                    $"Overdue: {Workflow.NextAction.Title}",
                    Workflow.NextAction.Description,
                    TabFor(Workflow.NextAction.Title)
                )
            };
        }
    }

    private WorkflowStageDto? CurrentStage
    {
        get
        {
            return Workflow?.WorkflowStages?
                .OrderBy(x => x.Sequence)
                .FirstOrDefault(x => x.Status == WorkflowStatus.Current);
        }
    }

    private string CurrentStageText =>
        CurrentStage?.StageName ?? "Workflow Complete";

    private string WorkflowStatusText =>
        CurrentStage is not null ? "Current" : "Completed";

    private string WorkflowStatusClass =>
        CurrentStage is not null ? "bg-primary" : "bg-success";

    private async Task OpenTab(string tab)
    {
        if (string.IsNullOrWhiteSpace(tab))
        {
            return;
        }

        await OnChangeTab.InvokeAsync(tab);
    }


    private async Task OpenNextAction()
    {
        if (!HasNextAction)
            return;

        var nextAction = Workflow!.NextAction!;
        var tab = TabFor(nextAction.Title);

        // A workflow task can provide a dedicated route. If it does not,
        // open the CCAP tab that owns the action instead of doing nothing.
        if (!string.IsNullOrWhiteSpace(nextAction.PageRoute)
            && !nextAction.PageRoute.Equals("/tracker/patient", StringComparison.OrdinalIgnoreCase)
            && !nextAction.PageRoute.Equals($"/tracker/patient/{PatientId}", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(nextAction.PageRoute);
            return;
        }

        await OpenTab(tab);
    }


    private static string TabFor(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return "Compliance";
        }

        if (title.Contains("Insurance", StringComparison.OrdinalIgnoreCase)
            || title.Contains("Authorization", StringComparison.OrdinalIgnoreCase)
            || title.Contains("Payor", StringComparison.OrdinalIgnoreCase))
        {
            // Insurance is now handled inside Compliance; there is no
            // standalone Insurance tab.
            return "Compliance";
        }

        if (title.Contains(
                "Order",
                StringComparison.OrdinalIgnoreCase)
            ||
            title.Contains(
                "POC",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Orders & Care";
        }

        if (title.Contains(
                "Communication",
                StringComparison.OrdinalIgnoreCase)
            ||
            title.Contains(
                "Call",
                StringComparison.OrdinalIgnoreCase)
            ||
            title.Contains(
                "Email",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Communication";
        }

        /*
         * SOC/F2F and other required workflow confirmations
         * belong in Compliance.
         */
        return "Compliance";
    }


    private static string StageClass(string status)
    {
        if (string.Equals(
                status,
                "Completed",
                StringComparison.OrdinalIgnoreCase))
        {
            return "bg-success";
        }

        if (string.Equals(
                status,
                "InProgress",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "In Progress",
                StringComparison.OrdinalIgnoreCase))
        {
            return "bg-primary";
        }

        if (string.Equals(
                status,
                "Pending",
                StringComparison.OrdinalIgnoreCase))
        {
            return "bg-secondary";
        }

        return "bg-secondary";
    }
}