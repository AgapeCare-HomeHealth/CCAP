@using CCAP.Web.Features.Tracker.PatientWorkflow.Models

<div class="workflow-card">

    <div class="workflow-header">

        <h5>Patient Workflow</h5>

        <small>
            Track the patient's current progress.
        </small>

    </div>

    <div class="workflow-container">

        @for (int i = 0; i < Stages.Count; i++)
        {
            var stage = Stages[i];

            <div class="workflow-step">

                <div class="circle @GetCircleClass(stage.Status)">

                    @switch (stage.Status)
                    {
                        case WorkflowStatus.Completed:
                            <i class="bi bi-check-lg"></i>
                            break;

                        case WorkflowStatus.Current:
                            <i class="bi bi-hourglass-split"></i>
                            break;

                        case WorkflowStatus.NotApplicable:
                            <i class="bi bi-dash"></i>
                            break;

                        default:
                            <i class="bi bi-circle"></i>
                            break;
                    }

                </div>

                <div class="workflow-title">

                    @stage.StageName

                </div>

                <div class="workflow-status">
                    @stage.Description
                </div>

                <span class="badge rounded-pill @GetStageBadgeClass(stage.Status)">
                    @GetStageStatusLabel(stage.Status)
                </span>

                @if (stage.CompletedDate.HasValue)
                {
                    <div class="workflow-date">

                        @stage.CompletedDate.Value.ToString("MM/dd/yyyy")

                    </div>
                }

            </div>

            @if (i < Stages.Count - 1)
            {
                <div class="workflow-line @(Stages[i].Status == WorkflowStatus.Completed ? "completed" : "")">
                </div>
            }
        }

    </div>

</div>

@code {

    [Parameter]
    public List<WorkflowStageDto> Stages { get; set; } = new();

    private static string GetStageBadgeClass(WorkflowStatus status) => status switch
    {
        WorkflowStatus.Completed => "bg-success",
        WorkflowStatus.Current => "bg-primary",
        WorkflowStatus.NotApplicable => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private static string GetStageStatusLabel(WorkflowStatus status) => status switch
    {
        WorkflowStatus.Completed => "Complete",
        WorkflowStatus.Current => "In Progress",
        WorkflowStatus.NotApplicable => "N/A · Complete",
        _ => "Pending"
    };

    private static string GetCircleClass(WorkflowStatus status)
    {
        return status switch
        {
            WorkflowStatus.Completed => "completed",
            WorkflowStatus.Current => "current",
            WorkflowStatus.NotApplicable => "not-applicable",
            _ => "pending"
        };
    }

}