@using CCAP.Web.Features.Tracker.ReferralIntake.Models

<div class="step-card">

    <div class="step-title">

        <h4>Referral Information</h4>

        <p>
            Enter the referral, insurance, physician and clinical information.
        </p>

    </div>

    <!-- ================= Referral Details ================= -->

    <h5 class="section-heading">
        Referral Details
    </h5>

    <div class="row g-4">

        <!-- Referral Number -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Number
                <span class="text-danger">*</span>
            </label>

            <input type="text"
                   class="form-control"
                   @bind="Model.ReferralNumber"
                   placeholder="Enter referral number" />

            <div class="form-text">
                Referral number provided by the referring source.
            </div>

        </div>

        <!-- Referral Date -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Date
            </label>

            <input type="date"
                   class="form-control"
                   @bind="Model.ReferralDate" />

        </div>

        <!-- Referral Source -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Source
            </label>

            <select class="form-select"
                    @bind="Model.ReferralSource">

                <option>Hospital</option>
                <option>Physician Office</option>
                <option>Clinic</option>
                <option>Insurance</option>

            </select>

        </div>

        <!-- Priority -->
        <div class="col-md-4">

            <label class="form-label">
                Priority
            </label>

            <select class="form-select"
                    @bind="Model.Priority">

                <option>Routine</option>
                <option>Urgent</option>
                <option>STAT</option>

            </select>

        </div>

    </div>

    <hr />

    <!-- ================= Insurance ================= -->

    <h5 class="section-heading">

        Insurance Information

    </h5>

    <div class="row g-4">

        <div class="col-md-4">

            <label class="form-label">

                Primary Insurance

            </label>

            <select class="form-select"
                    @bind="Model.PrimaryInsurance">

                <option>Medicare</option>
                <option>Medicaid</option>
                <option>Blue Cross</option>
                <option>Aetna</option>

            </select>

        </div>

        <div class="col-md-4">

            <label class="form-label">

                Member ID

            </label>

            <input class="form-control"
                   @bind="Model.InsuranceMemberId" />

        </div>

        <div class="form-check mt-4">

            <input class="form-check-input"
                   type="checkbox"
                   id="authorizationRequired"
                   @bind="Model.AuthorizationRequired" />

            <label class="form-check-label"
                   for="authorizationRequired">

                Authorization Required

            </label>

        </div>
    </div>

    <hr />

    <!-- ================= Physician ================= -->

    <h5 class="section-heading">

        Referring Physician

    </h5>

    <div class="row g-4">

        <div class="col-md-6">

            <label class="form-label">

                Physician

            </label>

            <input class="form-control"
                   @bind="Model.ReferringPhysician" />

        </div>

        <div class="col-md-6">

            <label class="form-label">

                Phone Number

            </label>

            <input class="form-control"
                   @bind="Model.PhysicianPhone" />

        </div>

    </div>

    <hr />

    <!-- ================= Clinical ================= -->

    <h5 class="section-heading">

        Clinical Information

    </h5>

    <div class="row g-4">

        <div class="col-md-6">

            <label class="form-label">

                Primary Diagnosis

            </label>

            <input class="form-control"
                   @bind="Model.PrimaryDiagnosis" />

        </div>

        <div class="col-md-6">

            <label class="form-label">

                Secondary Diagnosis

            </label>

            <input class="form-control"
                   @bind="Model.SecondaryDiagnosis" />

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-12">

            <label class="form-label">

                Ordered Services

            </label>

            <div class="service-grid">

                @foreach (var service in ServiceOptions)
                {
                    <label class="service-item">

                        <input type="checkbox"
                               checked="@Model.OrderedServices.Contains(service)"
                               @onchange="e =>
                                                            ToggleService(
                                                                service,
                                                                e.Value)" />

@service

</label>
                }

            </div>

        </div>

    </div>

    <hr />

    <!-- ================= Notes ================= -->

    <h5 class="section-heading">

        Referral Notes

    </h5>

    <textarea class="form-control"
              rows="5"
              placeholder="Additional referral notes..."
              @bind="Model.ReferralNotes">
    </textarea>

</div>


@code {

    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    private static readonly string[] ServiceOptions =
    [
        "Skilled Nursing",
        "Physical Therapy",
        "Occupational Therapy",
        "Speech Therapy",
        "Home Health Aide"
    ];

    private void ToggleService(
        string service,
        object? value)
    {
        var selected =
            value is bool b && b;

        if (selected)
        {
            if (!Model.OrderedServices.Contains(service))
            {
                Model.OrderedServices.Add(service);
            }
        }
        else
        {
            Model.OrderedServices.Remove(service);
        }
    }
}