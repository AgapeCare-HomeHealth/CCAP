@using CCAP.Web.Features.Admin.LookupOptions.Models
@using CCAP.Web.Features.Admin.LookupOptions.Services
@inject LookupOptionService LookupService
﻿@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using CCAP.Web.Common.Validation

<div class="step-card">

    <div class="step-title">

        <h4>Referral Information</h4>

        <p>
            Enter the referral information and required intake details.
        </p>

    </div>

    <!-- ================= Referral Details ================= -->

    <h5 class="section-heading">
        Referral Details
    </h5>

    <div class="row g-4">

        <!-- Referral Date -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Date
            </label>

            <input type="date"
                   class="form-control"
                   @bind="Model.ReferralDate" />

        </div>

        <!-- Type of Referral -->
        <div class="col-md-4">

            <label class="form-label">
                Type of Referral
            </label>

            <select class="form-select"
                    @bind="Model.ReferralType">
                <option value="">Select Referral Type</option>
                @foreach (var option in ReferralTypes)
                {
                    <option value="@option">@option</option>
                }
            </select>

        </div>

        <!-- Referral Channel -->
        <div class="col-md-4">

            <label class="form-label">Referral Source</label>
            <select class="form-select" @bind="Model.ReferralSource">
                <option value="">Select Referral Source</option>
                @foreach (var option in ReferralChannels)
                {
                    <option value="@option">@option</option>
                }
            </select>

        </div>

    </div>


    <hr />

    <!-- ================= Insurance ================= -->

    <h5 class="section-heading">
        Insurance Information
    </h5>

    <!-- Insurance Row 1 -->
    <div class="row g-4">

        <!-- Primary Insurance -->
        <div class="col-md-6">

            <label class="form-label">
                Primary Insurance
            </label>

            <select class="form-select"
                    @bind="Model.PrimaryInsurance">

                <option value="">
                    Select Insurance
                </option>

                @foreach (var option in Insurances)
                {
                    <option value="@option.DisplayName">@option.DisplayName</option>
                }

            </select>

        </div>

        <!-- Member ID -->
        <div class="col-md-6">

            <label class="form-label">
                Member ID
            </label>

            <input class="form-control"
                   @bind="Model.InsuranceMemberId" />

        </div>

    </div>

    <!-- Pre-authorization status -->
    <div class="mt-4">
        <label class="form-label" for="preAuthStatus">PRE AUTH</label>
        <select id="preAuthStatus" class="form-select" @bind="Model.PreAuthStatus">
            <option value="">Select PRE AUTH</option>
            <option value="YES">YES</option>
            <option value="NO">NO</option>
            <option value="N/A">N/A</option>
        </select>
    </div>

    <!-- Authorization details -->
    <div class="row g-4 mt-1">
        <div class="col-md-6">
            <label class="form-label">Authorization Date</label>
            <input type="date"
                   class="form-control"
                   @bind="Model.AuthorizationDate"
                   disabled="@(Model.PreAuthStatus != "YES")" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Number of Approved Visits</label>
            <input type="number"
                   min="0"
                   class="form-control"
                   @bind="Model.ApprovedVisits" />
        </div>
    </div>

    <hr />

    <!-- ================= Physician ================= -->

    <h5 class="section-heading">
        @* Referring Physician *@
        Primary Care Physician (PCP)
    </h5>

    <div class="row g-4">

        <div class="col-md-6">
            <label class="form-label">Primary Care Physician</label>
            <input class="form-control" @bind="Model.ReferringPhysician" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Phone Number</label>
            <input class="form-control" @bind="Model.PhysicianPhone" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Fax Number</label>
            <input class="form-control" @bind="Model.PhysicianFax" />
        </div>

        <div class="col-md-4">
            <label class="form-label">NPI</label>
            <input class="form-control" @bind="Model.PhysicianNpi" />
        </div>

        <div class="col-md-4">
            <label class="form-label">PCOS Registered</label>
            <select class="form-select" @bind="Model.PcosRegistered">
                <option value="">Not recorded</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>
        </div>

    </div>

    <hr />

    <!-- ================= Clinical ================= -->

    <h5 class="section-heading">
        Clinical Information
    </h5>

    <div class="row g-4">

        <!-- Primary Diagnosis -->
        <div class="col-md-6">

            <label class="form-label">
                Primary Diagnosis
            </label>

            <input class="form-control"
                   @bind="Model.PrimaryDiagnosis" />

        </div>

        <!-- Secondary Diagnosis -->
        <div class="col-md-6">

            <label class="form-label">
                Secondary Diagnosis
            </label>

            <input class="form-control"
                   @bind="Model.SecondaryDiagnosis" />

        </div>

    </div>

    <!-- Ordered Services -->
    <div class="row mt-4">

        <div class="col-md-12">

            <label class="form-label">
                Ordered Services
            </label>

            <div class="service-grid">

                @foreach (var service in ServiceOptions)
                {
                    <label class="service-item">

                        <input type="checkbox"
                               checked="@Model.OrderedServices.Contains(service)"
                               @onchange="e =>
                                                           ToggleService(
                                                               service,
                                                               e.Value)" />

@service

</label>
                }

            </div>

        </div>

    </div>

    <hr />

    <!-- ================= Notes ================= -->

    <h5 class="section-heading">
        Referral Notes
    </h5>

    <textarea class="form-control"
              rows="5"
              placeholder="Additional referral notes..."
              @bind="Model.ReferralNotes">
    </textarea>

</div>


@code {
    private List<LookupOptionDto> Insurances = [];

    private static readonly string[] ReferralTypes =
    [
        "Re-Cert",
        "ROC (Resumption of Care)",
        "New (New Patient)",
        "Repeat"
    ];

    private static readonly string[] ReferralChannels =
    [
        "Allscripts",
        "Careport",
        "Direct-Fax",
        "Direct-email",
        "Direct-phone",
        "Direct-in-person"
    ];
    protected override async Task OnInitializedAsync()
    {
        Insurances = await LookupService.GetAsync("Insurance", true);
    }


    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    private static readonly string[] ServiceOptions = ReferralServiceOptions.All;


    public bool ValidateStep() => true;

    private void ToggleService(
        string service,
        object? value)
    {
        var selected =
            value is bool b && b;

        if (selected)
        {
            if (!Model.OrderedServices.Contains(service))
            {
                Model.OrderedServices.Add(service);
            }
        }
        else
        {
            Model.OrderedServices.Remove(service);
        }
    }
}