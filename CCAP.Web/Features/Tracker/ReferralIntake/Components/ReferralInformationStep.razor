@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using CCAP.Web.Common.Validation

<div class="step-card">

    <div class="step-title">

        <h4>Referral Information</h4>

        <p>
            Enter the referral, insurance, physician and clinical information.
        </p>

    </div>

    <!-- ================= Referral Details ================= -->

    <h5 class="section-heading">
        Referral Details
    </h5>

    <div class="row g-4">

        <!-- Referral Number -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Number
                <span class="text-danger">*</span>
            </label>

            <input type="text"
                   class="@ReferralNumberInputClass"
                   @bind="Model.ReferralNumber"
                   @onblur="ValidateReferralNumber"
                   placeholder="Enter referral number" />

            @if (!string.IsNullOrWhiteSpace(ReferralNumberError))
            {
                <div class="invalid-feedback">
                    @ReferralNumberError
                </div>
            }

            <div class="form-text">
                Referral number provided by the referring source.
            </div>

        </div>

        <!-- Referral Date -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Date
            </label>

            <input type="date"
                   class="form-control"
                   @bind="Model.ReferralDate" />

        </div>

        <!-- Referral Source -->
        <div class="col-md-4">

            <label class="form-label">
                Referral Source
            </label>

            <select class="form-select"
                    @bind="Model.ReferralSource">

                <option value="">
                    Select Referral Source
                </option>

                <option value="Hospital">
                    Hospital
                </option>

                <option value="Physician Office">
                    Physician Office
                </option>

                <option value="Clinic">
                    Clinic
                </option>

                <option value="Insurance">
                    Insurance
                </option>

            </select>

        </div>

        <!-- Priority -->
        <div class="col-md-4">

            <label class="form-label">
                Priority
            </label>

            <select class="form-select"
                    @bind="Model.Priority">

                <option value="Routine">
                    Routine
                </option>

                <option value="Urgent">
                    Urgent
                </option>

                <option value="STAT">
                    STAT
                </option>

            </select>

        </div>

    </div>

    <hr />

    <!-- ================= Insurance ================= -->

    <h5 class="section-heading">
        Insurance Information
    </h5>

    <!-- Insurance Row 1 -->
    <div class="row g-4">

        <!-- Primary Insurance -->
        <div class="col-md-6">

            <label class="form-label">
                Primary Insurance
            </label>

            <select class="form-select"
                    @bind="Model.PrimaryInsurance">

                <option value="">
                    Select Insurance
                </option>

                <option value="Medicare">
                    Medicare
                </option>

                <option value="Medicaid">
                    Medicaid
                </option>

                <option value="Blue Cross">
                    Blue Cross
                </option>

                <option value="Aetna">
                    Aetna
                </option>

            </select>

        </div>

        <!-- Member ID -->
        <div class="col-md-6">

            <label class="form-label">
                Member ID
            </label>

            <input class="form-control"
                   @bind="Model.InsuranceMemberId" />

        </div>

    </div>

    <!-- Insurance Row 2 -->
    <div class="row g-4 mt-1">

        <!-- Authorization Date -->
        <div class="col-md-6">

            <label class="form-label">
                Authorization Date
            </label>

            <input type="date"
                   class="form-control"
                   @bind="Model.AuthorizationDate" />

        </div>

        <!-- Number of Approved Visits -->
        <div class="col-md-6">

            <label class="form-label">
                Number of Approved Visits
            </label>

            <input type="number"
                   min="0"
                   class="form-control"
                   @bind="Model.ApprovedVisits" />

        </div>

    </div>

    <!-- Authorization Required -->
    <div class="mt-4">

        <div class="form-check">

            <input class="form-check-input"
                   type="checkbox"
                   id="authorizationRequired"
                   @bind="Model.AuthorizationRequired" />

            <label class="form-check-label"
                   for="authorizationRequired">

                Authorization Required

            </label>

        </div>

    </div>

    <hr />

    <!-- ================= Physician ================= -->

    <h5 class="section-heading">
        @* Referring Physician *@
        Primary Care Physician (PCP)
    </h5>

    <div class="row g-4">

        <!-- Physician -->
        <div class="col-md-6">

            <label class="form-label">
                Physician
            </label>

            <input class="form-control"
                   @bind="Model.ReferringPhysician" />

        </div>

        <!-- Phone -->
        <div class="col-md-6">

            <label class="form-label">
                Phone Number
            </label>

            <input class="form-control"
                   @bind="Model.PhysicianPhone" />

        </div>

    </div>

    <hr />

    <!-- ================= Clinical ================= -->

    <h5 class="section-heading">
        Clinical Information
    </h5>

    <div class="row g-4">

        <!-- Primary Diagnosis -->
        <div class="col-md-6">

            <label class="form-label">
                Primary Diagnosis
            </label>

            <input class="form-control"
                   @bind="Model.PrimaryDiagnosis" />

        </div>

        <!-- Secondary Diagnosis -->
        <div class="col-md-6">

            <label class="form-label">
                Secondary Diagnosis
            </label>

            <input class="form-control"
                   @bind="Model.SecondaryDiagnosis" />

        </div>

    </div>

    <!-- Ordered Services -->
    <div class="row mt-4">

        <div class="col-md-12">

            <label class="form-label">
                Ordered Services
            </label>

            <div class="service-grid">

                @foreach (var service in ServiceOptions)
                {
                    <label class="service-item">

                        <input type="checkbox"
                               checked="@Model.OrderedServices.Contains(service)"
                               @onchange="e =>
                                                           ToggleService(
                                                               service,
                                                               e.Value)" />

@service

</label>
                }

            </div>

        </div>

    </div>

    <hr />

    <!-- ================= Notes ================= -->

    <h5 class="section-heading">
        Referral Notes
    </h5>

    <textarea class="form-control"
              rows="5"
              placeholder="Additional referral notes..."
              @bind="Model.ReferralNotes">
    </textarea>

</div>


@code {

    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    private string? ReferralNumberError;

    private static readonly string[] ServiceOptions =
    [
        "Skilled Nursing",
        "Physical Therapy",
        "Occupational Therapy",
        "Speech Therapy",
        "Home Health Aide",
        "Medical Social Work (MSW)"
    ];

    private string ReferralNumberInputClass =>
        string.IsNullOrWhiteSpace(ReferralNumberError)
            ? "form-control"
            : "form-control is-invalid";

    private void ValidateReferralNumber()
    {
        ReferralNumberError =
            string.IsNullOrWhiteSpace(Model.ReferralNumber)
                ? "Referral number is required."
                : null;
    }

    public bool ValidateStep()
    {
        ValidateReferralNumber();

        return string.IsNullOrWhiteSpace(
            ReferralNumberError);
    }

    private void ToggleService(
        string service,
        object? value)
    {
        var selected =
            value is bool b && b;

        if (selected)
        {
            if (!Model.OrderedServices.Contains(service))
            {
                Model.OrderedServices.Add(service);
            }
        }
        else
        {
            Model.OrderedServices.Remove(service);
        }
    }
}