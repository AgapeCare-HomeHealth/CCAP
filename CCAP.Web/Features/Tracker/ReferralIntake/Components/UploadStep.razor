@using Microsoft.AspNetCore.Components.Forms

<div class="step-card">

    <div class="step-title">

        <h4>Upload Referral PDF</h4>


    </div>

    <div class="row g-4">

        <!-- Upload Area -->

        <div class="col-lg-7">

            <div class="upload-card">

                <InputFile id="uploadReferral"
                           class="d-none"
                           OnChange="OnFileSelected" />

                <label for="uploadReferral"
                       class="upload-dropzone">

                    <i class="bi bi-cloud-arrow-up upload-icon"></i>

                    <h5>Drag & Drop Referral PDF Here</h5>

                    <span>or</span>

                    <div class="btn btn-success">

                        Choose File

                    </div>

                </label>

            </div>

        </div>

        <!-- Uploaded File -->

        <div class="col-lg-5">

            <div class="info-card">

                <h5>Uploaded File</h5>

                @if (SelectedFile is null)
                {
                    <div class="empty-file">

                        <i class="bi bi-file-earmark"></i>

                        <span>No file selected.</span>

                    </div>
                }
                else
                {
                    <div class="uploaded-file">

                        <i class="bi bi-file-earmark-fill text-success fs-1"></i>

                        <div class="flex-grow-1">

                            <strong>@SelectedFile.Name</strong>

                            <small class="d-block text-muted">

                                @(Math.Round((double)SelectedFile.Size / 1024 / 1024, 2)) MB

                            </small>

                            <small class="text-success">

                                Uploaded Successfully

                            </small>

                        </div>

                    </div>

                    <hr />

                    <div class="d-flex gap-2 flex-wrap">

                        <button class="btn btn-outline-primary btn-sm">

                            <i class="bi bi-eye"></i>

                            View

                        </button>

                        <label for="uploadReferral"
                               class="btn btn-outline-success btn-sm mb-0">

                            <i class="bi bi-arrow-repeat"></i>

                            Replace

                        </label>

                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="RemoveFile">

                            <i class="bi bi-trash"></i>

                            Remove

                        </button>

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="alert alert-light mt-4">

        <i class="bi bi-info-circle-fill text-success"></i>

        Accepted format: PDF

    </div>

</div>

@code {

    private IBrowserFile? SelectedFile;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
    }

    private void RemoveFile()
    {
        SelectedFile = null;
    }

}