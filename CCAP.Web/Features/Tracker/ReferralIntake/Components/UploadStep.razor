@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using CCAP.Web.Features.Tracker.ReferralIntake.Services
@using CCAP.Web.Features.Admin.LookupOptions.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ReferralIntakeService ReferralIntakeService
@inject LookupOptionService LookupService
@inject Microsoft.Extensions.Logging.ILogger<UploadStep> Logger

<div class="step-card">
    <div class="step-title">
        <h4>Upload Referral PDF</h4>
        <p class="text-muted mb-0">
            Upload a digital or scanned referral. CCAP will extract the information it can find,
            then you can review and correct it before continuing.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="upload-card">
                <InputFile id="uploadReferral"
                           class="d-none"
                           OnChange="OnFileSelected"
                           accept=".pdf,application/pdf" />

                <label for="uploadReferral" class="upload-dropzone">
                    <i class="bi bi-cloud-arrow-up upload-icon"></i>
                    <h5>Choose Referral PDF</h5>
                    <span>Digital PDFs and scanned PDFs are supported</span>
                    <div class="btn btn-success">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i>
                        Choose File
                    </div>
                </label>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="info-card">
                <h5>Uploaded File</h5>

                @if (!HasFileMetadata)
                {
                    <div class="empty-file">
                        <i class="bi bi-file-earmark"></i>
                        <span>No file selected.</span>
                    </div>
                }
                else
                {
                    <div class="uploaded-file">
                        <i class="bi bi-file-earmark-pdf-fill text-danger fs-1"></i>
                        <div class="flex-grow-1">
                            <strong>@Model.ReferralPdfFileName</strong>
                            <small class="d-block text-muted">@FormatFileSize(Model.ReferralPdfSize)</small>
                            <small class="d-block text-muted">@Model.ReferralPdfContentType</small>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex gap-2">
                        <label for="uploadReferral" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-arrow-repeat"></i> Replace
                        </label>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RemoveFile" disabled="@IsExtracting">
                            <i class="bi bi-trash"></i> Remove
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (IsExtracting)
    {
        <div class="alert alert-info mt-4 d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm"></span>
            <span>Reading referral PDF and extracting patient/referral information…</span>
        </div>
    }

    @if (ExtractionCompleted)
    {
        <div class="alert alert-success mt-4">
            <div class="fw-semibold mb-1">
                <i class="bi bi-check-circle me-1"></i>
                Referral information extracted
            </div>
            <div class="small">
                @(LastExtractionUsedOcr
                    ? "OCR was used because this appears to be a scanned referral."
                    : "The PDF text layer was read directly.")
                @if (DetectedFieldCount > 0)
                {
                    <span class="d-block mt-1">Detected <strong>@DetectedFieldCount</strong> referral field(s). Review the populated values before continuing.</span>
                }
                else
                {
                    <span class="d-block mt-1">No structured values were detected. You can still continue and enter the referral manually; name and date of birth are the only required fields.</span>
                }
                @if (!string.IsNullOrWhiteSpace(DetectedForm))
                {
                    <span class="d-block mt-1">Detected form: <strong>@DetectedForm</strong>@(string.IsNullOrWhiteSpace(DetectedFormVersion) ? "" : $" v{DetectedFormVersion}")</span>
                }
                @if (LastExtractionConfidence.HasValue)
                {
                    <span> OCR confidence: @LastExtractionConfidence.Value.ToString("P0")</span>
                }
            </div>
        </div>
    }

    @if (Model.MrnReviewRequired)
    {
        <div class="alert @(Model.MrnReviewCompleted ? "alert-success" : "alert-warning") mt-4">
            <div class="fw-semibold mb-2">
                <i class="bi bi-person-vcard me-1"></i>
                Multiple medical record numbers were found
            </div>
            <p class="small mb-2">
                Different facilities may assign different MRNs. Review the original PDF
                and confirm which identifier belongs to this referral. No MRN is selected automatically.
            </p>
            <div class="mb-2">
                <label class="form-label" for="mrnCandidate">MRN from uploaded document</label>
                <select id="mrnCandidate" class="form-select" @bind="Model.MrnReviewChoice"
                        disabled="@Model.MrnReviewCompleted">
                    <option value="">Select the correct MRN</option>
                    @foreach (var candidate in Model.MrnCandidates)
                    {
                        <option value="@candidate.Value">@candidate.Value — page @candidate.PageNumber (@candidate.Source)</option>
                    }
                    <option value="__manual__">None of these — enter MRN manually in Referral Information</option>
                </select>
            </div>
            @if (Model.MrnReviewCompleted)
            {
                <div class="small"><i class="bi bi-check-circle me-1"></i>
                    MRN reviewed. You can correct it in Referral Information if needed.
                    <button type="button" class="btn btn-link btn-sm" @onclick="ChangeMrnChoice">Change choice</button>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-outline-success btn-sm"
                        disabled="@(string.IsNullOrWhiteSpace(Model.MrnReviewChoice))"
                        @onclick="ConfirmMrnChoice">
                    Confirm MRN review
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-warning mt-4">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @ErrorMessage
        </div>
    }

    <div class="alert alert-light mt-4 mb-0">
        <i class="bi bi-info-circle-fill text-success me-1"></i>
        PDF upload is optional. When uploaded, CCAP extracts available values; you can edit them.
        Only <strong>patient name</strong> and <strong>date of birth</strong> are required to submit a new referral.
        Maximum PDF size: 10 MB.
    </div>
</div>

@code {
    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    private const long MaxFileSize = 10 * 1024 * 1024;
    private string? ErrorMessage;
    private bool IsExtracting;
    private bool ExtractionCompleted;
    private bool LastExtractionUsedOcr;
    private double? LastExtractionConfidence;
    private string? DetectedForm;
    private string? DetectedFormVersion;
    private int DetectedFieldCount;

    private bool HasFileMetadata => !string.IsNullOrWhiteSpace(Model.ReferralPdfFileName);

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        ErrorMessage = null;
        ExtractionCompleted = false;
        LastExtractionConfidence = null;
        Model.MrnReviewChoice = string.Empty;
        Model.MrnCandidates = [];
        Model.MrnReviewRequired = false;
        Model.MrnReviewCompleted = false;

        if (file is null)
            return;

        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "Only PDF files are accepted.";
            ClearFile();
            return;
        }

        if (file.Size <= 0)
        {
            ErrorMessage = "The selected PDF is empty.";
            ClearFile();
            return;
        }

        if (file.Size > MaxFileSize)
        {
            ErrorMessage = "The referral PDF cannot exceed 10 MB.";
            ClearFile();
            return;
        }

        try
        {
            await using var input = file.OpenReadStream(MaxFileSize);
            using var memoryStream = new MemoryStream();
            await input.CopyToAsync(memoryStream);

            Model.ReferralPdfBytes = memoryStream.ToArray();
            Model.ReferralPdfFileName = file.Name;
            Model.ReferralPdfContentType = "application/pdf";
            Model.ReferralPdfSize = file.Size;
            Model.ReferralPdf = file;

            await ExtractValuesAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "The selected PDF could not be read."
                : ex.Message;
        }
    }

    private async Task ExtractValuesAsync()
    {
        if (Model.ReferralPdfBytes is not { Length: > 0 })
            return;

        IsExtracting = true;
        Model.ReferralExtractionInProgress = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var result = await ReferralIntakeService.ExtractReferralPdfAsync(
                Model.ReferralPdfBytes,
                Model.ReferralPdfFileName ?? "referral.pdf");

            await ApplyExtractedValuesAsync(result);
            LastExtractionUsedOcr = result.OcrUsed;
            LastExtractionConfidence = result.Confidence;
            DetectedForm = result.DetectedForm;
            DetectedFormVersion = result.DetectedFormVersion;
            DetectedFieldCount = result.DetectedFieldCount;
            ExtractionCompleted = true;
        }
        catch (Exception ex)
        {
            // The PDF is still retained. Extraction failure should not prevent
            // manual entry because name + DOB remain the only required fields.
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsExtracting = false;
            Model.ReferralExtractionInProgress = false;
        }
    }

    private async Task ApplyExtractedValuesAsync(ReferralDocumentExtractionDto result)
    {
        Model.MrnCandidates = result.MrnCandidates ?? [];
        Model.MrnReviewRequired = result.MrnRequiresReview || Model.MrnCandidates.Count > 1;
        Model.MrnReviewCompleted = false;
        Model.MrnReviewChoice = string.Empty;

        // Only a single explicitly labelled, structurally validated MRN can populate
        // automatically. Conflicting MRNs require an explicit human choice.
        if (!Model.MrnReviewRequired)
            Model.MRN = SetIfPresent(Model.MRN, result.MRN);

        Model.FirstName = SetIfPresent(Model.FirstName, result.FirstName);
        Model.MiddleName = SetIfPresent(Model.MiddleName, result.MiddleName);
        Model.LastName = SetIfPresent(Model.LastName, result.LastName);
        if (!Model.DateOfBirth.HasValue && result.DateOfBirth.HasValue) Model.DateOfBirth = result.DateOfBirth;
        Model.Gender = SetIfPresent(Model.Gender, result.Gender);
        Model.PrimaryPhone = SetIfPresent(Model.PrimaryPhone, result.PrimaryPhone);
        Model.AlternatePhone = SetIfPresent(Model.AlternatePhone, result.AlternatePhone);
        Model.StreetAddress = SetIfPresent(Model.StreetAddress, result.StreetAddress);
        Model.City = SetIfPresent(Model.City, result.City);
        Model.State = SetIfPresent(Model.State, result.State);
        Model.ZipCode = SetIfPresent(Model.ZipCode, result.ZipCode);
        Model.EmergencyContactName = SetIfPresent(Model.EmergencyContactName, result.EmergencyContactName);
        Model.EmergencyContactRelationship = SetIfPresent(Model.EmergencyContactRelationship, result.EmergencyContactRelationship);
        Model.EmergencyContactPhone = SetIfPresent(Model.EmergencyContactPhone, result.EmergencyContactPhone);
        Model.ReferralNumber = SetIfPresent(Model.ReferralNumber, result.ReferralNumber);
        if (result.ReferralDate.HasValue) Model.ReferralDate = result.ReferralDate.Value;
        Model.ReferralSource = SetIfPresent(Model.ReferralSource, result.ReferralSource);
        Model.Priority = SetIfPresent(Model.Priority, result.Priority);
        // Only select an insurance name that is already present in the active dropdown.
        // Never insert an unrecognized OCR value into a select-bound model field.
        if (string.IsNullOrWhiteSpace(Model.PrimaryInsurance) &&
            !string.IsNullOrWhiteSpace(result.PrimaryInsurance))
        {
            try
            {
                var activeInsurances = await LookupService.GetAsync("Insurance", activeOnly: true);
                var extractedName = result.PrimaryInsurance.Trim();
                var matchedInsurance = activeInsurances.FirstOrDefault(option =>
                    string.Equals(option.DisplayName?.Trim(), extractedName,
                        StringComparison.OrdinalIgnoreCase));

                if (matchedInsurance is not null)
                    Model.PrimaryInsurance = matchedInsurance.DisplayName;
            }
            catch (Exception ex)
            {
                // Fail closed. A lookup outage must not produce an invalid insurance selection
                // or stop auto-population of independent patient fields.
                Logger.LogWarning(ex, "Insurance dropdown lookup failed during referral PDF extraction.");
            }
        }
        Model.InsuranceMemberId = SetIfPresent(Model.InsuranceMemberId, result.InsuranceMemberId);
        if (!Model.AuthorizationDate.HasValue && result.AuthorizationDate.HasValue) Model.AuthorizationDate = result.AuthorizationDate;
        if (!Model.ApprovedVisits.HasValue && result.ApprovedVisits.HasValue) Model.ApprovedVisits = result.ApprovedVisits;
        Model.ReferringPhysician = SetIfPresent(Model.ReferringPhysician, result.ReferringPhysician);
        Model.PhysicianPhone = SetIfPresent(Model.PhysicianPhone, result.PhysicianPhone);
        Model.PrimaryDiagnosis = SetIfPresent(Model.PrimaryDiagnosis, result.PrimaryDiagnosis);
        Model.SecondaryDiagnosis = SetIfPresent(Model.SecondaryDiagnosis, result.SecondaryDiagnosis);
        Model.ReferralNotes = SetIfPresent(Model.ReferralNotes, result.ReferralNotes);

        // Ordered services are selected manually by the Care Coordinator.
        // Extraction never adds, removes, or replaces these choices.
    }

    private void ConfirmMrnChoice()
    {
        if (string.IsNullOrWhiteSpace(Model.MrnReviewChoice)) return;

        if (Model.MrnReviewChoice == "__manual__")
        {
            // Never guess which facility's MRN applies. The Referral Information
            // step provides an editable MRN field for manual verification.
            Model.MRN = string.Empty;
        }
        else
        {
            var selected = Model.MrnCandidates.FirstOrDefault(candidate =>
                string.Equals(candidate.Value, Model.MrnReviewChoice, StringComparison.Ordinal));
            if (selected is null) return;
            Model.MRN = selected.Value;
        }
        Model.MrnReviewCompleted = true;
    }

    private void ChangeMrnChoice() => Model.MrnReviewCompleted = false;

    private static string SetIfPresent(string target, string? value)
    {
        return !string.IsNullOrWhiteSpace(target) || string.IsNullOrWhiteSpace(value)
            ? target
            : value.Trim();
    }

    private void ClearFile()
    {
        Model.ReferralPdf = null;
        Model.ReferralPdfBytes = null;
        Model.ReferralPdfFileName = null;
        Model.ReferralPdfContentType = null;
        Model.ReferralPdfSize = null;
        ExtractionCompleted = false;
        DetectedForm = null;
        DetectedFormVersion = null;
        DetectedFieldCount = 0;
        Model.MrnReviewChoice = string.Empty;
        Model.MrnCandidates = [];
        Model.MrnReviewRequired = false;
        Model.MrnReviewCompleted = false;
        Model.ReferralExtractionInProgress = false;
    }

    private void RemoveFile() => ClearFile();

    private static string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0)
            return "Size unavailable";

        return Math.Round(bytes.Value / 1024d / 1024d, 2).ToString("0.##") + " MB";
    }
}
