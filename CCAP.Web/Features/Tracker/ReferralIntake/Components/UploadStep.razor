@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using Microsoft.AspNetCore.Components.Forms

<div class="step-card">

    <div class="step-title">
        <h4>Upload Referral PDF</h4>
    </div>

    <div class="row g-4">

        <div class="col-lg-7">

            <div class="upload-card">

                <InputFile id="uploadReferral"
                           class="d-none"
                           OnChange="OnFileSelected"
                           accept=".pdf,application/pdf" />

                <label for="uploadReferral"
                       class="upload-dropzone">

                    <i class="bi bi-cloud-arrow-up upload-icon"></i>

                    <h5>
                        Choose Referral PDF
                    </h5>

                    <span>
                        PDF files only
                    </span>

                    <div class="btn btn-success">
                        Choose File
                    </div>

                </label>

            </div>

        </div>

        <div class="col-lg-5">

            <div class="info-card">

                <h5>Uploaded File</h5>

                @if (Model.ReferralPdf is null)
                {
                    <div class="empty-file">

                        <i class="bi bi-file-earmark"></i>

                        <span>
                            No file selected.
                        </span>

                    </div>
                }
                else
                {
                    <div class="uploaded-file">

                        <i class="bi bi-file-earmark-pdf-fill text-danger fs-1"></i>

                        <div class="flex-grow-1">

                            <strong>
                                @Model.ReferralPdf.Name
                            </strong>

                            <small class="d-block text-muted">

                                @(Math.Round(
                                    (double)Model.ReferralPdf.Size
                                    / 1024
                                    / 1024,
                                    2)) MB

                            </small>

                        </div>

                    </div>

                    <hr />

                    <div class="d-flex gap-2">

                        <label for="uploadReferral"
                               class="btn btn-outline-success btn-sm">

                            <i class="bi bi-arrow-repeat"></i>

                            Replace

                        </label>

                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                @onclick="RemoveFile">

                            <i class="bi bi-trash"></i>

                            Remove

                        </button>

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="alert alert-light mt-4">

        <i class="bi bi-info-circle-fill text-success"></i>

        Accepted format: PDF.
        Maximum size: 10 MB.

    </div>

</div>

@code {

    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    private const long MaxFileSize = 10 * 1024 * 1024;

    private async Task OnFileSelected(
        InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file is null)
            return;

        if (!file.Name.EndsWith(
                ".pdf",
                StringComparison.OrdinalIgnoreCase))
        {
            ClearFile();

            return;
        }

        if (file.Size > MaxFileSize)
        {
            ClearFile();

            return;
        }

        try
        {
            await using var input =
                file.OpenReadStream(MaxFileSize);

            using var memoryStream =
                new MemoryStream();

            await input.CopyToAsync(memoryStream);

            Model.ReferralPdfBytes =
                memoryStream.ToArray();

            Model.ReferralPdfFileName =
                file.Name;

            Model.ReferralPdfContentType =
                file.ContentType;

            Model.ReferralPdf = file;
        }
        catch
        {
            ClearFile();
        }
    }

    private void ClearFile()
    {
        Model.ReferralPdf = null;
        Model.ReferralPdfBytes = null;
        Model.ReferralPdfFileName = null;
        Model.ReferralPdfContentType = null;
    }

    private void RemoveFile()
    {
        ClearFile();
    }
}