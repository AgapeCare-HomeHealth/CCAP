<div class="step-card">

    <div class="step-title">

        <h4>Assignment</h4>

        <p>
            Assign the referral and initialize the patient's workflow.
        </p>

    </div>

    <!-- ================= Assignment ================= -->

    <h5 class="section-heading">

        Assignment Details

    </h5>

    <div class="row g-4">

        <div class="col-md-6">

            <label class="form-label">

                Care Coordinator

            </label>

            <select class="form-select">

                <option>Jennifer LVN</option>
                <option>Isabella LVN</option>
                <option>Renald LVN</option>

            </select>

        </div>

        <div class="col-md-6">

            <label class="form-label">

                Assigned Clinician

            </label>

            <select class="form-select">

                <option>Select Clinician</option>

            </select>

        </div>

        <div class="col-md-6">

            <label class="form-label">

                Discipline

            </label>

            <select class="form-select">

                <option>Skilled Nursing</option>
                <option>Physical Therapy</option>
                <option>Occupational Therapy</option>
                <option>Speech Therapy</option>

            </select>

        </div>

        <div class="col-md-6">

            @*<label class="form-label">

                Branch

            </label>

            <select class="form-select">

                <option>Main Office</option>
                <option>South Branch</option>

            </select> *@

        </div>

    </div>

    <hr />

    <!-- ================= Scheduling ================= -->

    <h5 class="section-heading">

        Initial Scheduling

    </h5>

    <div class="row g-4">

        <div class="col-md-4">

            <label class="form-label">

                Target SOC Date

            </label>

            <input type="date"
                   class="form-control" />

        </div>

        <div class="col-md-4">

            <label class="form-label">

                Visit Priority

            </label>

            <select class="form-select">

                <option>Routine</option>
                <option>Urgent</option>
                <option>STAT</option>

            </select>

        </div>

        <div class="col-md-4">

            <label class="form-label">

                Case Status

            </label>

            <select class="form-select">

                <option>Active</option>
                <option>Pending</option>

            </select>

        </div>

    </div>

    <hr />

    <!-- ================= Workflow ================= -->

    <h5 class="section-heading">

        Workflow Initialization

    </h5>

    <p class="text-muted">

        These tasks will automatically be created after submitting the referral.

    </p>

    <div class="workflow-grid">

        <div class="workflow-item">

            <i class="bi bi-shield-check text-success"></i>

            Insurance Verification

        </div>

        <div class="workflow-item">

            <i class="bi bi-file-earmark-medical text-success"></i>

            Physician Orders

        </div>

        <div class="workflow-item">

            <i class="bi bi-calendar-check text-success"></i>

            Schedule SOC Visit

        </div>

        <div class="workflow-item">

            <i class="bi bi-heart-pulse text-success"></i>

            Plan of Care

        </div>

        <div class="workflow-item">

            <i class="bi bi-folder2-open text-success"></i>

            Compliance Checklist

        </div>

        <div class="workflow-item">

            <i class="bi bi-person-check text-success"></i>

            Patient Tracking

        </div>

    </div>

    <hr />

    <!-- ================= Notes ================= -->

    <h5 class="section-heading">

        Internal Notes

    </h5>

    <textarea class="form-control"
              rows="5"
              placeholder="Coordinator notes..."></textarea>

</div>