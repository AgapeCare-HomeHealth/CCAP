@using CCAP.Web.Features.Tracker.ReferralIntake.Models 
@using CCAP.Web.Features.Admin.Users.Models

<div class="step-card">
    <div class="step-title">
        <h4>Assignment</h4>
        <p>Assign the referral and initialize the patient's workflow.</p>
    </div>

    @if (IsLoading)
    {
        <div class="py-4 text-center">Loading assignment options...</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else
    {
        <h5 class="section-heading">Assignment Details</h5>

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Care Coordinator</label>
                <select class="form-select" @bind="Model.CoordinatorId">
                    <option value="">Select Coordinator</option>
                    @foreach (var user in Coordinators)
                    {
                        <option value="@user.UserId">@user.FullName</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Assigned Clinician</label>
                <select class="form-select" @bind="Model.ClinicianId">
                    <option value="">Select Clinician</option>
                    @foreach (var user in Clinicians)
                    {
                        <option value="@user.UserId">@user.FullName</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Discipline</label>
                <select class="form-select" @bind="Model.DisciplineId">
                    <option value="">Select Discipline</option>
                    @foreach (var discipline in Disciplines)
                    {
                        <option value="@discipline.Id">@discipline.Name</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <h5 class="section-heading">Initial Scheduling</h5>

        <div class="row g-4">
            <div class="col-md-4">
                <label class="form-label">Target SOC Date</label>
                <input type="date" class="form-control" @bind="Model.SocDate" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Visit Priority</label>
                <select class="form-select" @bind="Model.VisitPriority">
                    <option value="">Select Priority</option>
                    <option value="Routine">Routine</option>
                    <option value="Urgent">Urgent</option>
                    <option value="STAT">STAT</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Case Status</label>
                <select class="form-select" @bind="Model.CaseStatus">
                    <option value="">Select Status</option>
                    <option value="Active">Active</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
        </div>

        <hr />

        <h5 class="section-heading">Workflow Initialization</h5>
        <p class="text-muted">
            Workflow tasks will be created by the application after the referral is submitted.
        </p>

        <hr />

        <h5 class="section-heading">Internal Notes</h5>
        <textarea class="form-control" rows="5"
                  @bind="Model.InternalNotes"
                  placeholder="Coordinator notes..."></textarea>
    }
</div>

@code {
    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    [Parameter]
    public List<UserDto> Coordinators { get; set; } = [];

    [Parameter]
    public List<UserDto> Clinicians { get; set; } = [];

    [Parameter]
    public List<LookupDto> Disciplines { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

}
