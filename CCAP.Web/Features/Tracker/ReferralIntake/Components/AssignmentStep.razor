@using CCAP.Web.Features.Admin.LookupOptions.Models
@using CCAP.Web.Features.Admin.LookupOptions.Services
@inject LookupOptionService LookupService
@using CCAP.Web.Features.Tracker.ReferralIntake.Models 
@using CCAP.Web.Features.Admin.Users.Models

<div class="step-card">
    <div class="step-title">
        <h4>Assignment</h4>
        <p>Assign the referral and initialize the patient's workflow.</p>
    </div>

    @if (IsLoading)
    {
        <div class="py-4 text-center">Loading assignment options...</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else
    {
        <h5 class="section-heading">Assignment Details</h5>

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Care Coordinator</label>
                <select class="form-select" @bind="Model.CoordinatorId">
                    <option value="">Select Coordinator</option>
                    @foreach (var user in Coordinators)
                    {
                        <option value="@user.UserId">@user.FullName</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Assigned Clinician</label>
                <select class="form-select" @bind="Model.ClinicianId">
                    <option value="">Select Clinician</option>
                    @foreach (var user in Clinicians)
                    {
                        <option value="@user.UserId">@user.FullName</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Ordered Services</label>
                <div class="service-grid">
                    @foreach (var service in ReferralServiceOptions.All)
                    {
                        <label class="service-item">
                            <input type="checkbox" checked="@Model.OrderedServices.Contains(service)" disabled />
                            @service
                        </label>
                    }
                </div>
                <div class="form-text">These selections come from Referral Information and are not edited here.</div>
            </div>

            <div class="col-12">
                <label class="form-label">Discipline</label>
                <div class="service-grid discipline-grid">
                    @foreach (var discipline in SelectedAssignmentDisciplines)
                    {
                        <label class="service-item @(Model.DisciplineId == discipline.Id ? "selected" : string.Empty)">
                            <input type="checkbox"
                                   checked="@(Model.DisciplineId == discipline.Id)"
                                   @onchange="e => ToggleDiscipline(discipline.Id, e.Value)" />
                            @discipline.Name
                        </label>
                    }
                </div>
                <div class="form-text">Select the discipline assigned to the clinician. Only disciplines included in Ordered Services are shown.</div>
            </div>
        </div>

        <hr />

        <h5 class="section-heading">Initial Scheduling</h5>

        <div class="row g-4">
            <div class="col-md-4">
                <label class="form-label">Target SOC Date</label>
                <input type="date" class="form-control" value="@Model.SocDate?.ToString("yyyy-MM-dd")" readonly />
                <div class="form-text">Automatically calculated as 48 hours from the initial referral date.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Visit Priority</label>
                <select class="form-select" @bind="Model.VisitPriority">
                    <option value="">Select Visit Priority</option>
                    <option value="Medicare/VA">Medicare/VA</option>
                    <option value="None Medicare/VA">None Medicare/VA</option>
                </select>
                <div class="form-text">Medicare/VA referrals should be scheduled within 24–48 hours.</div>
            </div>

        </div>

        <hr />

        <h5 class="section-heading">Workflow Initialization</h5>
        <p class="text-muted">
            Workflow tasks will be created by the application after the referral is submitted.
        </p>

        <hr />

        <h5 class="section-heading">Internal Notes</h5>
        <textarea class="form-control" rows="5"
                  @bind="Model.InternalNotes"
                  placeholder="Coordinator notes..."></textarea>
    }
</div>

@code {
    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    [Parameter]
    public List<UserDto> Coordinators { get; set; } = [];

    [Parameter]
    public List<UserDto> Clinicians { get; set; } = [];

    [Parameter]
    public List<LookupDto> Disciplines { get; set; } = [];

    private IEnumerable<LookupDto> AssignmentDisciplines =>
        Disciplines
            .Where(d => ReferralServiceOptions.All.Contains(
                d.Name,
                StringComparer.OrdinalIgnoreCase))
            .OrderBy(d => Array.FindIndex(
                ReferralServiceOptions.All,
                name => string.Equals(name, d.Name, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<LookupDto> SelectedAssignmentDisciplines =>
        AssignmentDisciplines.Where(d => Model.OrderedServices.Any(
            service => string.Equals(service, d.Name, StringComparison.OrdinalIgnoreCase)));

    private void ToggleDiscipline(Guid disciplineId, object? value)
    {
        var isChecked = value is bool selected && selected;

        if (isChecked)
        {
            // The domain currently stores one assigned discipline, so the checkbox
            // presentation behaves as a single-selection control.
            Model.DisciplineId = disciplineId;
        }
        else if (Model.DisciplineId == disciplineId)
        {
            Model.DisciplineId = null;
        }
    }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

}
