@using CCAP.Web.Features.Tracker.ReferralIntake.Models

<div class="step-card">

    <div class="step-title">
        <h4>Review & Submit</h4>

        <p>
            Review all referral information before creating
            the patient workflow.
        </p>
    </div>

    <h5 class="section-heading">
        Patient Information
    </h5>

    <div class="summary-grid">

        <div class="summary-item">
            <label>MRN</label>
            <span>@Model.MRN</span>
        </div>

        <div class="summary-item">
            <label>Patient Name</label>

            <span>
                @($"{Model.FirstName} {Model.MiddleName} {Model.LastName}"
                    .Replace("  ", " ")
                    .Trim())
            </span>
        </div>

        <div class="summary-item">
            <label>Date of Birth</label>

            <span>
                @Model.DateOfBirth?.ToString("MM/dd/yyyy")
            </span>
        </div>

        <div class="summary-item">
            <label>Gender</label>

            <span>
                @Model.Gender
            </span>
        </div>

        <div class="summary-item">
            <label>Phone</label>

            <span>
                @Model.PrimaryPhone
            </span>
        </div>

        <div class="summary-item full-width">
            <label>Address</label>

            <span>
                @Model.StreetAddress,
                @Model.City,
                @Model.State
                @Model.ZipCode
            </span>
        </div>

    </div>

    <hr />

    <h5 class="section-heading">
        Referral Information
    </h5>

    <div class="summary-grid">

        <div class="summary-item">
            <label>Referral Number</label>
            <span>@Model.ReferralNumber</span>
        </div>

        <div class="summary-item">
            <label>Referral Date</label>
            <span>
                @Model.ReferralDate.ToString("MM/dd/yyyy")
            </span>
        </div>

        <div class="summary-item">
            <label>Source</label>
            <span>@Model.ReferralSource</span>
        </div>

        <div class="summary-item">
            <label>Priority</label>
            <span>@Model.Priority</span>
        </div>

        <div class="summary-item">
            <label>Insurance</label>
            <span>@Model.PrimaryInsurance</span>
        </div>

        <div class="summary-item">
            <label>Member ID</label>
            <span>@Model.InsuranceMemberId</span>
        </div>

        <div class="summary-item">
            <label>Physician</label>
            <span>@Model.ReferringPhysician</span>
        </div>

        <div class="summary-item">
            <label>Primary Diagnosis</label>
            <span>@Model.PrimaryDiagnosis</span>
        </div>

    </div>

    <hr />

    <h5 class="section-heading">
        Ordered Services
    </h5>

    @if (Model.OrderedServices.Count == 0)
    {
        <div class="text-muted">
            No services selected.
        </div>
    }
    else
    {
        <div class="workflow-preview">

            @foreach (var service in Model.OrderedServices)
            {
                <div class="workflow-badge">
                    @service
                </div>
            }

        </div>
    }

    <hr />

    <h5 class="section-heading">
        Assignment
    </h5>

    <div class="summary-grid">

        <div class="summary-item">
            <label>Coordinator</label>
            <span>
                @Model.CoordinatorId
            </span>
        </div>

        <div class="summary-item">
            <label>Clinician</label>
            <span>
                @Model.ClinicianId
            </span>
        </div>

        <div class="summary-item">
            <label>Discipline</label>
            <span>
                @Model.DisciplineId
            </span>
        </div>

        <div class="summary-item">
            <label>SOC Date</label>
            <span>
                @Model.SocDate?.ToString("MM/dd/yyyy")
            </span>
        </div>

    </div>

    <hr />

    <h5 class="section-heading">
        Uploaded Referral
    </h5>

    @if (Model.ReferralPdf is not null)
    {
        <div class="uploaded-summary">

            <i class="bi bi-file-earmark-pdf-fill text-danger"></i>

            <div>

                <strong>
                    @Model.ReferralPdf.Name
                </strong>

                <small>
                    @(Math.Round(
                        (double)Model.ReferralPdf.Size
                        / 1024
                        / 1024,
                        2)) MB
                </small>

            </div>

        </div>
    }

    <hr />

    <div class="alert alert-success">

        <i class="bi bi-check-circle-fill"></i>

        The referral is ready to be created.

    </div>

</div>

@code {

    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;
}