@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using CCAP.Web.Features.Tracker.ReferralIntake.Components
@using CCAP.Web.Features.Admin.Users.Models
@using CCAP.Web.Features.Admin.LookupOptions.Models

<div class="step-card">
    <div class="step-title">
        <h4>Review & Submit</h4>
        <p>Review all information entered across the referral stages before creating the patient workflow.</p>
    </div>

    <h5 class="section-heading">Patient Information</h5>
    <div class="summary-grid">
        <SummaryItem Label="First Name" Value="@Model.FirstName" />
        <SummaryItem Label="Middle Name" Value="@Model.MiddleName" />
        <SummaryItem Label="Last Name" Value="@Model.LastName" />
        <SummaryItem Label="Date of Birth" Value="@FormatDate(Model.DateOfBirth)" />
        <SummaryItem Label="Gender" Value="@Model.Gender" />
        <SummaryItem Label="Primary Phone" Value="@Model.PrimaryPhone" />
        <SummaryItem Label="Alternate Phone" Value="@Model.AlternatePhone" />
        <SummaryItem Label="Street Address" Value="@Model.StreetAddress" FullWidth="true" />
        <SummaryItem Label="City" Value="@Model.City" />
        <SummaryItem Label="State" Value="@Model.State" />
        <SummaryItem Label="ZIP Code" Value="@Model.ZipCode" />
    </div>

    <h6 class="mt-4 mb-3">Emergency Contact</h6>
    <div class="summary-grid">
        <SummaryItem Label="Contact Name" Value="@Model.EmergencyContactName" />
        <SummaryItem Label="Relationship" Value="@Model.EmergencyContactRelationship" />
        <SummaryItem Label="Phone Number" Value="@Model.EmergencyContactPhone" />
    </div>

    <hr />
    <h5 class="section-heading">Referral Information</h5>
    <div class="summary-grid">
        <SummaryItem Label="MRN" Value="@Model.MRN" />
        <SummaryItem Label="Referral Number" Value="@Model.ReferralNumber" />
        <SummaryItem Label="Initial Referral Date" Value="@Model.ReferralDate.ToString("MM/dd/yyyy")" />
        <SummaryItem Label="Type of Referral" Value="@Model.ReferralType" />
        <SummaryItem Label="Referral Source" Value="@Model.ReferralSource" />
        <SummaryItem Label="Target SOC Date" Value="@FormatDate(Model.SocDate)" />
    </div>

    <h6 class="mt-4 mb-3">Insurance Information</h6>
    <div class="summary-grid">
        <SummaryItem Label="Primary Insurance" Value="@Model.PrimaryInsurance" />
        <SummaryItem Label="Member ID" Value="@Model.InsuranceMemberId" />
        <SummaryItem Label="PRE AUTH" Value="@Model.PreAuthStatus" />
        <SummaryItem Label="Authorization Date" Value="@FormatDate(Model.AuthorizationDate)" />
        <SummaryItem Label="Number of Approved Visits" Value="@Model.ApprovedVisits?.ToString()" />
    </div>

    <h6 class="mt-4 mb-3">Primary Care Physician</h6>
    <div class="summary-grid">
        <SummaryItem Label="Primary Care Physician" Value="@Model.ReferringPhysician" />
        <SummaryItem Label="Phone Number" Value="@Model.PhysicianPhone" />
        <SummaryItem Label="Fax Number" Value="@Model.PhysicianFax" />
        <SummaryItem Label="NPI" Value="@Model.PhysicianNpi" />
        <SummaryItem Label="PCOS Registered" Value="@Model.PcosRegistered" />
    </div>

    <h6 class="mt-4 mb-3">Clinical Information</h6>
    <div class="summary-grid">
        <SummaryItem Label="Primary Diagnosis" Value="@Model.PrimaryDiagnosis" />
        <SummaryItem Label="Secondary Diagnosis" Value="@Model.SecondaryDiagnosis" />
    </div>

    <div class="mt-4">
        <label class="form-label fw-semibold">Ordered Services</label>
        @if (Model.OrderedServices.Count == 0)
        {
            <div class="text-muted">No services selected.</div>
        }
        else
        {
            <div class="workflow-preview">
                @foreach (var service in Model.OrderedServices)
                {
                    <div class="workflow-badge">@service</div>
                }
            </div>
        }
    </div>

    <h6 class="mt-4 mb-3">Referral Notes</h6>
    <div class="summary-notes">@Display(Model.ReferralNotes)</div>

    <hr />
    <h5 class="section-heading">Assignment & Initial Scheduling</h5>
    <div class="summary-grid">
        <SummaryItem Label="Coordinator" Value="@CoordinatorName" />
        <SummaryItem Label="Clinician" Value="@ClinicianName" />
        <SummaryItem Label="Discipline" Value="@DisciplineName" />
        <SummaryItem Label="Target SOC Date" Value="@FormatDate(Model.SocDate)" />
        <SummaryItem Label="Visit Priority" Value="@Model.VisitPriority" />
        <SummaryItem Label="Case Status" Value="Pending" />
    </div>

    <h6 class="mt-4 mb-3">Internal Notes</h6>
    <div class="summary-notes">@Display(Model.InternalNotes)</div>

    <hr />
    <h5 class="section-heading">Uploaded Referral</h5>
    @if (Model.ReferralPdf is not null)
    {
        <div class="uploaded-summary"><i class="bi bi-file-earmark-pdf-fill text-danger"></i><div><strong>@Model.ReferralPdf.Name</strong><small>@(Math.Round((double)Model.ReferralPdf.Size / 1024 / 1024, 2)) MB</small></div></div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.ReferralPdfFileName))
    {
        <div class="uploaded-summary"><i class="bi bi-file-earmark-pdf-fill text-danger"></i><div><strong>@Model.ReferralPdfFileName</strong><small>@(Model.ReferralPdfSize.HasValue ? Math.Round((double)Model.ReferralPdfSize.Value / 1024 / 1024, 2) : 0) MB</small></div></div>
    }
    else
    {
        <div class="text-muted">No referral PDF uploaded.</div>
    }

    <hr />
    <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>The referral is ready to be created.</div>
</div>

@code {
    [Parameter] public ReferralIntakeModel Model { get; set; } = null!;
    [Parameter] public List<UserDto> Coordinators { get; set; } = [];
    [Parameter] public List<UserDto> Clinicians { get; set; } = [];
    [Parameter] public List<LookupDto> Disciplines { get; set; } = [];

    private string CoordinatorName => Model.CoordinatorId.HasValue
        ? Coordinators.FirstOrDefault(x => x.UserId == Model.CoordinatorId.Value)?.FullName ?? Model.CoordinatorId.Value.ToString()
        : string.Empty;

    private string ClinicianName => Model.ClinicianId.HasValue
        ? Clinicians.FirstOrDefault(x => x.UserId == Model.ClinicianId.Value)?.FullName ?? Model.ClinicianId.Value.ToString()
        : string.Empty;

    private string DisciplineName => Model.DisciplineId.HasValue
        ? Disciplines.FirstOrDefault(x => x.Id == Model.DisciplineId.Value)?.Name ?? Model.DisciplineId.Value.ToString()
        : string.Empty;

    private static string FormatDate(DateOnly? value) => value?.ToString("MM/dd/yyyy") ?? string.Empty;
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
}
