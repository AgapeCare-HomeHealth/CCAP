@using CCAP.Web.Features.Admin.LookupOptions.Models
@using CCAP.Web.Features.Admin.LookupOptions.Services
@inject LookupOptionService LookupService
﻿@using CCAP.Web.Features.Tracker.ReferralIntake.Models

@using CCAP.Web.Common.Validation

<div class="step-card">

    <div class="step-title">
        <h4>Patient Information</h4>

        <p>
            Enter the patient's demographic and contact information.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <label class="form-label">
                First Name <span class="text-danger">*</span>
            </label>

            <input class="form-control"
                   @bind="Model.FirstName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Last Name <span class="text-danger">*</span>
            </label>

            <input class="form-control"
                   @bind="Model.LastName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Middle Name
            </label>

            <input class="form-control"
                   @bind="Model.MiddleName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Date of Birth <span class="text-danger">*</span>
            </label>

            <input type="date"
                   class="form-control"
                   @bind="Model.DateOfBirth" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Gender <span class="text-muted">(Optional)</span>
            </label>

            <select class="form-select"
                    @bind="Model.Gender">

                <option value="">
                    Select Gender
                </option>

                @foreach (var option in Genders)
                {
                    <option value="@option.DisplayName">@option.DisplayName</option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Primary Phone <span class="text-muted">(Optional)</span>
            </label>

            <InputText class="@FieldValidation.InputClass(PrimaryPhoneError)"
                       type="tel"
                       @bind-Value="Model.PrimaryPhone"
                       @onblur="ValidatePrimaryPhone" />

            @if (!string.IsNullOrWhiteSpace(PrimaryPhoneError))
            {
                <div class="invalid-feedback">
                    @PrimaryPhoneError
                </div>
            }
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Alternate Phone
            </label>

            <InputText class="@FieldValidation.InputClass(AlternatePhoneError)"
                       type="tel"
                       @bind-Value="Model.AlternatePhone"
                       @onblur="ValidateAlternatePhone" />

            @if (!string.IsNullOrWhiteSpace(AlternatePhoneError))
            {
                <div class="invalid-feedback">
                    @AlternatePhoneError
                </div>
            }
        </div>

        <div class="col-12">
            <label class="form-label">
                Street Address <span class="text-muted">(Optional)</span>
            </label>

            <input class="form-control"
                   @bind="Model.StreetAddress" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                City <span class="text-muted">(Optional)</span>
            </label>

            <input class="form-control"
                   @bind="Model.City" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                State <span class="text-muted">(Optional)</span>
            </label>

            <input class="form-control"
                   @bind="Model.State" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                ZIP Code <span class="text-muted">(Optional)</span>
            </label>

            <input class="form-control"
                   @bind="Model.ZipCode" />
        </div>

    </div>

    <hr class="my-4" />

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="mb-1">Emergency Contacts</h5>
            <small class="text-muted">Add one or more people who may be contacted in an emergency.</small>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddEmergencyContact">
            <i class="bi bi-plus-lg me-1"></i> Add Contact
        </button>
    </div>

    @for (var index = 0; index < Model.EmergencyContacts.Count; index++)
    {
        var contact = Model.EmergencyContacts[index];
        <div class="border rounded-3 p-3 mb-3" @key="contact">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <strong>Emergency Contact @(index + 1)</strong>
                @if (Model.EmergencyContacts.Count > 1)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            @onclick="() => RemoveEmergencyContact(contact)">
                        Remove
                    </button>
                }
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Contact Name <span class="text-muted">(Optional)</span></label>
                    <input class="form-control" @bind="contact.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Relationship <span class="text-muted">(Optional)</span></label>
                    <input class="form-control" @bind="contact.Relationship" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Phone Number <span class="text-muted">(Optional)</span></label>
                    <input class="form-control" type="tel" @bind="contact.Phone" />
                </div>
            </div>
        </div>
    }

</div>

@code {
    private List<LookupOptionDto> Genders = [];

    protected override async Task OnInitializedAsync() =>
        Genders = await LookupService.GetAsync("Gender", true);

    protected override void OnParametersSet()
    {
        Model.EmergencyContacts ??= [];

        if (Model.EmergencyContacts.Count == 0)
            Model.EmergencyContacts.Add(new EmergencyContactModel());

        // Drafts and older OCR flows may still populate the legacy scalar
        // properties. Reflect those values in the first visible contact row.
        var first = Model.EmergencyContacts[0];
        if (string.IsNullOrWhiteSpace(first.Name))
            first.Name = Model.EmergencyContactName ?? string.Empty;
        if (string.IsNullOrWhiteSpace(first.Relationship))
            first.Relationship = Model.EmergencyContactRelationship ?? string.Empty;
        if (string.IsNullOrWhiteSpace(first.Phone))
            first.Phone = Model.EmergencyContactPhone ?? string.Empty;
    }

    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;

    private void AddEmergencyContact() => Model.EmergencyContacts.Add(new EmergencyContactModel());

    private void RemoveEmergencyContact(EmergencyContactModel contact)
    {
        if (Model.EmergencyContacts.Count > 1)
            Model.EmergencyContacts.Remove(contact);
    }

    private string? PrimaryPhoneError;
    private string? AlternatePhoneError;

    private void ValidatePrimaryPhone()
    {
        PrimaryPhoneError =
            FieldValidation.Phone(
                Model.PrimaryPhone,
                "Primary phone",
                required: false);
    }

    private void ValidateAlternatePhone()
    {
        AlternatePhoneError =
            FieldValidation.Phone(
                Model.AlternatePhone,
                "Alternate phone");
    }
}