@using CCAP.Web.Features.Tracker.ReferralIntake.Models

<div class="step-card">

    <div class="step-title">
        <h4>Patient Information</h4>

        <p>
            Enter the patient's demographic and contact information.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <label class="form-label">
                First Name <span class="text-danger">*</span>
            </label>

            <input class="form-control"
                   @bind="Model.FirstName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Last Name <span class="text-danger">*</span>
            </label>

            <input class="form-control"
                   @bind="Model.LastName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Middle Name
            </label>

            <input class="form-control"
                   @bind="Model.MiddleName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Date of Birth
            </label>

            <input type="date"
                   class="form-control"
                   @bind="Model.DateOfBirth" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                MRN <span class="text-danger">*</span>
            </label>

            <input class="form-control"
                   @bind="Model.MRN" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Gender
            </label>

            <select class="form-select"
                    @bind="Model.Gender">

                <option value="">
                    Select Gender
                </option>

                <option value="Male">
                    Male
                </option>

                <option value="Female">
                    Female
                </option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Primary Phone
            </label>

            <input class="form-control"
                   @bind="Model.PrimaryPhone" />
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Alternate Phone
            </label>

            <input class="form-control"
                   @bind="Model.AlternatePhone" />
        </div>

        <div class="col-12">
            <label class="form-label">
                Street Address
            </label>

            <input class="form-control"
                   @bind="Model.StreetAddress" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                City
            </label>

            <input class="form-control"
                   @bind="Model.City" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                State
            </label>

            <input class="form-control"
                   @bind="Model.State" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                ZIP Code
            </label>

            <input class="form-control"
                   @bind="Model.ZipCode" />
        </div>

    </div>

    <hr class="my-4" />

    <h5 class="mb-3">
        Emergency Contact
    </h5>

    <div class="row g-4">

        <div class="col-md-4">
            <label class="form-label">
                Contact Name
            </label>

            <input class="form-control"
                   @bind="Model.EmergencyContactName" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Relationship
            </label>

            <input class="form-control"
                   @bind="Model.EmergencyContactRelationship" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Phone Number
            </label>

            <input class="form-control"
                   @bind="Model.EmergencyContactPhone" />
        </div>

    </div>

</div>

@code {

    [Parameter]
    public ReferralIntakeModel Model { get; set; } = null!;
}