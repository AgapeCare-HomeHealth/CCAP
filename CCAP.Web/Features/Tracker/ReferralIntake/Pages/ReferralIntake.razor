@page "/referrals"
@page "/referrals/drafts/{DraftId:guid}"

@attribute [CcapAuthorize(Policy = "referrals.view")]

@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CCAP.Web.Features.Admin.Users.Services
@using CCAP.Web.Features.Admin.Users.Models
@using CCAP.Web.Features.Tracker.ReferralIntake.Components
@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using CCAP.Web.Features.Tracker.ReferralIntake.Services

@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ReferralIntakeService ReferralIntakeService
@inject NavigationManager Navigation
@inject UserServices UserService
@inject AdminLookupService LookupService

<PageTitle>Referral Intake</PageTitle>

<div class="referral-page">

    <WizardHeader />

    <WizardProgress CurrentStep="@CurrentStep" />

    <div class="wizard-body">

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        @switch (CurrentStep)
        {
            case 1:
                <UploadStep Model="@Model" @key="UploadStepKey" />
                break;

            case 2:
                <PatientInformationStep Model="@Model" />
                break;

            case 3:
                <ReferralInformationStep Model="@Model" />
                break;

            case 4:
                <AssignmentStep Model="@Model"
                                IsAdministrator="@IsAdministrator"
                                Coordinators="@Coordinators"
                                Clinicians="@Clinicians"
                                Disciplines="@Disciplines"
                                IsLoading="@AssignmentOptionsLoading"
                                ErrorMessage="@AssignmentOptionsError" />
                break;

            case 5:
                <ReviewStep Model="@Model"
                            Coordinators="@Coordinators"
                            Clinicians="@Clinicians"
                            Disciplines="@Disciplines" />
                break;
        }

    </div>

    <div class="wizard-footer">

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="PreviousStep"
                disabled="@(CurrentStep == 1 || IsSubmitting)">

            <i class="bi bi-arrow-left"></i>

            Previous

        </button>

        @* @if (CurrentStep < 5)
        {
            <button type="button"
                    class="btn btn-success"
                    @onclick="NextStep"
                    disabled="@IsSubmitting">

                Next

                <i class="bi bi-arrow-right"></i>

            </button>
        }
        else
        {
            <button type="button"
                    class="btn btn-success"
                    @onclick="CreateReferral"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Creating...</span>
                }
                else
                {
                    <i class="bi bi-check-circle me-2"></i>
                    <span>Create Referral</span>
                }

            </button>
        } *@

        <!-- RIGHT SIDE ACTIONS -->
        <div class="wizard-footer-actions">

            <button type="button"
                    class="btn btn-outline-primary save-draft-btn"
                    @onclick="SaveDraft"
                    disabled="@(IsSubmitting || IsSavingDraft)">

                @if (IsSavingDraft)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-save me-1"></i>
                    <span>Save Draft</span>
                }

            </button>


            <!-- NEXT -->
            @if (CurrentStep < 5)
            {
                <button type="button"
                        class="btn btn-success"
                        @onclick="NextStep"
                        disabled="@(IsSubmitting || IsSavingDraft)">

                    Next

                    <i class="bi bi-arrow-right ms-1"></i>

                </button>
            }
            else
            {
                <!-- FINAL SUBMIT -->
                <button type="button"
                        class="btn btn-success"
                        @onclick="CreateReferral"
                        disabled="@(IsSubmitting || IsSavingDraft)">

                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status">
                        </span>

                        <span>Submitting...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>

                        <span>Submit Referral</span>
                    }

                </button>
            }

        </div>

    </div>

</div>

@code {

    [Parameter]
    public Guid? DraftId { get; set; }

    private List<UserDto> Coordinators = [];
    private List<UserDto> Clinicians = [];
    private List<LookupDto> Disciplines = [];

    private bool AssignmentOptionsLoaded;
    private bool AssignmentOptionsLoading;
    private bool IsAdministrator;
    private Guid? CurrentUserId;
    private string? AssignmentOptionsError;

    private int CurrentStep = 1;

    private int UploadStepKey = 0;

    private ReferralIntakeModel Model = new();

    private bool IsSubmitting;

    private bool IsSavingDraft;

    private string? ErrorMessage;

    // protected override async Task OnInitializedAsync()
    // {
    //     if (DraftId.HasValue)
    //     {
    //         await LoadDraftAsync(DraftId.Value);
    //     }
    // }

    private Guid? _loadedDraftId;
    private bool _parametersInitialized;

    protected override async Task OnParametersSetAsync()
    {
        // Prevent unnecessary reload/reset when the component
        // receives the same route parameters again.
        if (_parametersInitialized &&
            DraftId == _loadedDraftId)
        {
            return;
        }

        _parametersInitialized = true;

        // ==========================================
        // OPEN EXISTING DRAFT
        // ==========================================

        if (DraftId.HasValue)
        {
            _loadedDraftId = DraftId.Value;

            await LoadDraftAsync(DraftId.Value);

            return;
        }

        // ==========================================
        // NEW REFERRAL
        // ==========================================

        _loadedDraftId = null;

        ResetForm();
    }

    private async Task LoadDraftAsync(
    Guid draftId)
    {
        ErrorMessage = null;

        try
        {
            Model =
                await ReferralIntakeService.LoadDraftAsync(
                    draftId);

            CurrentStep = 1;

            UploadStepKey++;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Unable to load referral draft: {ex.Message}";
        }
    }

    private async Task LoadAssignmentOptionsAsync()
    {
        if (AssignmentOptionsLoaded)
            return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        IsAdministrator = principal.IsInRole("Administrator");
        var idValue = principal.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? principal.FindFirst("sub")?.Value
            ?? principal.FindFirst("userId")?.Value;
        CurrentUserId = Guid.TryParse(idValue, out var currentUserId) ? currentUserId : null;

        AssignmentOptionsLoading = true;
        AssignmentOptionsError = null;

        try
        {
            var usersTask =
                UserService.GetUsersAsync();

            var disciplinesTask =
                LookupService.GetDisciplinesAsync();

            var users = await usersTask;

            Disciplines =
                await disciplinesTask;

            Coordinators = users
                .Where(x =>
                    x.IsActive &&
                    (
                        x.Role.Contains(
                            "Coordinator",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        x.Role.Contains(
                            "Administrator",
                            StringComparison.OrdinalIgnoreCase)
                    ))
                .ToList();

            if (!IsAdministrator)
            {
                if (!CurrentUserId.HasValue)
                    throw new InvalidOperationException("Unable to identify the signed-in user. Please sign in again.");

                // Non-admins must always be assigned to themselves, including when reopening a draft.
                Model.CoordinatorId = CurrentUserId.Value;
            }

            Clinicians = users
                .Where(x =>
                    x.IsActive &&
                    (
                        !string.IsNullOrWhiteSpace(x.Discipline)
                        ||
                        x.Role.Contains(
                            "Clinician",
                            StringComparison.OrdinalIgnoreCase)
                    ))
                .ToList();

            AssignmentOptionsLoaded = true;
        }
        catch (Exception ex)
        {
            AssignmentOptionsError =
                $"Unable to load assignment options: {ex.Message}";
        }
        finally
        {
            AssignmentOptionsLoading = false;
        }
    }

    private async Task NextStep()
    {
        ErrorMessage = null;

        if (!ValidateCurrentStep())
            return;

        if (CurrentStep >= 5)
            return;

        CurrentStep++;

        if (CurrentStep == 4)
        {
            await LoadAssignmentOptionsAsync();
        }
    }

    private void PreviousStep()
    {
        ErrorMessage = null;

        if (CurrentStep > 1)
            CurrentStep--;
    }

    private bool ValidateCurrentStep()
    {
        switch (CurrentStep)
        {
            case 1:
                // Uploading a PDF is optional. If supplied, Step 1 extracts
                // whatever fields it can and the user can review/edit them.
                return true;

            case 2:
                if (string.IsNullOrWhiteSpace(Model.FirstName))
                {
                    ErrorMessage = "First name is required.";
                    return false;
                }

                if (string.IsNullOrWhiteSpace(Model.LastName))
                {
                    ErrorMessage = "Last name is required.";
                    return false;
                }

                if (Model.DateOfBirth is null)
                {
                    ErrorMessage = "Date of birth is required.";
                    return false;
                }

                return true;

            // Referral, assignment, and scheduling fields are optional at
            // intake because most details are already available in the EMR.
            case 3:
            case 4:
                return true;
        }

        return true;
    }

    private async Task CreateReferral()
    {
        if (IsSubmitting)
            return;

        IsSubmitting = true;

        try
        {
            if (!IsAdministrator)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var idValue = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                    ?? authState.User.FindFirst("sub")?.Value
                    ?? authState.User.FindFirst("userId")?.Value;
                if (!Guid.TryParse(idValue, out var signedInUserId))
                    throw new InvalidOperationException("Unable to identify the signed-in user. Please sign in again.");
                Model.CoordinatorId = signedInUserId;
            }

            var result =
                await ReferralIntakeService.CreateAsync(
                    Model);

            await ShowSuccessAlert(
                "The referral has been created successfully.");

            // redirect to patients list
            Navigation.NavigateTo(
                "/patients",
                replace: true);
        }
        catch (InvalidOperationException ex)
        {
            await ShowFailedAlert(
                ex.Message);
        }
        catch (HttpRequestException)
        {
            await ShowErrorAlert(
                "Unable to communicate with the API. " +
                "Please try again.");
        }
        catch (Exception)
        {
            await ShowErrorAlert(
                "An unexpected error occurred while " +
                "creating the referral.");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ShowSuccessAlert(
    string message)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                icon = "success",
                title = "Success",
                text = message,
                confirmButtonText = "OK"
            });
    }

    private async Task ShowFailedAlert(
        string message)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                icon = "warning",
                title = "Failed",
                text = message,
                confirmButtonText = "OK"
            });
    }

    private async Task ShowErrorAlert(
        string message)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                icon = "error",
                title = "Error",
                text = message,
                confirmButtonText = "OK"
            });
    }

    private async Task SaveDraft()
    {
        ErrorMessage = null;

        // Drafts must be saveable even when the current step is incomplete.
        // Required-field validation is enforced when moving through the wizard
        // and submitting the referral, not when preserving work in progress.
        if (IsSavingDraft || IsSubmitting)
            return;

        try
        {
            IsSavingDraft = true;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;
            IsAdministrator = principal.IsInRole("Administrator");
            if (!IsAdministrator)
            {
                var idValue = principal.FindFirst(ClaimTypes.NameIdentifier)?.Value
                    ?? principal.FindFirst("sub")?.Value
                    ?? principal.FindFirst("userId")?.Value;
                if (!Guid.TryParse(idValue, out var signedInUserId))
                    throw new InvalidOperationException("Unable to identify the signed-in user. Please sign in again.");
                CurrentUserId = signedInUserId;
                Model.CoordinatorId = signedInUserId;
            }

            await ReferralIntakeService.SaveDraftAsync(
                Model);

            await ShowSuccessAlert(
                "The referral draft has been saved successfully. You can continue editing and save again at any step.");

            // Keep the entered data and current wizard step. Once the API
            // returns a draft ID, subsequent saves update that same draft.
            if (Model.ReferralDraftId.HasValue &&
                DraftId != Model.ReferralDraftId)
            {
                _loadedDraftId = Model.ReferralDraftId;
                Navigation.NavigateTo(
                    $"/referrals/drafts/{Model.ReferralDraftId.Value}",
                    replace: true);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage =
                ex.Message;
        }
        finally
        {
            IsSavingDraft = false;
        }
    }

    private void ResetForm()
    {
        Model = new ReferralIntakeModel();

        CurrentStep = 1;

        ErrorMessage = null;

        AssignmentOptionsError = null;

        UploadStepKey++;
    }
}