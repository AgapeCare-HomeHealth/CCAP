@page "/referrals"
@page "/referrals/drafts/{DraftId:guid}"

@attribute [CcapAuthorize(Policy = "referrals.view")]

@using Microsoft.JSInterop
@using CCAP.Web.Features.Admin.Users.Services
@using CCAP.Web.Features.Admin.Users.Models
@using CCAP.Web.Features.Tracker.ReferralIntake.Components
@using CCAP.Web.Features.Tracker.ReferralIntake.Models
@using CCAP.Web.Features.Tracker.ReferralIntake.Services

@inject IJSRuntime JS
@inject ReferralIntakeService ReferralIntakeService
@inject NavigationManager Navigation
@inject UserServices UserService
@inject AdminLookupService LookupService

<PageTitle>Referral Intake</PageTitle>

<div class="referral-page">

    <WizardHeader />

    <WizardProgress CurrentStep="@CurrentStep" />

    <div class="wizard-body">

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        @switch (CurrentStep)
        {
            case 1:
                <UploadStep Model="@Model" @key="UploadStepKey" />
                break;

            case 2:
                <PatientInformationStep Model="@Model" />
                break;

            case 3:
                <ReferralInformationStep Model="@Model" />
                break;

            case 4:
                <AssignmentStep Model="@Model"
                                Coordinators="@Coordinators"
                                Clinicians="@Clinicians"
                                Disciplines="@Disciplines"
                                IsLoading="@AssignmentOptionsLoading"
                                ErrorMessage="@AssignmentOptionsError" />
                break;

            case 5:
                <ReviewStep Model="@Model" />
                break;
        }

    </div>

    <div class="wizard-footer">

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="PreviousStep"
                disabled="@(CurrentStep == 1 || IsSubmitting)">

            <i class="bi bi-arrow-left"></i>

            Previous

        </button>

        @* @if (CurrentStep < 5)
        {
            <button type="button"
                    class="btn btn-success"
                    @onclick="NextStep"
                    disabled="@IsSubmitting">

                Next

                <i class="bi bi-arrow-right"></i>

            </button>
        }
        else
        {
            <button type="button"
                    class="btn btn-success"
                    @onclick="CreateReferral"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Creating...</span>
                }
                else
                {
                    <i class="bi bi-check-circle me-2"></i>
                    <span>Create Referral</span>
                }

            </button>
        } *@

        <!-- RIGHT SIDE ACTIONS -->
        <div class="wizard-footer-actions">

            <!-- SAVE DRAFT -->
            <button type="button"
                    class="btn btn-outline-primary save-draft-btn"
                    @onclick="SaveDraft"
                    disabled="@(IsSubmitting || IsSavingDraft)">

                @if (IsSavingDraft)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status">
                    </span>

                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-save me-1"></i>

                    <span>Save Draft</span>
                }

            </button>


            <!-- NEXT -->
            @if (CurrentStep < 5)
            {
                <button type="button"
                        class="btn btn-success"
                        @onclick="NextStep"
                        disabled="@(IsSubmitting || IsSavingDraft)">

                    Next

                    <i class="bi bi-arrow-right ms-1"></i>

                </button>
            }
            else
            {
                <!-- FINAL SUBMIT -->
                <button type="button"
                        class="btn btn-success"
                        @onclick="CreateReferral"
                        disabled="@(IsSubmitting || IsSavingDraft)">

                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status">
                        </span>

                        <span>Submitting...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>

                        <span>Submit Referral</span>
                    }

                </button>
            }

        </div>

    </div>

</div>

@code {

    [Parameter]
    public Guid? DraftId { get; set; }

    private List<UserDto> Coordinators = [];
    private List<UserDto> Clinicians = [];
    private List<LookupDto> Disciplines = [];

    private bool AssignmentOptionsLoaded;
    private bool AssignmentOptionsLoading;
    private string? AssignmentOptionsError;

    private int CurrentStep = 1;

    private int UploadStepKey = 0;

    private ReferralIntakeModel Model = new();

    private bool IsSubmitting;

    private bool IsSavingDraft;

    private string? ErrorMessage;

    // protected override async Task OnInitializedAsync()
    // {
    //     if (DraftId.HasValue)
    //     {
    //         await LoadDraftAsync(DraftId.Value);
    //     }
    // }

    private Guid? _loadedDraftId;
    private bool _parametersInitialized;

    protected override async Task OnParametersSetAsync()
    {
        // Prevent unnecessary reload/reset when the component
        // receives the same route parameters again.
        if (_parametersInitialized &&
            DraftId == _loadedDraftId)
        {
            return;
        }

        _parametersInitialized = true;

        // ==========================================
        // OPEN EXISTING DRAFT
        // ==========================================

        if (DraftId.HasValue)
        {
            _loadedDraftId = DraftId.Value;

            await LoadDraftAsync(DraftId.Value);

            return;
        }

        // ==========================================
        // NEW REFERRAL
        // ==========================================

        _loadedDraftId = null;

        ResetForm();
    }

    private async Task LoadDraftAsync(
    Guid draftId)
    {
        ErrorMessage = null;

        try
        {
            Model =
                await ReferralIntakeService.LoadDraftAsync(
                    draftId);

            CurrentStep = 1;

            UploadStepKey++;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Unable to load referral draft: {ex.Message}";
        }
    }

    private async Task LoadAssignmentOptionsAsync()
    {
        if (AssignmentOptionsLoaded)
            return;

        AssignmentOptionsLoading = true;
        AssignmentOptionsError = null;

        try
        {
            var usersTask =
                UserService.GetUsersAsync();

            var disciplinesTask =
                LookupService.GetDisciplinesAsync();

            var users = await usersTask;

            Disciplines =
                await disciplinesTask;

            Coordinators = users
                .Where(x =>
                    x.IsActive &&
                    (
                        x.Role.Contains(
                            "Coordinator",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        x.Role.Contains(
                            "Administrator",
                            StringComparison.OrdinalIgnoreCase)
                    ))
                .ToList();

            Clinicians = users
                .Where(x =>
                    x.IsActive &&
                    (
                        !string.IsNullOrWhiteSpace(x.Discipline)
                        ||
                        x.Role.Contains(
                            "Clinician",
                            StringComparison.OrdinalIgnoreCase)
                    ))
                .ToList();

            AssignmentOptionsLoaded = true;
        }
        catch (Exception ex)
        {
            AssignmentOptionsError =
                $"Unable to load assignment options: {ex.Message}";
        }
        finally
        {
            AssignmentOptionsLoading = false;
        }
    }

    private async Task NextStep()
    {
        ErrorMessage = null;

        if (!ValidateCurrentStep())
            return;

        if (CurrentStep >= 5)
            return;

        CurrentStep++;

        if (CurrentStep == 4)
        {
            await LoadAssignmentOptionsAsync();
        }
    }

    private void PreviousStep()
    {
        ErrorMessage = null;

        if (CurrentStep > 1)
            CurrentStep--;
    }

    private bool ValidateCurrentStep()
    {
        switch (CurrentStep)
        {
            case 1:

                // =====================================================
                // NEW REFERRAL
                // =====================================================

                if (!Model.ReferralDraftId.HasValue)
                {
                    if (Model.ReferralPdf is null)
                    {
                        ErrorMessage =
                            "Please upload the referral PDF.";

                        return false;
                    }

                    if (!Model.ReferralPdf.Name.EndsWith(
                            ".pdf",
                            StringComparison.OrdinalIgnoreCase))
                    {
                        ErrorMessage =
                            "Only PDF files are accepted.";

                        return false;
                    }

                    break;
                }

                // =====================================================
                // EXISTING DRAFT
                // =====================================================

                // The PDF itself is not stored yet.
                // Existing draft metadata is enough to show
                // the previously uploaded file in Step 1.

                if (string.IsNullOrWhiteSpace(
                        Model.ReferralPdfFileName))
                {
                    ErrorMessage =
                        "The referral PDF information is missing.";

                    return false;
                }

                if (!Model.ReferralPdfFileName.EndsWith(
                        ".pdf",
                        StringComparison.OrdinalIgnoreCase))
                {
                    ErrorMessage =
                        "The saved referral file is not a PDF.";

                    return false;
                }

                break;

            case 2:

                if (string.IsNullOrWhiteSpace(Model.MRN))
                {
                    ErrorMessage =
                        "MRN is required.";

                    return false;
                }

                if (string.IsNullOrWhiteSpace(Model.FirstName))
                {
                    ErrorMessage =
                        "First name is required.";

                    return false;
                }

                if (string.IsNullOrWhiteSpace(Model.LastName))
                {
                    ErrorMessage =
                        "Last name is required.";

                    return false;
                }

                break;

            case 3:

                if (string.IsNullOrWhiteSpace(
                        Model.ReferralNumber))
                {
                    ErrorMessage =
                        "Referral number is required.";

                    return false;
                }

                if (Model.ReferralDate.Date >
                    DateTime.Today)
                {
                    ErrorMessage =
                        "Referral date cannot be in the future.";

                    return false;
                }

                if (string.IsNullOrWhiteSpace(
                        Model.ReferralSource))
                {
                    ErrorMessage =
                        "Referral source is required.";

                    return false;
                }

                break;

            case 4:

                if (Model.CoordinatorId is null)
                {
                    ErrorMessage =
                        "Please select a care coordinator.";

                    return false;
                }

                if (Model.DisciplineId is null)
                {
                    ErrorMessage =
                        "Please select a discipline.";

                    return false;
                }

                if (Model.SocDate is null)
                {
                    ErrorMessage =
                        "Please select the SOC date.";

                    return false;
                }

                if (string.IsNullOrWhiteSpace(
                        Model.CaseStatus))
                {
                    ErrorMessage =
                        "Please select the case status.";

                    return false;
                }

                break;
        }

        return true;
    }

    private async Task CreateReferral()
    {
        if (IsSubmitting)
            return;

        IsSubmitting = true;

        try
        {
            var result =
                await ReferralIntakeService.CreateAsync(
                    Model);

            await ShowSuccessAlert(
                "The referral has been created successfully.");

            // redirect to patients list
            Navigation.NavigateTo(
                "/patients",
                replace: true);
        }
        catch (InvalidOperationException ex)
        {
            await ShowFailedAlert(
                ex.Message);
        }
        catch (HttpRequestException ex)
        {
            await ShowErrorAlert(
                "Unable to communicate with the API. " +
                "Please try again.");
        }
        catch (Exception)
        {
            await ShowErrorAlert(
                "An unexpected error occurred while " +
                "creating the referral.");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ShowSuccessAlert(
    string message)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                icon = "success",
                title = "Success",
                text = message,
                confirmButtonText = "OK"
            });
    }

    private async Task ShowFailedAlert(
        string message)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                icon = "warning",
                title = "Failed",
                text = message,
                confirmButtonText = "OK"
            });
    }

    private async Task ShowErrorAlert(
        string message)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                icon = "error",
                title = "Error",
                text = message,
                confirmButtonText = "OK"
            });
    }

    private async Task SaveDraft()
    {
        ErrorMessage = null;

        if (!ValidateCurrentStep())
            return;

        if (IsSavingDraft)
            return;

        try
        {
            IsSavingDraft = true;

            await ReferralIntakeService.SaveDraftAsync(
                Model);

            await ShowSuccessAlert(
                "The referral draft has been saved successfully.");

            // ==========================================
            // RESET FORM AFTER SUCCESSFUL SAVE
            // ==========================================

            ResetForm();

            // ==========================================
            // RETURN TO NEW REFERRAL
            // Removes /drafts/{id} from the URL
            // ==========================================

            Navigation.NavigateTo(
                "/referrals",
                replace: true);
        }
        catch (Exception ex)
        {
            ErrorMessage =
                ex.Message;
        }
        finally
        {
            IsSavingDraft = false;
        }
    }

    private void ResetForm()
    {
        Model = new ReferralIntakeModel();

        CurrentStep = 1;

        ErrorMessage = null;

        AssignmentOptionsError = null;

        UploadStepKey++;
    }
}