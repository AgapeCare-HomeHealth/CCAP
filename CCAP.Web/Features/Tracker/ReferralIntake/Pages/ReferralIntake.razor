@page "/tracker/referral"

@using CCAP.Web.Features.Tracker.ReferralIntake.Components

<PageTitle>Referral Intake</PageTitle>

<div class="referral-page">

    <!-- Header -->

    <WizardHeader />

    <!-- Progress -->

    <WizardProgress CurrentStep="@CurrentStep" />

    <!-- Content -->

    <div class="wizard-body">
        <h3>Current Step: @CurrentStep</h3>
        @switch (CurrentStep)
        {
            case 1:
                <UploadStep />
                break;

            case 2:
                <PatientInformationStep />
                break;

            case 3:
                <ReferralInformationStep />
                break;

            case 4:
                <AssignmentStep />
                break;

            case 5:
                <ReviewStep />
                break;
        }

    </div>

    <!-- Footer -->

    <div class="wizard-footer">

        <button class="btn btn-outline-secondary"
                @onclick="PreviousStep"
                disabled="@(CurrentStep == 1)">

            <i class="bi bi-arrow-left"></i>

            Previous

        </button>

        @if (CurrentStep < 5)
        {
            <button class="btn btn-success"
                    @onclick="() => CurrentStep++">
                Next

                <i class="bi bi-arrow-right"></i>

            </button>
        }
        else
        {
            <button class="btn btn-success">

                <i class="bi bi-check-circle"></i>

                Create Referral

            </button>
        }

    </div>

</div>

@code{

    private int CurrentStep = 1;

    private void NextStep()
    {
        if (CurrentStep < 5)
            CurrentStep++;
        StateHasChanged();
    }

    private void PreviousStep()
    {
        if (CurrentStep > 1)
            CurrentStep--;
        StateHasChanged();
    }

}

