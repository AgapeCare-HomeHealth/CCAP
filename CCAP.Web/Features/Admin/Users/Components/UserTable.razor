@using CCAP.Web.Features.Admin.Users.Models

<div class="user-table-card">
    <div class="table-responsive">
        <table class="table user-table">
            <thead>
                <tr>
                    <th>Employee No.</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Discipline</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Users.Any())
                {
                    @foreach (var user in Users)
                    {
                        <tr>
                            <td>@user.EmployeeNo</td>
                            <td>
                                <div class="user-info">
                                    <div>
                                        <div class="user-name">@user.FullName</div>
                                    </div>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td><span class="role-badge">@user.Role</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(user.Discipline))
                                {
                                    <span class="discipline-badge">@user.Discipline</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="status-active">● Active</span>
                                }
                                else
                                {
                                    <span class="status-inactive">● Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button type="button"
                                            title="Edit"
                                            @onclick="() => OnEdit.InvokeAsync(user)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    @if (user.IsActive)
                                    {
                                        <button type="button"
                                                title="Deactivate"
                                                @onclick="() => OnDeactivate.InvokeAsync(user)">
                                            <i class="bi bi-person-lock"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                title="Activate"
                                                @onclick="() => OnActivate.InvokeAsync(user)">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <div>Showing @Users.Count() users</div>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<UserDto> Users { get; set; } = [];
    [Parameter] public EventCallback<UserDto> OnEdit { get; set; }
    [Parameter] public EventCallback<UserDto> OnActivate { get; set; }
    [Parameter] public EventCallback<UserDto> OnDeactivate { get; set; }
}
