@using CCAP.Web.Features.Admin.Users.Models

<div class="user-table-card">

    <div class="table-responsive">

        <table class="table user-table">

            <thead>

                <tr>

                    <th>
                        Employee No.
                        <i class="bi bi-arrow-down-up sort-icon"></i>
                    </th>

                    <th>
                        Full Name
                        <i class="bi bi-arrow-down-up sort-icon"></i>
                    </th>

                    <th>Email</th>

                    <th>
                        Role
                        <i class="bi bi-arrow-down-up sort-icon"></i>
                    </th>

                    <th>
                        Discipline
                        <i class="bi bi-arrow-down-up sort-icon"></i>
                    </th>

                    <th>
                        Status
                        <i class="bi bi-arrow-down-up sort-icon"></i>
                    </th>

                    <th>
                        Last Login
                        <i class="bi bi-arrow-down-up sort-icon"></i>
                    </th>

                    <th class="text-center">

                        Actions

                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Users.Any())
                {
                    @foreach (var user in Users)
                    {
                        <tr>

                            <td>

                                @user.EmployeeNo

                            </td>

                            <td>

                                <div class="user-info">

                                    @* <div class="avatar">

                                        @user.FirstName[0]@user.LastName[0]

                                    </div> *@

                                    <div>

                                        <div class="user-name">

                                            @user.FullName

                                        </div>

                                        @* <div class="user-subtitle">

                                            @user.Role

                                        </div> *@

                                    </div>

                                </div>

                            </td>

                            <td>

                                @user.Email

                            </td>

                            <td class="text-nowrap">

                                <span class="role-badge">

                                    @user.Role

                                </span>

                            </td>

                            <td>

                                <span class="discipline-badge">

                                    @user.Discipline

                                </span>

                            </td>

                            <td class="text-nowrap">

                                @if (user.IsActive)
                                {
                                    <span class="status-active">

                                        ● Active

                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">

                                        ● Inactive

                                    </span>
                                }

                            </td>

                            <td>

                                May 24, 2025 10:30 AM

                            </td>

                            <td>

                                <div class="action-buttons">

                                    <button>

                                        <i class="bi bi-pencil-square"></i>

                                    </button>

                                    @* <button>

                                        <i class="bi bi-lock"></i>

                                    </button> *@

                                    <button>

                                        <i class="bi bi-three-dots-vertical"></i>

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            No users found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="table-footer">

        <div>

            Showing 1 to 5 of 24 users

        </div>

        <div class="pagination-area">

            <select>

                <option>5</option>
                <option>10</option>
                <option>20</option>
                <option>50</option>

            </select>

            <button>

                <i class="bi bi-chevron-left"></i>

            </button>

            <button class="active-page">

                1

            </button>

            <button>

                2

            </button>

            <button>

                3

            </button>

            <button>

                <i class="bi bi-chevron-right"></i>

            </button>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public IEnumerable<UserDto> Users { get; set; }
        = Enumerable.Empty<UserDto>();

    [Parameter]
    public bool IsLoading { get; set; }

}