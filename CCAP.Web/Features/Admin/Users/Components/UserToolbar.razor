@using CCAP.Web.Features.Admin.Users.Models

<div class="toolbar-card">

    <div class="row g-3 align-items-end">

        <!-- Search -->

        <div class="col-xl-4 col-lg-12">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input class="form-control"
                       placeholder="Search by name, email, or employee no..."
                       @bind="Filter.Search" />

            </div>

        </div>

        <!-- Role -->

        <div class="col-xl-2 col-md-4">

            <label class="toolbar-label">
                Role
            </label>

            <select class="form-select"
                    @bind="Filter.RoleId">

                <option value="">All Roles</option>
                <option value="1">Administrator</option>
                <option value="2">Scheduler</option>
                <option value="3">Care Coordinator</option>

            </select>

        </div>

        <!-- Discipline -->

        <div class="col-xl-2 col-md-4">

            <label class="toolbar-label">
                Discipline
            </label>

            <select class="form-select"
                    @bind="Filter.DisciplineId">

                <option value="">All Disciplines</option>
                <option value="1">RN</option>
                <option value="2">LVN</option>
                <option value="3">PT</option>

            </select>

        </div>

        <!-- Status -->

        <div class="col-xl-2 col-md-4">

            <label class="toolbar-label">
                Status
            </label>

            <select class="form-select"
                    @bind="Filter.IsActive">

                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>

            </select>

        </div>

        <!-- Buttons -->

        <div class="col-xl-2">

            <div class="toolbar-buttons">

                <button class="btn btn-filter"
                        @onclick="ApplyFilter">

                    <i class="bi bi-funnel"></i>

                    Filters

                </button>

                <button class="btn btn-clear"
                        @onclick="ClearFilter">

                    <i class="bi bi-arrow-clockwise"></i>

                    Clear

                </button>

            </div>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public UserFilterModel Filter { get; set; } = new();

    [Parameter]
    public EventCallback<UserFilterModel> OnFilter { get; set; }

    private async Task ApplyFilter()
    {
        await OnFilter.InvokeAsync(Filter);
    }

    private async Task ClearFilter()
    {
        Filter = new();
        await OnFilter.InvokeAsync(Filter);
    }

}