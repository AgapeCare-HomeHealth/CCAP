@using CCAP.Web.Features.Admin.Users.Models

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <!-- Search -->

            <div class="col-xl-4 col-lg-12">

                <label class="form-label fw-semibold">
                    Search
                </label>

                <input class="form-control"
                       placeholder="Search by employee, name or email..."
                       @bind="Filter.Search" />

            </div>

            <!-- Role -->

            <div class="col-xl-2 col-md-4">

                <label class="form-label fw-semibold">
                    Role
                </label>

                <select class="form-select"
                        @bind="Filter.RoleId">

                    <option value="">All Roles</option>

                    <option value="1">
                        Administrator
                    </option>

                    <option value="2">
                        Scheduler
                    </option>

                    <option value="3">
                        Care Coordinator
                    </option>

                </select>

            </div>

            <!-- Discipline -->

            <div class="col-xl-2 col-md-4">

                <label class="form-label fw-semibold">
                    Discipline
                </label>

                <select class="form-select"
                        @bind="Filter.DisciplineId">

                    <option value="">
                        All
                    </option>

                    <option value="1">
                        RN
                    </option>

                    <option value="2">
                        LVN
                    </option>

                    <option value="3">
                        PT
                    </option>

                </select>

            </div>

            <!-- Status -->

            <div class="col-xl-2 col-md-4">

                <label class="form-label fw-semibold">
                    Status
                </label>

                <select class="form-select"
                        @bind="Filter.IsActive">

                    <option value="">All</option>

                    <option value="true">
                        Active
                    </option>

                    <option value="false">
                        Inactive
                    </option>

                </select>

            </div>

            <!-- Buttons -->

            <div class="col-xl-2">

                <div class="d-grid gap-2">

                    <button class="btn btn-primary"
                            @onclick="ApplyFilter">

                        <i class="bi bi-search"></i>

                        Filter

                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="ClearFilter">

                        Clear

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public UserFilterModel Filter { get; set; } = new();

    [Parameter]
    public EventCallback<UserFilterModel> OnFilter { get; set; }

    private async Task ApplyFilter()
    {
        await OnFilter.InvokeAsync(Filter);
    }

    private async Task ClearFilter()
    {
        Filter = new();

        await OnFilter.InvokeAsync(Filter);
    }

}