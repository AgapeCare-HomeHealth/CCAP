@using CCAP.Web.Components.Shared
@using CCAP.Web.Features.Admin.Roles.Models

<div class="row g-4 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="Total Roles"
                       Value="@Statistics.TotalRoles.ToString()"
                       Icon="bi bi-person-badge-fill"
                       Color="#18a689" />

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="Permissions"
                       Value="@Statistics.TotalPermissions.ToString()"
                       Icon="bi bi-shield-lock-fill"
                       Color="#3b82f6" />

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="Assigned Users"
                       Value="@Statistics.AssignedUsers.ToString()"
                       Icon="bi bi-people-fill"
                       Color="#f59e0b" />

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <StatisticCard Title="Custom Roles"
                       Value="@Statistics.CustomRoles.ToString()"
                       Icon="bi bi-diagram-3-fill"
                       Color="#7c3aed" />

    </div>

</div>

@code {

    [Parameter]
    public RoleStatisticsModel Statistics { get; set; } = new();

}