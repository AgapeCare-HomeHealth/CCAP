@page "/admin/announcements"
@attribute [CcapAuthorize(Roles = "Administrator")]
@using CCAP.Web.Features.Authentication.Services
@using CCAP.Web.Features.Dashboard.Models
@inject CcapApiClient Api
<PageTitle>Announcement Management</PageTitle>
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Announcement Management</h2><p class="text-muted mb-0">Publish information for users on their dashboard.</p></div></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="alert @(IsError?"alert-danger":"alert-success")">@Message</div>}
<div class="card mb-4"><div class="card-header fw-semibold">Create announcement</div><div class="card-body"><EditForm Model="Model" OnValidSubmit="CreateAsync"><DataAnnotationsValidator/><div class="mb-3"><label class="form-label">Title</label><InputText class="form-control" @bind-Value="Model.Title"/><ValidationMessage For="()=>Model.Title"/></div><div class="mb-3"><label class="form-label">Message</label><InputTextArea class="form-control" rows="4" @bind-Value="Model.Message"/><ValidationMessage For="()=>Model.Message"/></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Publish date (optional)</label><InputDate class="form-control" @bind-Value="Model.PublishedAt"/></div><div class="col-md-6 mb-3"><label class="form-label">Expiration date (optional)</label><InputDate class="form-control" @bind-Value="Model.ExpiresAt"/></div></div><button class="btn btn-primary" type="submit" disabled="@Saving">@(Saving?"Publishing...":"Publish announcement")</button></EditForm></div></div>
<div class="alert alert-info">Announcements are displayed to users while active and within their publication/expiration window. Existing API currently supports creation; editing and deactivation are not included in this build.</div></div>
@code { private AnnouncementForm Model=new(); private bool Saving,IsError; private string? Message; private async Task CreateAsync(){Saving=true;Message=null;IsError=false;try{var response=await Api.PostAsJsonAsync("api/announcements",new{Model.Title,Model.Message,PublishedAt=Model.PublishedAt?.ToDateTime(TimeOnly.MinValue),ExpiresAt=Model.ExpiresAt?.ToDateTime(TimeOnly.MinValue)});await Api.EnsureSuccessAsync(response);Model=new();Message="Announcement published successfully.";}catch(Exception ex){IsError=true;Message=$"Unable to publish announcement: {ex.Message}";}finally{Saving=false;}} private sealed class AnnouncementForm { [System.ComponentModel.DataAnnotations.Required] public string Title{get;set;}="";[System.ComponentModel.DataAnnotations.Required] public string Message{get;set;}="";public DateOnly? PublishedAt{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly? ExpiresAt{get;set;} } }
