@code {

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public bool IsMobileMenuOpen { get; set; }

    private bool ShowLabels => !IsCollapsed || IsMobileMenuOpen;

}

<div class="sidebar @(IsCollapsed ? "collapsed" : "") @(IsMobileMenuOpen ? "mobile-open" : "")">

    <!-- Logo Section -->
    <div class="sidebar-header">
        <div class="sidebar-header-content">

            @if (!ShowLabels)
            {
                <img src="images/logo11.png"
                     alt="AgapeCare"
                     class="sidebar-logo sidebar-logo-collapsed" />
            }
            else
            {
                <img src="images/logo.png"
                     alt="AgapeCare Home Health Inc."
                     class="sidebar-logo sidebar-logo-expanded" />
            }

        </div>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">

        <div class="menu-group">

            <NavLink href="/Dashboard" Match="NavLinkMatch.All" class="nav-item">
                <i class="bi bi-grid"></i>

                @if (ShowLabels)
                {
                    <span>Dashboard</span>
                }
            </NavLink>

            <NavLink href="/patients" Match="NavLinkMatch.All" class="nav-item">
                <i class="bi bi-people"></i>
                @if (ShowLabels)
                {
                    <span>My Patients</span>
                }
            </NavLink>

            <NavLink href="/patients/archive" Match="NavLinkMatch.All" class="nav-item">
                <i class="bi bi-archive"></i>
                @if (ShowLabels)
                {
                    <span>Archived Patients</span>
                }
            </NavLink>

            <AuthorizeView Roles="Administrator,Care Coordinator">
                <Authorized>
                    <NavLink href="/referrals/list" Match="NavLinkMatch.All" class="nav-item">
                        <i class="bi bi-list-ul"></i>
                        @if (ShowLabels)
                        {
                            <span>Referral Tracker</span>
                        }
                    </NavLink>
                </Authorized>
            </AuthorizeView>

        </div>

        <!-- ======================= -->
        <!-- Referrals -->
        <!-- ======================= -->

        <details class="menu-dropdown" name="ccap-sidebar-menu">

            <summary>

                <div>

                    <i class="bi bi-person-plus"></i>

                    @if (ShowLabels)
                    {
                        <span>Referrals</span>
                    }

                </div>

                @if (ShowLabels)
                {
                    <i class="bi bi-chevron-down arrow"></i>
                }

            </summary>

            @if (ShowLabels)
            {
                @* <NavLink href="/referrals/list"
                         Match="NavLinkMatch.All"
                         class="submenu-item">
                    Referral List
                </NavLink> *@

                <NavLink href="/referrals"
                         Match="NavLinkMatch.All"
                         class="submenu-item">
                    New Referral
                </NavLink>

                <NavLink href="/referrals/drafts"
                         Match="NavLinkMatch.All"
                         class="submenu-item">
                    Draft Referrals
                </NavLink>
            }

        </details>

        <!-- ======================= -->
        <!-- Workflow Tracker -->
        <!-- ======================= -->

        @* <details class="menu-dropdown" name="ccap-sidebar-menu">

            <summary>

                <div>
                    <i class="bi bi-clipboard-check"></i>

                    @if (ShowLabels)
                    {
                        <span>Workflow Tracker</span>
                    }
                </div>

                @if (ShowLabels)
                {
                    <i class="bi bi-chevron-down arrow"></i>
                }

            </summary>

            @if (ShowLabels)
            {
                <NavLink href="/tracker/referral" class="submenu-item">
                    Referral Intake
                </NavLink>


                @* <NavLink href="/compliance/orders" class="submenu-item">
                    Physician Orders
                </NavLink>

                <NavLink href="/compliance/audit" class="submenu-item">
                    QA Audit
                </NavLink> 
            }

        </details>
        *@
        <!-- ======================= -->
        <!-- Documents -->
        <!-- ======================= -->
        <!-- ======================= -->
        <!-- Documents -->
        <!-- ======================= -->

        @* <details class="menu-dropdown" name="ccap-sidebar-menu">

            <summary>

                <div>

                    <i class="bi bi-folder2-open"></i>

                    @if (ShowLabels)
                    {
                        <span>Documents</span>
                    }

                </div>

                @if (ShowLabels)
                {
                    <i class="bi bi-chevron-down arrow"></i>
                }

            </summary>

            @if (ShowLabels)
            {
                <NavLink href="/documents/upload" class="submenu-item">
                    Upload
                </NavLink>

                <NavLink href="/documents/archive" class="submenu-item">
                    Archive
                </NavLink>

                <NavLink href="/documents/templates" class="submenu-item">
                    Templates
                </NavLink>
            }

        </details> *@
        <!-- ======================= -->
        <!-- Scheduling -->
        <!-- ======================= -->

        <details class="menu-dropdown" name="ccap-sidebar-menu">

            <summary>
                <div>
                    <i class="bi bi-calendar3"></i>

                    @if (ShowLabels)
                    {
                        <span>Scheduling</span>
                    }
                </div>

                @if (ShowLabels)
                {
                    <i class="bi bi-chevron-down arrow"></i>
                }
            </summary>

            @if (ShowLabels)
            {
                <NavLink href="/scheduling/calendar"
                         Match="NavLinkMatch.All"
                         class="submenu-item">
                    Calendar
                </NavLink>
            }

        </details>


        <!-- ======================= -->
        <!-- Admin -->
        <!-- ======================= -->
        <!-- ======================= -->
        <!-- Admin -->
        <!-- ======================= -->

        <AuthorizeView Roles="Administrator,Admin">
            <Authorized>
                <details class="menu-dropdown" name="ccap-sidebar-menu">

                    <summary>

                        <div>

                            <i class="bi bi-gear"></i>

                            @if (ShowLabels)
                            {
                                <span>Admin</span>
                            }

                        </div>

                        @if (ShowLabels)
                        {
                            <i class="bi bi-chevron-down arrow"></i>
                        }

                    </summary>

            @if (ShowLabels)
            {
                <NavLink href="/admin/users" class="submenu-item">
                    Users
                </NavLink>

                <NavLink href="/admin/patient-import" class="submenu-item">
                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>Patient Import
                </NavLink>

                <NavLink href="/admin/referral-import" class="submenu-item">
                    <i class="bi bi-file-earmark-arrow-up me-2"></i>Referral Tracker Import
                </NavLink>

                <NavLink href="/admin/calendar-import" class="submenu-item">
                    <i class="bi bi-calendar2-plus me-2"></i>Calendar Import
                </NavLink>

                <NavLink href="/admin/lookup-options" class="submenu-item">
                    <i class="bi bi-list-check me-2"></i>Lookup Options
                </NavLink>

                <NavLink href="/admin/service-types" class="submenu-item">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Service / Order Types
                </NavLink>

                <NavLink href="/admin/roles" class="submenu-item">
                    Roles
                </NavLink>

                <NavLink href="/admin/announcements" class="submenu-item">
                    Announcements
                </NavLink>

                @* <NavLink href="/admin/settings" class="submenu-item">
                    Settings
                </NavLink> *@

                    }

                </details>
            </Authorized>
        </AuthorizeView>

    </nav>

    <!-- Footer -->
    @if (ShowLabels)
    {
        <div class="sidebar-footer">
            Version 1.0
        </div>
    }

</div>
