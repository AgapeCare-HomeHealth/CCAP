@code {

    [Parameter]
    public bool IsCollapsed { get; set; }

}

<div class="sidebar @(IsCollapsed ? "collapsed" : "")">

    <!-- Logo Section -->
    <div class="sidebar-header">
        <div class="sidebar-header-content">

            @if (IsCollapsed)
            {
                <img src="images/logo11.png"
                     alt="AgapeCare"
                     class="sidebar-logo sidebar-logo-collapsed" />
            }
            else
            {
                <img src="images/logo.png"
                     alt="AgapeCare Home Health Inc."
                     class="sidebar-logo sidebar-logo-expanded" />
            }

        </div>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">

        <div class="menu-group">

            <NavLink href="/Dashboard" Match="NavLinkMatch.All" class="nav-item">
                <i class="bi bi-grid"></i>

                @if (!IsCollapsed)
                {
                    <span>Dashboard</span>
                }
            </NavLink>

            <NavLink href="/patients" class="nav-item">
                <i class="bi bi-people"></i>
                @if (!IsCollapsed)
                {
                    <span>My Patients</span>
                }
            </NavLink>

            <NavLink href="/patients/archive" class="nav-item">
                <i class="bi bi-archive"></i>
                @if (!IsCollapsed)
                {
                    <span>Archived Patients</span>
                }
            </NavLink>

            @* <NavLink href="/referrals" class="nav-item">
                <i class="bi bi-person-plus"></i>
                @if (!IsCollapsed)
                {
                    <span>Referrals</span>
                }
            </NavLink> *@

        </div>

        <!-- ======================= -->
        <!-- Referrals -->
        <!-- ======================= -->

        <details class="menu-dropdown">

            <summary>

                <div>

                    <i class="bi bi-person-plus"></i>

                    @if (!IsCollapsed)
                    {
                        <span>Referrals</span>
                    }

                </div>

                @if (!IsCollapsed)
                {
                    <i class="bi bi-chevron-down arrow"></i>
                }

            </summary>

            @if (!IsCollapsed)
            {
                <NavLink href="/referrals"
                         Match="NavLinkMatch.All"
                         class="submenu-item">
                    New Referral
                </NavLink>

                <NavLink href="/referrals/drafts"
                         Match="NavLinkMatch.All"
                         class="submenu-item">
                    Draft Referrals
                </NavLink>
            }

        </details>

