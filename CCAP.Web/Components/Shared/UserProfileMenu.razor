@using CCAP.Web.Features.Authentication.Services
@using CCAP.Web.Features.Authentication.State
@using Microsoft.AspNetCore.Components.Authorization
@inject TokenStore TokenStore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="profile-menu">
    <div class="profile-menu-divider"></div>

    <button class="profile-menu-item">
        <i class="bi bi-person"></i>
        <span>My Profile</span>
    </button>

    <button class="profile-menu-item">
        <i class="bi bi-question-circle"></i>
        <span>Help</span>
    </button>

    <div class="profile-menu-divider"></div>

    <button class="profile-menu-item logout" @onclick="LogoutAsync">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    private async Task LogoutAsync()
    {
        await TokenStore.DeleteAsync();

        if (AuthenticationStateProvider is CcapAuthenticationStateProvider provider)
            await provider.NotifyLogoutAsync();

        Navigation.NavigateTo("/login");
    }
}
