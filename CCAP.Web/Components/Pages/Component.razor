@page "/counter"

<h1>Counter</h1>

<p>@count</p>
<input @bind="text" />

<p>@text</p>
<button class="btn btn-primary"
        @onclick="Increment">
    Click
</button>

@code {

    private string text = "testing";
    private int count;

    private void Increment()
    {

        text = "clicked";
        Console.WriteLine("test");
        count++;
        Console.WriteLine(count);

    }


}