# Provider-neutral Linux OCR API image: build from solution root.
# Production secrets MUST come from the hosting environment/secret manager.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish CCAP.API/CCAP.API.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
# Do not bake uploaded/local application credentials into a production image.
RUN rm -f /app/appsettings.json /app/appsettings.Development.json /app/appsettings.Production.json
ENV ASPNETCORE_HTTP_PORTS=8080 \
    ReferralDocumentOcr__PdfToPpmPath=/usr/bin/pdftoppm \
    ReferralDocumentOcr__TessdataPath=/app/tessdata \
    ReferralDocumentOcr__MaxPages=25 \
    ReferralDocumentOcr__Dpi=185
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "CCAP.API.dll"]
