{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CCAP;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_FROM_SERVER_SECRET_STORAGE",
    "Issuer": "CCAP.API",
    "Audience": "CCAP.Web",
    "ExpireMinutes": 60
  },
  "Database": {
    "ApplyMigrations": false
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/Files"
  }
}
