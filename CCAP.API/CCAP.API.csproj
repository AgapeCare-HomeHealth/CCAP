<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CCAP.Application\CCAP.Application.csproj" />
    <ProjectReference Include="..\CCAP.Infrastructure\CCAP.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- RapidOcrNet ships its default PP-OCRv5 Latin models inside the NuGet package.
       Copy them explicitly to each project's output because content files from a
       referenced class library are not guaranteed to flow to the API output. -->
  <Target Name="CopyRapidOcrModelsToOutput" AfterTargets="Build" BeforeTargets="Publish">
    <ItemGroup>
      <RapidOcrModelFiles Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\ch_PP-OCRv5_mobile_det.onnx" />
      <RapidOcrModelFiles Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" />
      <RapidOcrModelFiles Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\latin_PP-OCRv5_rec_mobile_infer.onnx" />
      <RapidOcrModelFiles Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\ppocrv5_latin_dict.txt" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)models\v5" Condition="'@(RapidOcrModelFiles)' != ''" />
    <Copy SourceFiles="@(RapidOcrModelFiles)"
          DestinationFiles="@(RapidOcrModelFiles->'$(OutDir)models\v5\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(RapidOcrModelFiles)' != ''" />
  </Target>


  <ItemGroup>
    <!-- Published beside the API, where AppContext.BaseDirectory resolves. -->
    <Content Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\ch_PP-OCRv5_mobile_det.onnx" Link="models\v5\ch_PP-OCRv5_mobile_det.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" Link="models\v5\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\latin_PP-OCRv5_rec_mobile_infer.onnx" Link="models\v5\latin_PP-OCRv5_rec_mobile_infer.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\**\ppocrv5_latin_dict.txt" Link="models\v5\ppocrv5_latin_dict.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
